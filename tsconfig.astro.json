{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["astro/client", "node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/astro/**/*.astro",
    "src/astro/**/*.d.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["dist", ".test-site", "node_modules"]
}
