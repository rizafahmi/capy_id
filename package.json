{
  "name": "capyboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check scripts src tests playwright.config.ts",
    "format": "biome format --write scripts src tests playwright.config.ts",
    "test": "node --test tests/*.test.ts",
    "validate": "node scripts/cli.ts validate",
    "import": "node scripts/cli.ts import",
    "build": "node scripts/cli.ts build",
    "fixtures": "node scripts/fixtures.ts",
    "dev": "node scripts/dev.ts",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture.ts",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  }
}
