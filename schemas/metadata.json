{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "attempt_number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "identifier_kind": {
          "type": "string",
          "enum": [
            "snapshot",
            "alias",
            "display-only",
            "unknown"
          ]
        }
      },
      "required": [
        "display_name",
        "identifier",
        "identifier_kind"
      ],
      "additionalProperties": false
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "one-shot",
            "revised",
            "tool-assisted",
            "unknown"
          ]
        },
        "interface": {
          "type": "string",
          "enum": [
            "api",
            "web-chat",
            "coding-agent",
            "other",
            "unknown"
          ]
        },
        "tools_used": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "settings": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": [
                "number",
                "null"
              ]
            },
            "top_p": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "seed": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "temperature",
            "top_p",
            "max_output_tokens",
            "seed"
          ],
          "additionalProperties": false
        },
        "system_instruction_known": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "interface",
        "tools_used",
        "settings",
        "system_instruction_known"
      ],
      "additionalProperties": false
    },
    "supersedes_run_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "correction_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "challenge_id",
    "provider",
    "model",
    "generated_at",
    "generation"
  ],
  "additionalProperties": false
}
