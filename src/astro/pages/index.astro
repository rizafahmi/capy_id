---
import type { AstroPages } from "../../../scripts/astro-pages.ts";
import RunCard from "../components/RunCard.astro";
import Shell from "../layouts/Shell.astro";

declare const __CAPYBOARD_ASTRO_PAGES__: AstroPages;
const { entries, fixtures } = __CAPYBOARD_ASTRO_PAGES__.gallery;
const providers = [
  ...new Set(entries.map((entry) => entry.run.provider)),
].sort();
const harnesses = [
  ...new Set(
    entries.map((entry) => entry.run.generation.harness?.name ?? "unknown"),
  ),
].sort((a, b) => a.localeCompare(b, "en"));
const models = [
  ...new Map(
    entries.map(({ run }) => [run.model.identifier, run.model.display_name]),
  ).entries(),
].sort(
  (a, b) => a[1].localeCompare(b[1], "en") || a[0].localeCompare(b[0], "en"),
);
const efforts = [
  "off",
  "minimal",
  "low",
  "medium",
  "high",
  "xhigh",
  "max",
].filter((effort) =>
  entries.some(({ run }) => run.generation.harness?.effort === effort),
);
const unknownEffort = entries.some(
  ({ run }) => run.generation.harness?.effort == null,
);
const modes = ["one-shot", "revised", "tool-assisted", "unknown"].filter(
  (mode) => entries.some(({ run }) => run.generation.mode === mode),
);
const comparable = entries.length > 1;
---

<Shell title="Gallery" fixtures={fixtures} section="gallery">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">One fixed creative coding challenge</p>
      <h1>
        One prompt.
        <br />
        <span>Many capybaras.</span>
      </h1>
      <p class="hero-description">
        Each model gets the same prompt: animate a capybara on a hoverboard.
        Browse the outputs, then inspect the evidence.
      </p>
      <div class="hero-actions">
        <a class="button hero-cta" href="#attempts">
          Browse attempts <span aria-hidden="true">↓</span>
        </a>
        <a class="text-link" href="/challenge/">
          Read the exact prompt
        </a>
      </div>
    </div>
    <figure class="hero-visual">
      <div class="hero-photo">
        <img
          src="/assets/capybara.webp"
          srcset="/assets/capybara-small.webp 640w, /assets/capybara.webp 960w"
          sizes="240px"
          width="960"
          height="640"
          decoding="async"
          fetchpriority="high"
          alt="A capybara resting beside a river, the real-life subject of our coding challenge"
        />
      </div>
      <figcaption>
        Photo by{" "}
        <a href="https://commons.wikimedia.org/wiki/File:Capybaracropped.jpg">
          Giles Laurent
        </a>
        ,{" "}
        <a href="https://creativecommons.org/licenses/by-sa/4.0">
          CC BY-SA 4.0
        </a>
      </figcaption>
    </figure>
  </section>
  <section id="attempts" aria-labelledby="attempts-title" tabindex="-1">
    <div class="collection-heading">
      <h2 id="attempts-title">
        Collected attempts <span class="count">{entries.length}</span>
      </h2>
      <p id="about" class="interpretation">
        One task, not an overall model ranking. Original evidence is preserved.
      </p>
    </div>
    {comparable && (
      <>
        <details class="gallery-controls" hidden>
          <summary>Filter and sort</summary>
          <template data-gallery-filters>
            <form
              class="filters"
              toolname="filter_gallery"
              tooldescription="Filter and sort model attempts by provider, exact model identifier, coding harness, recorded effort, and generation mode. Returns matching attempt names, providers, and inspection links. Omitted parameters keep their current values."
              toolautosubmit
            >
              <label>
                Provider
                <select
                  name="provider"
                  toolparamdescription="Limit attempts to this provider. Use an empty string for all providers."
                >
                  <option value="">All providers</option>
                  {providers.map((provider) => (
                    <option>{provider}</option>
                  ))}
                </select>
              </label>
              <label>
                Model
                <select
                  name="model"
                  toolparamdescription="Select an exact model identifier, or leave empty to include all models."
                >
                  <option value="">All models</option>
                  {models.map(([identifier, name]) => (
                    <option value={identifier}>{name}</option>
                  ))}
                </select>
              </label>
              <label>
                Coding harness
                <select
                  name="harness"
                  toolparamdescription="Limit attempts to this coding harness, or leave empty to include all harnesses."
                >
                  <option value="">All harnesses</option>
                  {harnesses.map((harness) => (
                    <option value={harness}>
                      {harness === "unknown" ? "Unknown" : harness}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Effort
                <select
                  name="effort"
                  toolparamdescription="Filter by recorded harness effort. Levels are not equivalent across providers. Unknown means effort was not recorded."
                >
                  <option value="">All effort levels</option>
                  {efforts.map((effort) => (
                    <option value={effort}>
                      {effort.charAt(0).toUpperCase() + effort.slice(1)}
                    </option>
                  ))}
                  {unknownEffort && <option value="unknown">Unknown</option>}
                </select>
              </label>
              <label>
                Generation mode
                <select
                  name="mode"
                  toolparamdescription="Filter by the recorded generation mode."
                >
                  <option value="">All modes</option>
                  {modes.map((mode) => (
                    <option value={mode}>
                      {mode.charAt(0).toUpperCase() + mode.slice(1)}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Sort by
                <select
                  name="sort"
                  toolparamdescription="Order attempts by newest generation date or model name."
                >
                  <option value="newest">Newest first</option>
                  <option value="name">Model name</option>
                </select>
              </label>
              <button type="reset" class="secondary" hidden>
                Reset
              </button>
            </form>
          </template>
        </details>
        <div class="filter-feedback" hidden>
          <p class="active-filters"></p>
          <button type="button" class="text-link" data-clear-filters>
            Clear filters
          </button>
        </div>
        <p id="results-status" class="results-status" role="status" hidden>
          {entries.length} attempts
        </p>
      </>
    )}
    <div class={`gallery-grid${entries.length === 1 ? " single-attempt" : ""}`}>
      {entries.map((entry, index) => (
        <RunCard
          entry={entry}
          comparable={comparable}
          loading={index < 2 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : undefined}
        />
      ))}
    </div>
    <div id="empty-state" class="empty-state" hidden={entries.length > 0}>
      <h2>
        {entries.length
          ? "No matching attempts"
          : "No experiments published yet"}
      </h2>
      <p>
        {entries.length
          ? "Try another filter or reset your filters."
          : "Genuine experiments will appear here after curator review."}
      </p>
      <button type="button" data-reset hidden>
        Reset filters
      </button>
    </div>
  </section>
  {comparable && (
    <aside class="comparison-tray" hidden aria-label="Selected comparison">
      <p id="selection-count" role="status">
        0 of 2 selected
      </p>
      <ul id="selected-runs"></ul>
      <a id="compare-link" class="button" aria-disabled="true">
        Compare two
      </a>
    </aside>
  )}
  <p class="hero-inspiration">
    Inspired by{" "}
    <a href="https://simonwillison.net/tags/pelican-riding-a-bicycle/">
      Simon Willison's pelican-riding-a-bicycle experiments
    </a>
    .
  </p>
</Shell>
