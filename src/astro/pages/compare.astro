---
import type { AstroPages } from "../../../scripts/astro-pages.ts";
import Shell from "../layouts/Shell.astro";

declare const __CAPYBOARD_ASTRO_PAGES__: AstroPages;
const { runs, fixtures } = __CAPYBOARD_ASTRO_PAGES__.comparison;
const dates = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});
---

<Shell title="Compare" fixtures={fixtures} section="compare">
  <a class="back-link" href="/">
    ← All attempts
  </a>
  <header class="compare-heading">
    <h1>Compare outputs</h1>
    <p class="hero-description">
      Inspect the differences. No scores, no automatic winners.
    </p>
  </header>
  <form id="compare-form" action="/compare/" method="get" autocomplete="off">
    <div class="compare-selectors">
      {["left", "right"].map((side) => (
        <label>
          {side === "left" ? "Left run" : "Right run"}
          <select name={side} required>
            <option value="">Select a run</option>
            {runs.map((run) => (
              <option value={run.id}>
                {`${run.model.display_name} · ${run.generation.harness?.effort ?? "unknown"} effort · Attempt ${run.attempt_number} · ${run.generated_at ? `${dates.format(new Date(run.generated_at))} UTC` : run.id}`}
              </option>
            ))}
          </select>
        </label>
      ))}
      <button type="submit" class="secondary">
        Compare
      </button>
    </div>
  </form>
  <noscript>
    <p>
      Comparison controls and previews require JavaScript. Open the individual
      run pages to inspect their evidence.
    </p>
  </noscript>
  <div id="condition-notices" class="compare-notices"></div>
  <div class="compare-toolbar">
    <p id="compare-status" role="status">
      Choose two distinct runs.
    </p>
    <button type="button" id="run-both" hidden>
      Run both
    </button>
  </div>
  <div id="compare-results" hidden>
    <div id="compare-panels" class="compare-panels"></div>
    <section
      class="compare-measurements"
      aria-labelledby="compare-metrics-title"
    >
      <h2 id="compare-metrics-title">Recorded metrics</h2>
      <p class="muted">
        Highlighted rows have different recorded values, not better or worse
        scores. Unknown values were not recorded.
      </p>
      <div id="compare-metrics"></div>
      <p class="muted">
        Model time excludes tool execution and agent startup. Elapsed time
        covers the recorded attempt. Cached tokens are cache reads.
      </p>
    </section>
    <details id="compare-provenance" class="compare-provenance">
      <summary>Generation details and provenance</summary>
      <div id="compare-generation"></div>
    </details>
  </div>
</Shell>
