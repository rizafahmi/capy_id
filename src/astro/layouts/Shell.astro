---
import type { AstroPages } from "../../../scripts/astro-pages.ts";

declare const __CAPYBOARD_ASTRO_PAGES__: AstroPages;

interface Props {
  title: string;
  description?: string | undefined;
  canonicalPath?: string | undefined;
  noindex?: boolean | undefined;
  ogType?: "website" | "article" | undefined;
  ogImage?:
    | {
        path: string;
        width: number;
        height: number;
        alt: string;
      }
    | undefined;
  publishedAt?: string | null | undefined;
  alternateLinks?:
    | Array<{
        href: string;
        type: string;
        title: string;
      }>
    | undefined;
  fixtures: boolean;
  section: "gallery" | "challenge" | "run" | "compare" | "not-found";
  preloadImage?: string | undefined;
}
const {
  title,
  description = "A curated, inspectable gallery of AI model responses to one HTML, CSS, and JavaScript coding challenge: animate a capybara on a hoverboard. Not a model leaderboard.",
  canonicalPath,
  noindex,
  ogType = "website",
  ogImage,
  publishedAt,
  alternateLinks = [],
  fixtures,
  section,
  preloadImage,
} = Astro.props;
const cleanMetaText = (value: string) => value.replaceAll(/[<>]/g, "");
const metaTitle = cleanMetaText(`${title} · Capyboard`);
const metaDescription = cleanMetaText(description);
const origin = __CAPYBOARD_ASTRO_PAGES__.origin;
const resolvedCanonicalPath =
  canonicalPath ??
  (section === "gallery"
    ? "/"
    : section === "challenge"
      ? "/challenge/"
      : section === "compare"
        ? "/compare/"
        : undefined);
const canonicalUrl = resolvedCanonicalPath
  ? `${origin}${resolvedCanonicalPath}`
  : undefined;
const shouldNoindex = Boolean(noindex || fixtures || section === "not-found");
const resolvedOgImage = ogImage ?? {
  path: "/assets/og-card.png",
  width: 1200,
  height: 630,
  alt: "Capyboard showcase of AI-generated capybara on a hoverboard animations in HTML, CSS, and JavaScript",
};
const ogImageUrl = `${origin}${resolvedOgImage.path}`;
const metaImageAlt = cleanMetaText(resolvedOgImage.alt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={metaDescription} />
    {shouldNoindex && <meta name="robots" content="noindex" />}
    <title>{title} · Capyboard</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {section !== "not-found" && (
      <>
        <meta property="og:site_name" content="Capyboard" />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={metaTitle} />
        <meta property="og:description" content={metaDescription} />
        {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
        <meta property="og:image" content={ogImageUrl} />
        <meta
          property="og:image:width"
          content={String(resolvedOgImage.width)}
        />
        <meta
          property="og:image:height"
          content={String(resolvedOgImage.height)}
        />
        <meta property="og:image:alt" content={metaImageAlt} />
        {publishedAt && (
          <meta property="article:published_time" content={publishedAt} />
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={metaTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={metaImageAlt} />
        <link
          rel="alternate"
          type="text/plain"
          href="/llms.txt"
          title="LLM summary and evidence index"
        />
        <link
          rel="alternate"
          type="application/json"
          href="/assets/runs.json"
          title="Published runs catalogue (JSON)"
        />
        {alternateLinks.map((link) => (
          <link
            rel="alternate"
            type={link.type}
            href={link.href}
            title={cleanMetaText(link.title)}
          />
        ))}
      </>
    )}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/assets/favicon.png"
      type="image/png"
      sizes="64x64"
    />
    <link
      rel="preload"
      href="/assets/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {section === "compare" && (
      <link
        rel="preload"
        href="/assets/runs.json"
        as="fetch"
        type="application/json"
        crossorigin
      />
    )}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <link rel="stylesheet" href="/assets/site.css" />
    <script is:inline type="module" src="/assets/app.js"></script>
  </head>
  <body data-page={section}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          cb
        </span>
        capyboard<span class="brand-tag">/ experiments</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={section === "gallery" ? "page" : undefined}>
          Gallery
        </a>
        <a
          href="/challenge/"
          aria-current={section === "challenge" ? "page" : undefined}
        >
          The challenge <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    {fixtures && (
      <div class="development-banner" role="note">
        Development fixtures. These are test examples, not genuine model
        experiments.
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Showcase first. Inspect everything.</span>
      <a href="/challenge/#limits">Interpretation and limitations</a>
    </footer>
    <div id="global-status" class="sr-only" role="status"></div>
  </body>
</html>
