---
import type { Entry } from "../../../scripts/schema.ts";

interface Props {
  entry: Entry;
  loading?: "lazy" | "eager" | undefined;
  fetchpriority?: "high" | "auto" | "low" | undefined;
}
const { entry, loading = "lazy", fetchpriority } = Astro.props;
---

{entry.curation.thumbnail ? (
  <img
    src={`/${entry.curation.thumbnail.path}`}
    width="640"
    height="480"
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    alt={`Screenshot of ${entry.run.model.display_name} output`}
  />
) : (
  <div class="placeholder" role="img" aria-label="Screenshot not captured">
    <span class="placeholder-mark" aria-hidden="true">
      ?
    </span>
    <span aria-hidden="true">Screenshot not captured</span>
  </div>
)}
