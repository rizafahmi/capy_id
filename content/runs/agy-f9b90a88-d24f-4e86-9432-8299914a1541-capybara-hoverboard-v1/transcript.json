      "role": "assistant",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cyber-Chill Capybara Hoverboard</title>\n<style>\n  :root {\n    --ui-bg: rgba(15, 18, 34, 0.72);\n    --ui-border: rgba(0, 243, 255, 0.35);\n    --neon-cyan: #00f3ff;\n    --neon-pink: #ff2a85;\n    --neon-gold: #ffbe0b;\n    --text-light: #f0f6ff;\n  }\n\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #0d0826;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    color: var(--text-light);\n  }\n\n  #scene-container {\n    position: relative;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    cursor: pointer;\n  }\n\n  canvas#bg-canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 1;\n    display: block;\n  }\n\n  #character-stage {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 2;\n    pointer-events: none;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  #capy-rig {\n    width: min(560px, 88vw);\n    height: min(450px, 72vh);\n    transform-origin: 50% 62%;\n    will-change: transform;\n    filter: drop-shadow(0 18px 28px rgba(7, 4, 22, 0.55));\n  }\n\n  canvas#fg-canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 3;\n    pointer-events: none;\n    display: block;\n  }\n\n  /* HUD Controls */\n  .hud {\n    position: absolute;\n    bottom: 24px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 10;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 10px 16px;\n    background: var(--ui-bg);\n    border: 1px solid var(--ui-border);\n    border-radius: 999px;\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 20px rgba(0, 243, 255, 0.15);\n  }\n\n  .hud-btn {\n    appearance: none;\n    background: rgba(255, 255, 255, 0.07);\n    color: var(--text-light);\n    border: 1px solid rgba(255, 255, 255, 0.18);\n    padding: 8px 15px;\n    border-radius: 999px;\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 0.03em;\n    cursor: pointer;\n    transition: all 0.18s ease;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .hud-btn:hover {\n    background: rgba(0, 243, 255, 0.18);\n    border-color: var(--neon-cyan);\n    box-shadow: 0 0 12px rgba(0, 243, 255, 0.35);\n    transform: translateY(-1px);\n  }\n\n  .hud-btn:active {\n    transform: translateY(1px);\n  }\n\n  .hud-btn.active {\n    background: linear-gradient(135deg, rgba(255, 42, 133, 0.8), rgba(0, 243, 255, 0.8));\n    border-color: #ffffff;\n    color: #fff;\n    box-shadow: 0 0 16px rgba(255, 42, 133, 0.5);\n  }\n\n  .key-hint {\n    font-size: 10px;\n    padding: 2px 5px;\n    border-radius: 4px;\n    background: rgba(0, 0, 0, 0.35);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    color: rgba(255, 255, 255, 0.8);\n  }\n\n  .status-banner {\n    position: absolute;\n    top: 20px;\n    left: 24px;\n    z-index: 10;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 8px 16px;\n    background: var(--ui-bg);\n    border: 1px solid var(--ui-border);\n    border-radius: 999px;\n    backdrop-filter: blur(8px);\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 0.04em;\n    pointer-events: none;\n  }\n\n  .pulse-dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: var(--neon-cyan);\n    box-shadow: 0 0 10px var(--neon-cyan);\n    animation: pulseGlow 1.6s infinite ease-in-out;\n  }\n\n  .speedometer {\n    position: absolute;\n    top: 20px;\n    right: 24px;\n    z-index: 10;\n    padding: 8px 16px;\n    background: var(--ui-bg);\n    border: 1px solid var(--ui-border);\n    border-radius: 999px;\n    backdrop-filter: blur(8px);\n    font-size: 13px;\n    font-variant-numeric: tabular-nums;\n    font-weight: 700;\n    color: var(--neon-cyan);\n    pointer-events: none;\n    box-shadow: 0 0 16px rgba(0, 243, 255, 0.12);\n  }\n\n  @keyframes pulseGlow {\n    0%, 100% { transform: scale(1); opacity: 0.85; }\n    50% { transform: scale(1.35); opacity: 1; }\n  }\n\n  /* Subtle internal SVG animations */\n  .capy-ear-back, .capy-ear-front {\n    transform-box: fill-box;\n    transform-origin: 30% 85%;\n    animation: earTwitch 4.5s infinite ease-in-out;\n  }\n\n  .capy-ear-front {\n    animation-delay: 0.25s;\n  }\n\n  @keyframes earTwitch {\n    0%, 84%, 100% { transform: rotate(0deg); }\n    87% { transform: rotate(-11deg); }\n    90% { transform: rotate(4deg); }\n    93% { transform: rotate(-8deg); }\n    96% { transform: rotate(0deg); }\n  }\n\n  .capy-eye-blink {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: blinkEye 6s infinite ease-in-out;\n  }\n\n  @keyframes blinkEye {\n    0%, 45%, 49%, 94%, 98%, 100% { transform: scaleY(1); }\n    47%, 96% { transform: scaleY(0.12); }\n  }\n\n  .board-core-light {\n    animation: corePulse 0.9s infinite alternate ease-in-out;\n  }\n\n  @keyframes corePulse {\n    0% { opacity: 0.72; }\n    100% { opacity: 1; }\n  }\n\n  @media (max-width: 640px) {\n    .key-hint { display: none; }\n    .hud { bottom: 14px; padding: 8px 12px; gap: 6px; width: 94vw; }\n    .hud-btn { padding: 7px 11px; font-size: 12px; }\n    .status-banner, .speedometer { top: 12px; font-size: 11px; padding: 6px 12px; }\n    .status-banner { left: 12px; }\n    .speedometer { right: 12px; }\n  }\n</style>\n</head>\n<body>\n\n<div id=\"scene-container\">\n  <canvas id=\"bg-canvas\"></canvas>\n\n  <div class=\"status-banner\">\n    <span class=\"pulse-dot\"></span>\n    <span id=\"vibe-label\">UNBOTHERED HOVER-CRUISE</span>\n  </div>\n\n  <div class=\"speedometer\">\n    <span id=\"speed-readout\">42</span> KM/H &bull; <span id=\"yuzu-status\">YUZU STABLE</span>\n  </div>\n\n  <div id=\"character-stage\">\n    <svg id=\"capy-rig\" viewBox=\"0 0 600 480\" xmlns=\"http://www.w3.org/2000/svg\" overflow=\"visible\">\n      <defs>\n        <!-- Capybara Fur Gradients -->\n        <linearGradient id=\"furBody\" x1=\"0%\" y1=\"0%\" x2=\"85%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#c88d55\"/>\n          <stop offset=\"55%\" stop-color=\"#a86d38\"/>\n          <stop offset=\"100%\" stop-color=\"#7c4a21\"/>\n        </linearGradient>\n\n        <linearGradient id=\"furHead\" x1=\"10%\" y1=\"0%\" x2=\"90%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#d1975e\"/>\n          <stop offset=\"65%\" stop-color=\"#b27640\"/>\n          <stop offset=\"100%\" stop-color=\"#875227\"/>\n        </linearGradient>\n\n        <linearGradient id=\"snoutGrad\" x1=\"0%\" y1=\"15%\" x2=\"100%\" y2=\"95%\">\n          <stop offset=\"0%\" stop-color=\"#8f592c\"/>\n          <stop offset=\"50%\" stop-color=\"#6b3e1b\"/>\n          <stop offset=\"100%\" stop-color=\"#4e2a10\"/>\n        </linearGradient>\n\n        <linearGradient id=\"legBackGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#7e4c23\"/>\n          <stop offset=\"100%\" stop-color=\"#49280f\"/>\n        </linearGradient>\n\n        <linearGradient id=\"legFrontGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#a56a35\"/>\n          <stop offset=\"100%\" stop-color=\"#5d3516\"/>\n        </linearGradient>\n\n        <!-- Hoverboard Gradients -->\n        <linearGradient id=\"deckTopGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"#2b3052\"/>\n          <stop offset=\"50%\" stop-color=\"#434b7a\"/>\n          <stop offset=\"100%\" stop-color=\"#232744\"/>\n        </linearGradient>\n\n        <linearGradient id=\"boardRimGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"15%\">\n          <stop offset=\"0%\" stop-color=\"#ff2a85\"/>\n          <stop offset=\"35%\" stop-color=\"#7a2cff\"/>\n          <stop offset=\"70%\" stop-color=\"#00f3ff\"/>\n          <stop offset=\"100%\" stop-color=\"#00ffaa\"/>\n        </linearGradient>\n\n        <linearGradient id=\"boardBodyGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#14182b\"/>\n          <stop offset=\"50%\" stop-color=\"#1e243d\"/>\n          <stop offset=\"100%\" stop-color=\"#0d101f\"/>\n        </linearGradient>\n\n        <linearGradient id=\"thrusterGlowGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#ffffff\"/>\n          <stop offset=\"30%\" stop-color=\"#00f3ff\" stop-opacity=\"0.95\"/>\n          <stop offset=\"75%\" stop-color=\"#ff2a85\" stop-opacity=\"0.45\"/>\n          <stop offset=\"100%\" stop-color=\"#ff2a85\" stop-opacity=\"0\"/>\n        </linearGradient>\n\n        <linearGradient id=\"scarfGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"25%\">\n          <stop offset=\"0%\" stop-color=\"#ff2a85\"/>\n          <stop offset=\"55%\" stop-color=\"#ff5e57\"/>\n          <stop offset=\"100%\" stop-color=\"#ffbe0b\"/>\n        </linearGradient>\n\n        <linearGradient id=\"visorGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"80%\">\n          <stop offset=\"0%\" stop-color=\"#00f3ff\"/>\n          <stop offset=\"45%\" stop-color=\"#3a86ff\"/>\n          <stop offset=\"80%\" stop-color=\"#ff2a85\"/>\n          <stop offset=\"100%\" stop-color=\"#ffbe0b\"/>\n        </linearGradient>\n\n        <radialGradient id=\"yuzuGrad\" cx=\"35%\" cy=\"30%\" r=\"70%\">\n          <stop offset=\"0%\" stop-color=\"#ffe169\"/>\n          <stop offset=\"45%\" stop-color=\"#ffaa00\"/>\n          <stop offset=\"100%\" stop-color=\"#e06d00\"/>\n        </radialGradient>\n\n        <filter id=\"neonGlow\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\">\n          <feGaussianBlur stdDeviation=\"6\" result=\"blur\"/>\n          <feMerge>\n            <feMergeNode in=\"blur\"/>\n            <feMergeNode in=\"SourceGraphic\"/>\n          </feMerge>\n        </filter>\n\n        <filter id=\"heavyNeonGlow\" x=\"-60%\" y=\"-60%\" width=\"220%\" height=\"220%\">\n          <feGaussianBlur stdDeviation=\"12\" result=\"blur1\"/>\n          <feGaussianBlur stdDeviation=\"4\" result=\"blur2\"/>\n          <feMerge>\n            <feMergeNode in=\"blur1\"/>\n            <feMergeNode in=\"blur2\"/>\n            <feMergeNode in=\"SourceGraphic\"/>\n          </feMerge>\n        </filter>\n      </defs>\n\n      <!-- HOVERBOARD AND CAPYBARA MASTER GROUP -->\n      <g id=\"master-board-group\">\n\n        <!-- THRUSTER PLUMES (UNDER BOARD) -->\n        <g id=\"thrusters\">\n          <!-- Rear Thruster -->\n          <g id=\"thruster-rear\" transform=\"translate(185, 360)\">\n            <ellipse cx=\"0\" cy=\"26\" rx=\"46\" ry=\"22\" fill=\"url(#thrusterGlowGrad)\" id=\"rear-plume-outer\"/>\n            <ellipse cx=\"0\" cy=\"14\" rx=\"28\" ry=\"12\" fill=\"#00f3ff\" opacity=\"0.85\" filter=\"url(#neonGlow)\" id=\"rear-plume-core\"/>\n            <ellipse cx=\"0\" cy=\"8\" rx=\"16\" ry=\"5\" fill=\"#ffffff\"/>\n          </g>\n          <!-- Front Thruster -->\n          <g id=\"thruster-front\" transform=\"translate(415, 360)\">\n            <ellipse cx=\"0\" cy=\"26\" rx=\"46\" ry=\"22\" fill=\"url(#thrusterGlowGrad)\" id=\"front-plume-outer\"/>\n            <ellipse cx=\"0\" cy=\"14\" rx=\"28\" ry=\"12\" fill=\"#00f3ff\" opacity=\"0.85\" filter=\"url(#neonGlow)\" id=\"front-plume-core\"/>\n            <ellipse cx=\"0\" cy=\"8\" rx=\"16\" ry=\"5\" fill=\"#ffffff\"/>\n          </g>\n        </g>\n\n        <!-- HOVERBOARD DECK -->\n        <g id=\"hoverboard\" transform=\"translate(0, 2)\">\n          <!-- Undercarriage Thruster Housings -->\n          <path d=\"M 142,350 L 156,368 L 214,368 L 228,350 Z\" fill=\"#121526\" stroke=\"#00f3ff\" stroke-width=\"1.5\"/>\n          <path d=\"M 372,350 L 386,368 L 444,368 L 458,350 Z\" fill=\"#121526\" stroke=\"#00f3ff\" stroke-width=\"1.5\"/>\n\n          <!-- Main Board Lower Hull -->\n          <path d=\"M 96,334 C 96,356 155,363 300,363 C 445,363 508,355 514,332 C 495,342 435,347 300,347 C 165,347 112,342 96,334 Z\" fill=\"url(#boardBodyGrad)\" stroke=\"#2c355c\" stroke-width=\"1.5\"/>\n\n          <!-- Top Foot Deck -->\n          <path d=\"M 88,328 C 94,309 180,304 300,304 C 420,304 504,310 518,328 C 506,345 425,350 300,350 C 175,350 94,344 88,328 Z\" fill=\"url(#deckTopGrad)\" stroke=\"#4f5b91\" stroke-width=\"1.5\"/>\n\n          <!-- Grip Pads -->\n          <path d=\"M 155,321 L 245,318 L 252,334 L 148,334 Z\" fill=\"#16192b\" stroke=\"#ff2a85\" stroke-width=\"1\" opacity=\"0.9\"/>\n          <path d=\"M 330,318 L 430,320 L 422,334 L 336,334 Z\" fill=\"#16192b\" stroke=\"#00f3ff\" stroke-width=\"1\" opacity=\"0.9\"/>\n          <!-- Grip Texture Lines -->\n          <line x1=\"175\" y1=\"320\" x2=\"170\" y2=\"333\" stroke=\"#2d3459\" stroke-width=\"2\"/>\n          <line x1=\"195\" y1=\"319\" x2=\"190\" y2=\"333\" stroke=\"#2d3459\" stroke-width=\"2\"/>\n          <line x1=\"215\" y1=\"319\" x2=\"210\" y2=\"333\" stroke=\"#2d3459\" stroke-width=\"2\"/>\n          <line x1=\"358\" y1=\"319\" x2=\"362\" y2=\"333\" stroke=\"#2d3459\" stroke-width=\"2\"/>\n          <line x1=\"378\" y1=\"319\" x2=\"382\" y2=\"333\" stroke=\"#2d3459\" stroke-width=\"2\"/>\n          <line x1=\"398\" y1=\"320\" x2=\"402\" y2=\"333\" stroke=\"#2d3459\" stroke-width=\"2\"/>\n\n          <!-- Neon Side Bumper Tube -->\n          <path d=\"M 86,329 C 110,348 205,353 300,353 C 395,353 492,347 520,328\" fill=\"none\" stroke=\"url(#boardRimGrad)\" stroke-width=\"6.5\" stroke-linecap=\"round\" filter=\"url(#neonGlow)\" class=\"board-core-light\"/>\n          <path d=\"M 90,329 C 114,347 205,352 300,352 C 395,352 489,346 516,328\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\"0.85\"/>\n\n          <!-- Side Energy Cells -->\n          <rect x=\"275\" y=\"346\" width=\"50\" height=\"7\" rx=\"3.5\" fill=\"#00f3ff\" filter=\"url(#neonGlow)\" class=\"board-core-light\"/>\n          <circle cx=\"142\" cy=\"340\" r=\"3.5\" fill=\"#ffbe0b\" filter=\"url(#neonGlow)\"/>\n          <circle cx=\"458\" cy=\"340\" r=\"3.5\" fill=\"#00ffaa\" filter=\"url(#neonGlow)\"/>\n\n          <!-- Front Nose Headlight Cone -->\n          <path d=\"M 516,327 L 598,302 L 598,358 Z\" fill=\"url(#thrusterGlowGrad)\" opacity=\"0.28\" transform=\"rotate(-8 516 327)\"/>\n        </g>\n\n        <!-- CAPYBARA BODY GROUP (Allows squat/jump compression) -->\n        <g id=\"capy-body-group\">\n\n          <!-- Flowing Scarf Tail (Behind body, dynamic path updated in JS) -->\n          <g id=\"scarf-tail-group\">\n            <path id=\"scarf-tail-shadow\" d=\"M 275,205 Q 195,215 125,195 Q 85,185 55,200\" fill=\"none\" stroke=\"#9e1450\" stroke-width=\"22\" stroke-linecap=\"round\"/>\n            <path id=\"scarf-tail-main\" d=\"M 275,200 Q 195,208 125,188 Q 85,178 55,192\" fill=\"none\" stroke=\"url(#scarfGrad)\" stroke-width=\"19\" stroke-linecap=\"round\"/>\n            <path id=\"scarf-tail-stripe\" d=\"M 275,200 Q 195,208 125,188 Q 85,178 55,192\" fill=\"none\" stroke=\"#fff3b0\" stroke-width=\"3\" stroke-dasharray=\"10 14\" stroke-linecap=\"round\" opacity=\"0.85\"/>\n          </g>\n\n          <!-- Back Far Legs -->\n          <g id=\"legs-far\">\n            <!-- Rear Far Leg -->\n            <path d=\"M 192,272 C 186,294 180,312 183,325 C 185,330 206,331 209,325 C 211,312 214,292 216,272 Z\" fill=\"url(#legBackGrad)\"/>\n            <ellipse cx=\"198\" cy=\"326\" rx=\"14\" ry=\"5.5\" fill=\"#3a1e0a\"/>\n            <!-- Front Far Leg -->\n            <path d=\"M 342,270 C 344,292 346,310 349,324 C 351,329 372,329 374,323 C 374,308 370,288 366,268 Z\" fill=\"url(#legBackGrad)\"/>\n            <ellipse cx=\"363\" cy=\"324\" rx=\"14\" ry=\"5.5\" fill=\"#3a1e0a\"/>\n          </g>\n\n          <!-- Main Potato Torso -->\n          <g id=\"torso\">\n            <path d=\"M 164,250\n                     C 155,205 186,166 244,164\n                     C 288,162 325,168 358,162\n                     C 392,156 410,188 408,228\n                     C 406,274 374,294 316,295\n                     C 248,296 173,294 164,250 Z\"\n                  fill=\"url(#furBody)\" stroke=\"#593213\" stroke-width=\"2\"/>\n\n            <!-- Warm Sunlight Rim Highlight on Back -->\n            <path d=\"M 178,204 C 198,173 242,166 294,167 C 324,168 345,166 364,164\"\n                  fill=\"none\" stroke=\"#ecc08d\" stroke-width=\"4.5\" stroke-linecap=\"round\" opacity=\"0.55\"/>\n\n            <!-- Cute Fur Texture Strokes -->\n            <path d=\"M 215,198 L 203,203 M 228,205 L 214,211 M 265,212 L 250,216 M 192,235 L 178,240 M 288,248 L 274,252 M 242,262 L 226,266\"\n                  stroke=\"#70411b\" stroke-width=\"2.5\" stroke-linecap=\"round\" opacity=\"0.65\"/>\n\n            <!-- Little Capy Butt Notch -->\n            <path d=\"M 163,234 C 157,242 158,254 165,260\" fill=\"none\" stroke=\"#593213\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n          </g>\n\n          <!-- Foreground Near Legs -->\n          <g id=\"legs-near\">\n            <!-- Rear Near Leg -->\n            <path d=\"M 212,266 C 206,292 202,314 205,329 C 208,334 232,334 235,328 C 237,312 242,290 245,268 Z\"\n                  fill=\"url(#legFrontGrad)\" stroke=\"#593213\" stroke-width=\"1.8\"/>\n            <!-- Toes -->\n            <ellipse cx=\"222\" cy=\"329\" rx=\"16\" ry=\"6\" fill=\"#472710\"/>\n            <path d=\"M 228,325 L 233,332 M 221,325 L 225,333\" stroke=\"#2b1607\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n\n            <!-- Front Near Leg -->\n            <path d=\"M 362,262 C 365,288 370,312 374,327 C 377,333 400,332 402,326 C 402,310 396,285 390,260 Z\"\n                  fill=\"url(#legFrontGrad)\" stroke=\"#593213\" stroke-width=\"1.8\"/>\n            <!-- Toes -->\n            <ellipse cx=\"389\" cy=\"327\" rx=\"16\" ry=\"6\" fill=\"#472710\"/>\n            <path d=\"M 395,323 L 400,330 M 388,323 L 392,331\" stroke=\"#2b1607\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </g>\n\n          <!-- Cozy Neck Scarf Wrap -->\n          <path d=\"M 318,166 C 314,196 346,232 396,236 C 406,237 415,224 410,210 C 374,202 346,180 338,156 Z\"\n                fill=\"url(#scarfGrad)\" stroke=\"#7a113b\" stroke-width=\"2\"/>\n          <path d=\"M 325,176 C 328,198 356,222 398,226\"\n                fill=\"none\" stroke=\"#fff3b0\" stroke-width=\"2.5\" stroke-dasharray=\"8 10\" stroke-linecap=\"round\" opacity=\"0.8\"/>\n\n          <!-- CAPYBARA HEAD GROUP (Tilts & bobs slightly) -->\n          <g id=\"capy-head-group\" transform=\"translate(0, 0)\">\n\n            <!-- Back Ear -->\n            <g class=\"capy-ear-back\">\n              <ellipse cx=\"348\" cy=\"108\" rx=\"12\" ry=\"16\" transform=\"rotate(-24 348 108)\" fill=\"#5c3415\" stroke=\"#3d210b\" stroke-width=\"2\"/>\n              <ellipse cx=\"349\" cy=\"109\" rx=\"6\" ry=\"9\" transform=\"rotate(-24 349 109)\" fill=\"#42230c\"/>\n            </g>\n\n            <!-- Main Rectangular/Rounded Capybara Head -->\n            <path d=\"M 322,175\n                     C 314,142 322,106 356,102\n                     C 386,98 432,102 458,110\n                     C 482,118 492,142 488,172\n                     C 484,202 462,212 428,210\n                     C 392,208 352,212 322,175 Z\"\n                  fill=\"url(#furHead)\" stroke=\"#593213\" stroke-width=\"2\"/>\n\n            <!-- Dark Blunt Snout Patch -->\n            <path d=\"M 434,106\n                     C 462,109 490,124 490,162\n                     C 490,196 468,210 436,210\n                     C 418,210 412,182 414,154\n                     C 416,126 420,105 434,106 Z\"\n                  fill=\"url(#snoutGrad)\"/>\n\n            <!-- Head Top Highlight -->\n            <path d=\"M 356,105 C 386,101 422,104 448,111\" fill=\"none\" stroke=\"#f0c797\" stroke-width=\"4\" stroke-linecap=\"round\" opacity=\"0.6\"/>\n\n            <!-- Nostril -->\n            <ellipse cx=\"468\" cy=\"138\" rx=\"6.5\" ry=\"4\" transform=\"rotate(18 468 138)\" fill=\"#261205\"/>\n            <circle cx=\"466\" cy=\"137\" r=\"1.5\" fill=\"#704526\" opacity=\"0.6\"/>\n\n            <!-- Serene Unbothered Mouth & Nose Split -->\n            <path d=\"M 484,158 C 478,164 472,172 472,184\" fill=\"none\" stroke=\"#2b1506\" stroke-width=\"2.8\" stroke-linecap=\"round\"/>\n            <path d=\"M 454,183 Q 465,190 476,182\" fill=\"none\" stroke=\"#2b1506\" stroke-width=\"2.8\" stroke-linecap=\"round\"/>\n\n            <!-- Subtle Cheek Blush -->\n            <ellipse cx=\"418\" cy=\"172\" rx=\"12\" ry=\"7\" fill=\"#ff5e7e\" opacity=\"0.28\"/>\n\n            <!-- Whiskers -->\n            <path d=\"M 452,166 L 434,169 M 456,174 L 438,179 M 482,168 L 497,172\" stroke=\"#d8ad80\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\"0.75\"/>\n\n            <!-- Calm Half-Closed Eye (Visible under or through visor) -->\n            <g class=\"capy-eye-blink\">\n              <ellipse cx=\"404\" cy=\"136\" rx=\"9\" ry=\"6.5\" fill=\"#211004\"/>\n              <!-- Heavy Chill Eyelid -->\n              <path d=\"M 393,133 Q 404,136 415,132 L 414,127 L 394,128 Z\" fill=\"#a86d38\"/>\n              <line x1=\"393\" y1=\"134\" x2=\"416\" y2=\"132\" stroke=\"#3b1e08\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n              <circle cx=\"407\" cy=\"136\" r=\"2\" fill=\"#ffffff\" opacity=\"0.9\"/>\n            </g>\n\n            <!-- Futuristic Cyber-Visor Shades (Toggleable) -->\n            <g id=\"cyber-visor\">\n              <!-- Strap -->\n              <path d=\"M 332,126 L 386,129\" fill=\"none\" stroke=\"#1e2238\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <!-- Lens -->\n              <path d=\"M 380,121 L 444,122 L 436,146 L 408,147 L 398,141 L 376,141 Z\"\n                    fill=\"url(#visorGrad)\" stroke=\"#ffffff\" stroke-width=\"1.8\" filter=\"url(#neonGlow)\" opacity=\"0.92\"/>\n              <!-- Lens Glint -->\n              <path d=\"M 392,125 L 404,125 L 396,142 L 386,142 Z\" fill=\"#ffffff\" opacity=\"0.55\"/>\n              <path d=\"M 410,125 L 415,125 L 407,142 L 402,142 Z\" fill=\"#ffffff\" opacity=\"0.35\"/>\n            </g>\n\n            <!-- Front Ear -->\n            <g class=\"capy-ear-front\">\n              <ellipse cx=\"332\" cy=\"115\" rx=\"13\" ry=\"17\" transform=\"rotate(-30 332 115)\" fill=\"#78461f\" stroke=\"#47270e\" stroke-width=\"2\"/>\n              <ellipse cx=\"334\" cy=\"116\" rx=\"7\" ry=\"10\" transform=\"rotate(-30 334 116)\" fill=\"#4d2b10\"/>\n              <path d=\"M 326,105 C 330,101 336,103 339,108\" fill=\"none\" stroke=\"#c88d55\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            </g>\n\n            <!-- Iconic Yuzu / Tangerine Balanced on Head (Physics Driven in JS) -->\n            <g id=\"yuzu-group\" transform=\"translate(384, 98)\">\n              <!-- Contact Shadow -->\n              <ellipse cx=\"0\" cy=\"4\" rx=\"16\" ry=\"4\" fill=\"#4a280d\" opacity=\"0.45\"/>\n              <!-- Orange Fruit Body -->\n              <ellipse cx=\"0\" cy=\"-11\" rx=\"19\" ry=\"15.5\" fill=\"url(#yuzuGrad)\" stroke=\"#9e4700\" stroke-width=\"1.8\"/>\n              <!-- Dimple Texture -->\n              <circle cx=\"-8\" cy=\"-14\" r=\"1\" fill=\"#ffffff\" opacity=\"0.6\"/>\n              <circle cx=\"-4\" cy=\"-18\" r=\"1.2\" fill=\"#ffffff\" opacity=\"0.5\"/>\n              <circle cx=\"7\" cy=\"-7\" r=\"1\" fill=\"#c45100\" opacity=\"0.5\"/>\n              <circle cx=\"11\" cy=\"-12\" r=\"1\" fill=\"#c45100\" opacity=\"0.5\"/>\n              <!-- Stem & Green Leaf -->\n              <path d=\"M 0,-26 L 1,-31\" stroke=\"#4f3111\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n              <path d=\"M 1,-27 C 8,-34 19,-32 22,-23 C 14,-20 6,-22 1,-27 Z\" fill=\"#38b000\" stroke=\"#1b5e00\" stroke-width=\"1.5\"/>\n              <path d=\"M 3,-27 Q 11,-27 18,-24\" fill=\"none\" stroke=\"#9ef01a\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n            </g>\n\n          </g> <!-- End Head Group -->\n        </g> <!-- End Body Group -->\n      </g> <!-- End Master Board Group -->\n    </svg>\n  </div>\n\n  <canvas id=\"fg-canvas\"></canvas>\n\n  <div class=\"hud\" id=\"hud-bar\">\n    <button class=\"hud-btn\" id=\"btn-trick\" title=\"Perform Ollie &amp; 360 Flip\">\n      <span>Ollie Flip</span>\n      <span class=\"key-hint\">SPACE</span>\n    </button>\n    <button class=\"hud-btn\" id=\"btn-boost\" title=\"Toggle Turbo Hyperdrive\">\n      <span>Turbo Boost</span>\n      <span class=\"key-hint\">B</span>\n    </button>\n    <button class=\"hud-btn active\" id=\"btn-shades\" title=\"Toggle Cyber Shades\">\n      <span>Cyber Shades</span>\n      <span class=\"key-hint\">S</span>\n    </button>\n    <button class=\"hud-btn\" id=\"btn-theme\" title=\"Switch Atmosphere\">\n      <span id=\"theme-btn-text\">Theme: Synthwave</span>\n      <span class=\"key-hint\">T</span>\n    </button>\n  </div>\n</div>\n\n<script>\n(() => {\n  const bgCanvas = document.getElementById('bg-canvas');\n  const bgCtx = bgCanvas.getContext('2d');\n  const fgCanvas = document.getElementById('fg-canvas');\n  const fgCtx = fgCanvas.getContext('2d');\n\n  // SVG Elements for procedural physics & animation\n  const masterBoardGroup = document.getElementById('master-board-group');\n  const capyBodyGroup = document.getElementById('capy-body-group');\n  const capyHeadGroup = document.getElementById('capy-head-group');\n  const yuzuGroup = document.getElementById('yuzu-group');\n  const scarfTailMain = document.getElementById('scarf-tail-main');\n  const scarfTailShadow = document.getElementById('scarf-tail-shadow');\n  const scarfTailStripe = document.getElementById('scarf-tail-stripe');\n  const rearPlumeOuter = document.getElementById('rear-plume-outer');\n  const rearPlumeCore = document.getElementById('rear-plume-core');\n  const frontPlumeOuter = document.getElementById('front-plume-outer');\n  const frontPlumeCore = document.getElementById('front-plume-core');\n  const cyberVisor = document.getElementById('cyber-visor');\n\n  // UI Elements\n  const btnTrick = document.getElementById('btn-trick');\n  const btnBoost = document.getElementById('btn-boost');\n  const btnShades = document.getElementById('btn-shades');\n  const btnTheme = document.getElementById('btn-theme');\n  const themeBtnText = document.getElementById('theme-btn-text');\n  const speedReadout = document.getElementById('speed-readout');\n  const vibeLabel = document.getElementById('vibe-label');\n  const yuzuStatus = document.getElementById('yuzu-status');\n  const sceneContainer = document.getElementById('scene-container');\n\n  let width = window.innerWidth;\n  let height = window.innerHeight;\n\n  // Color Palettes / Themes\n  const themes = [\n    {\n      name: 'Synthwave',\n      skyTop: '#090418',\n      skyMid: '#260b47',\n      skyBot: '#871e64',\n      sunTop: '#ffea79',\n      sunBot: '#ff1e74',\n      mtnFar: '#1b0938',\n      mtnNear: '#110526',\n      groundTop: '#16072e',\n      groundBot: '#06020f',\n      gridColor: 'rgba(0, 243, 255, 0.38)',\n      gridGlow: 'rgba(255, 42, 133, 0.45)',\n      accent1: '#00f3ff',\n      accent2: '#ff2a85'\n    },\n    {\n      name: 'Golden Sunset',\n      skyTop: '#1a1936',\n      skyMid: '#7c2e52',\n      skyBot: '#f78848',\n      sunTop: '#fff7ae',\n      sunBot: '#ff5436',\n      mtnFar: '#3d1936',\n      mtnNear: '#230d24',\n      groundTop: '#240e26',\n      groundBot: '#0c0510',\n      gridColor: 'rgba(255, 190, 11, 0.35)',\n      gridGlow: 'rgba(255, 94, 87, 0.45)',\n      accent1: '#ffbe0b',\n      accent2: '#ff5e57'\n    },\n    {\n      name: 'Neo Tokyo Mint',\n      skyTop: '#03131f',\n      skyMid: '#092e42',\n      skyBot: '#106973',\n      sunTop: '#a8ffdb',\n      sunBot: '#00bbf9',\n      mtnFar: '#072230',\n      mtnNear: '#04141f',\n      groundTop: '#061a26',\n      groundBot: '#02090f',\n      gridColor: 'rgba(0, 255, 170, 0.35)',\n      gridGlow: 'rgba(0, 187, 249, 0.45)',\n      accent1: '#00ffaa',\n      accent2: '#00bbf9'\n    }\n  ];\n\n  let currentThemeIdx = 0;\n\n  // Interactive & Physics State\n  const state = {\n    time: 0,\n    baseSpeed: 1,\n    targetSpeed: 1,\n    speed: 1,\n    isBoosting: false,\n    shadesOn: true,\n    pointerX: 0,\n    pointerY: 0,\n    smoothPointerX: 0,\n    smoothPointerY: 0,\n    scrollOffset: 0,\n    // Trick jump state\n    isJumping: false,\n    jumpProgress: 0,\n    trickType: 0, // 0: 360 flip, 1: backflip + yuzu toss\n    // Yuzu secondary physics\n    yuzuY: 0,\n    yuzuVy: 0,\n    yuzuRot: 0\n  };\n\n  // Parallax World Entities\n  const stars = [];\n  const farBuildings = [];\n  const mountains = [];\n  const palmTrees = [];\n  const particles = [];\n  const speedLines = [];\n  const floatingOrbs = [];\n\n  function resize() {\n    width = window.innerWidth;\n    height = window.innerHeight;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n\n    bgCanvas.width = width * dpr;\n    bgCanvas.height = height * dpr;\n    bgCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n    fgCanvas.width = width * dpr;\n    fgCanvas.height = height * dpr;\n    fgCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  function initWorld() {\n    stars.length = 0;\n    for (let i = 0; i < 95; i++) {\n      stars.push({\n        x: Math.random(),\n        y: Math.random() * 0.58,\n        r: Math.random() * 1.8 + 0.5,\n        phase: Math.random() * Math.PI * 2,\n        speed: Math.random() * 2 + 1\n      });\n    }\n\n    farBuildings.length = 0;\n    let bx = 0;\n    while (bx < 2200) {\n      const bw = 32 + Math.random() * 55;\n      const bh = 45 + Math.random() * 145;\n      farBuildings.push({\n        x: bx,\n        w: bw,\n        h: bh,\n        hasSpire: Math.random() > 0.65,\n        winSeed: Math.floor(Math.random() * 100)\n      });\n      bx += bw + 4 + Math.random() * 14;\n    }\n\n    mountains.length = 0;\n    const numPeaks = 18;\n    for (let i = 0; i < numPeaks; i++) {\n      mountains.push({\n        x: (i / numPeaks) * 2000,\n        w: 180 + Math.random() * 140,\n        h: 70 + Math.random() * 95\n      });\n    }\n\n    palmTrees.length = 0;\n    for (let i = 0; i < 7; i++) {\n      palmTrees.push({\n        x: i * 340 + Math.random() * 110,\n        scale: 0.75 + Math.random() * 0.35,\n        lean: 0.18 + Math.random() * 0.14\n      });\n    }\n\n    speedLines.length = 0;\n    for (let i = 0; i < 24; i++) {\n      speedLines.push({\n        x: Math.random() * width,\n        y: Math.random() * height,\n        len: 60 + Math.random() * 140,\n        speed: 14 + Math.random() * 12,\n        alpha: 0.12 + Math.random() * 0.25\n      });\n    }\n  }\n\n  // Trigger a hoverboard trick\n  function triggerTrick() {\n    if (state.isJumping) return;\n    state.isJumping = true;\n    state.jumpProgress = 0;\n    state.trickType = (state.trickType + 1) % 2;\n    state.yuzuVy = -8.5;\n    vibeLabel.textContent = state.trickType === 0 ? '360 SHUVIT OLLIE!' : 'CITRUS BACKFLIP!';\n    yuzuStatus.textContent = 'FREEFALLING!';\n\n    // Spawn burst of neon sparks beneath the board\n    const rigRect = masterBoardGroup.getBoundingClientRect();\n    const cx = rigRect.left + rigRect.width * 0.5;\n    const cy = rigRect.top + rigRect.height * 0.78;\n    const theme = themes[currentThemeIdx];\n\n    for (let i = 0; i < 28; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const spd = 2 + Math.random() * 7;\n      particles.push({\n        x: cx + (Math.random() - 0.5) * 140,\n        y: cy,\n        vx: Math.cos(angle) * spd - 3 * state.speed,\n        vy: Math.sin(angle) * spd - 1,\n        size: 3 + Math.random() * 5,\n        life: 1,\n        decay: 0.02 + Math.random() * 0.02,\n        color: i % 2 === 0 ? theme.accent1 : theme.accent2,\n        type: 'spark'\n      });\n    }\n  }\n\n  function toggleBoost() {\n    state.isBoosting = !state.isBoosting;\n    state.targetSpeed = state.isBoosting ? 2.35 : 1.0;\n    btnBoost.classList.toggle('active', state.isBoosting);\n    vibeLabel.textContent = state.isBoosting ? 'MAXIMUM CITRUS OVERDRIVE' : 'UNBOTHERED HOVER-CRUISE';\n  }\n\n  function toggleShades() {\n    state.shadesOn = !state.shadesOn;\n    cyberVisor.style.display = state.shadesOn ? 'block' : 'none';\n    btnShades.classList.toggle('active', state.shadesOn);\n  }\n\n  function cycleTheme() {\n    currentThemeIdx = (currentThemeIdx + 1) % themes.length;\n    themeBtnText.textContent = `Theme: ${themes[currentThemeIdx].name}`;\n  }\n\n  // Event Listeners\n  btnTrick.addEventListener('click', (e) => {\n    e.stopPropagation();\n    triggerTrick();\n  });\n\n  btnBoost.addEventListener('click', (e) => {\n    e.stopPropagation();\n    toggleBoost();\n  });\n\n  btnShades.addEventListener('click', (e) => {\n    e.stopPropagation();\n    toggleShades();\n  });\n\n  btnTheme.addEventListener('click', (e) => {\n    e.stopPropagation();\n    cycleTheme();\n  });\n\n  sceneContainer.addEventListener('pointerdown', (e) => {\n    if (e.target.closest('#hud-bar')) return;\n    triggerTrick();\n  });\n\n  window.addEventListener('pointermove', (e) => {\n    state.pointerX = (e.clientX / width - 0.5) * 2;\n    state.pointerY = (e.clientY / height - 0.5) * 2;\n  });\n\n  window.addEventListener('keydown', (e) => {\n    if (e.code === 'Space' || e.code === 'ArrowUp') {\n      e.preventDefault();\n      triggerTrick();\n    } else if (e.key === 'b' || e.key === 'B') {\n      toggleBoost();\n    } else if (e.key === 's' || e.key === 'S') {\n      toggleShades();\n    } else if (e.key === 't' || e.key === 'T') {\n      cycleTheme();\n    }\n  });\n\n  window.addEventListener('resize', resize);\n\n  // Draw Background Synthwave / Sunset World\n  function drawBackground(dt, theme) {\n    const horizonY = height * 0.64;\n\n    // 1. Sky Gradient\n    const skyGrad = bgCtx.createLinearGradient(0, 0, 0, horizonY);\n    skyGrad.addColorStop(0, theme.skyTop);\n    skyGrad.addColorStop(0.55, theme.skyMid);\n    skyGrad.addColorStop(1, theme.skyBot);\n    bgCtx.fillStyle = skyGrad;\n    bgCtx.fillRect(0, 0, width, horizonY);\n\n    // 2. Twinkling Stars\n    for (let i = 0; i < stars.length; i++) {\n      const s = stars[i];\n      const alpha = 0.35 + 0.65 * Math.sin(state.time * s.speed + s.phase);\n      bgCtx.fillStyle = `rgba(255, 255, 255, ${alpha.toFixed(2)})`;\n      bgCtx.beginPath();\n      bgCtx.arc(s.x * width, s.y * height, s.r, 0, Math.PI * 2);\n      bgCtx.fill();\n    }\n\n    // 3. Retro Sliced Sun\n    const sunRadius = Math.min(width, height) * 0.21;\n    const sunX = width * 0.5 - state.smoothPointerX * 18;\n    const sunY = horizonY - sunRadius * 0.52 - state.smoothPointerY * 10;\n\n    bgCtx.save();\n    const sunGlow = bgCtx.createRadialGradient(sunX, sunY, sunRadius * 0.2, sunX, sunY, sunRadius * 1.7);\n    sunGlow.addColorStop(0, theme.sunBot + '66');\n    sunGlow.addColorStop(1, 'transparent');\n    bgCtx.fillStyle = sunGlow;\n    bgCtx.beginPath();\n    bgCtx.arc(sunX, sunY, sunRadius * 1.7, 0, Math.PI * 2);\n    bgCtx.fill();\n\n    const sunGrad = bgCtx.createLinearGradient(sunX, sunY - sunRadius, sunX, sunY + sunRadius);\n    sunGrad.addColorStop(0, theme.sunTop);\n    sunGrad.addColorStop(1, theme.sunBot);\n    bgCtx.fillStyle = sunGrad;\n    bgCtx.beginPath();\n    bgCtx.arc(sunX, sunY, sunRadius, 0, Math.PI * 2);\n    bgCtx.fill();\n\n    // Horizontal Sun Scanline Cutouts\n    bgCtx.fillStyle = theme.skyBot;\n    for (let i = 0; i < 7; i++) {\n      const sliceY = sunY + sunRadius * (0.1 + i * 0.13);\n      const sliceH = (i + 1) * 2.1;\n      bgCtx.fillRect(sunX - sunRadius - 2, sliceY, sunRadius * 2 + 4, sliceH);\n    }\n    bgCtx.restore();\n\n    // 4. Distant Cyber City Skyline\n    bgCtx.save();\n    const citySpeed = state.scrollOffset * 0.14;\n    for (let i = 0; i < farBuildings.length; i++) {\n      const b = farBuildings[i];\n      let drawX = ((b.x - citySpeed) % 2200 + 2200) % 2200 - 200;\n      if (drawX > width + 100) continue;\n\n      bgCtx.fillStyle = theme.mtnFar;\n      bgCtx.fillRect(drawX, horizonY - b.h, b.w, b.h + 2);\n\n      if (b.hasSpire) {\n        bgCtx.beginPath();\n        bgCtx.moveTo(drawX + b.w * 0.5, horizonY - b.h - 28);\n        bgCtx.lineTo(drawX + b.w * 0.35, horizonY - b.h);\n        bgCtx.lineTo(drawX + b.w * 0.65, horizonY - b.h);\n        bgCtx.fill();\n      }\n\n      // Tiny lit windows\n      bgCtx.fillStyle = (i % 2 === 0) ? theme.accent1 : theme.accent2;\n      bgCtx.globalAlpha = 0.35;\n      for (let wy = horizonY - b.h + 10; wy < horizonY - 12; wy += 12) {\n        for (let wx = drawX + 6; wx < drawX + b.w - 8; wx += 10) {\n          if (((wx + wy + b.winSeed) % 5) < 2) {\n            bgCtx.fillRect(wx, wy, 4, 6);\n          }\n        }\n      }\n      bgCtx.globalAlpha = 1;\n    }\n    bgCtx.restore();\n\n    // 5. Layered Mountain Ridge\n    bgCtx.save();\n    const mtnSpeed = state.scrollOffset * 0.32;\n    bgCtx.fillStyle = theme.mtnNear;\n    bgCtx.beginPath();\n    bgCtx.moveTo(-200, horizonY + 4);\n    for (let i = 0; i < mountains.length; i++) {\n      const m = mountains[i];\n      let mx = ((m.x - mtnSpeed) % 2000 + 2000) % 2000 - 200;\n      bgCtx.lineTo(mx, horizonY);\n      bgCtx.lineTo(mx + m.w * 0.5, horizonY - m.h);\n      bgCtx.lineTo(mx + m.w, horizonY);\n    }\n    bgCtx.lineTo(width + 200, horizonY + 4);\n    bgCtx.closePath();\n    bgCtx.fill();\n    bgCtx.restore();\n\n    // 6. Ground Plane & Moving Perspective Grid\n    const groundGrad = bgCtx.createLinearGradient(0, horizonY, 0, height);\n    groundGrad.addColorStop(0, theme.groundTop);\n    groundGrad.addColorStop(1, theme.groundBot);\n    bgCtx.fillStyle = groundGrad;\n    bgCtx.fillRect(0, horizonY, width, height - horizonY);\n\n    // Horizon Glow Strip\n    const hGlow = bgCtx.createLinearGradient(0, horizonY - 10, 0, horizonY + 24);\n    hGlow.addColorStop(0, 'transparent');\n    hGlow.addColorStop(0.45, theme.accent2);\n    hGlow.addColorStop(1, 'transparent');\n    bgCtx.fillStyle = hGlow;\n    bgCtx.fillRect(0, horizonY - 10, width, 34);\n\n    // Perspective Grid Lines\n    bgCtx.save();\n    bgCtx.strokeStyle = theme.gridColor;\n    bgCtx.lineWidth = 1.5;\n\n    const gridSpacing = 90;\n    const gridOffset = (state.scrollOffset * 1.45) % gridSpacing;\n    const centerX = width * 0.5;\n    const groundH = height - horizonY;\n\n    bgCtx.beginPath();\n    for (let x = -width * 1.5 - gridOffset; x < width * 2.5; x += gridSpacing) {\n      const topX = centerX + (x - centerX) * 0.18;\n      bgCtx.moveTo(topX, horizonY);\n      bgCtx.lineTo(x, height);\n    }\n\n    // Horizontal perspective rungs\n    for (let i = 1; i <= 11; i++) {\n      const norm = Math.pow(i / 11, 2.1);\n      const y = horizonY + norm * groundH;\n      bgCtx.moveTo(0, y);\n      bgCtx.lineTo(width, y);\n    }\n    bgCtx.stroke();\n    bgCtx.restore();\n\n    // 7. Silhouette Palm Trees Passing By\n    const palmSpeed = state.scrollOffset * 0.65;\n    for (let i = 0; i < palmTrees.length; i++) {\n      const p = palmTrees[i];\n      let px = ((p.x - palmSpeed) % 2380 + 2380) % 2380 - 200;\n      if (px > width + 150) continue;\n      drawPalmTree(bgCtx, px, horizonY + 12, p.scale, p.lean, theme.mtnNear);\n    }\n\n    // 8. Hoverboard Dynamic Neon Ground Reflection\n    const rigRect = masterBoardGroup.getBoundingClientRect();\n    const boardCenterX = rigRect.left + rigRect.width * 0.5;\n    const shadowY = Math.min(height * 0.82, rigRect.bottom + 14);\n    const jumpFactor = state.isJumping ? (1 - Math.sin(state.jumpProgress * Math.PI) * 0.55) : 1;\n\n    bgCtx.save();\n    const reflGrad = bgCtx.createRadialGradient(\n      boardCenterX, shadowY, 10,\n      boardCenterX, shadowY, 195 * jumpFactor\n    );\n    reflGrad.addColorStop(0, theme.accent1 + '88');\n    reflGrad.addColorStop(0.45, theme.accent2 + '44');\n    reflGrad.addColorStop(1, 'transparent');\n    bgCtx.fillStyle = reflGrad;\n    bgCtx.beginPath();\n    bgCtx.ellipse(boardCenterX, shadowY, 190 * jumpFactor, 26 * jumpFactor, 0, 0, Math.PI * 2);\n    bgCtx.fill();\n\n    // Dark Core Shadow\n    bgCtx.fillStyle = 'rgba(4, 2, 14, 0.65)';\n    bgCtx.beginPath();\n    bgCtx.ellipse(boardCenterX, shadowY, 115 * jumpFactor, 12 * jumpFactor, 0, 0, Math.PI * 2);\n    bgCtx.fill();\n    bgCtx.restore();\n  }\n\n  function drawPalmTree(ctx, x, y, scale, lean, color) {\n    ctx.save();\n    ctx.translate(x, y);\n    ctx.scale(scale, scale);\n    ctx.strokeStyle = color;\n    ctx.fillStyle = color;\n    ctx.lineWidth = 8;\n    ctx.lineCap = 'round';\n\n    const topX = 28 * lean * 4;\n    const topY = -128;\n\n    ctx.beginPath();\n    ctx.moveTo(0, 0);\n    ctx.quadraticCurveTo(topX * 0.3, topY * 0.5, topX, topY);\n    ctx.stroke();\n\n    const frondAngles = [-2.5, -1.9, -1.3, -0.5, 0.2, 0.8];\n    for (let a of frondAngles) {\n      ctx.beginPath();\n      ctx.moveTo(topX, topY);\n      const fx = topX + Math.cos(a) * 52;\n      const fy = topY + Math.sin(a) * 36 + 14;\n      ctx.quadraticCurveTo(topX + Math.cos(a) * 26, topY + Math.sin(a) * 18 - 10, fx, fy);\n      ctx.lineWidth = 5;\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n\n  // Update Capybara & Hoverboard SVG Rig + Particle System\n  function updateAndDrawForeground(dt, theme) {\n    fgCtx.clearRect(0, 0, width, height);\n\n    // Smooth pointer interpolation\n    state.smoothPointerX += (state.pointerX - state.smoothPointerX) * 0.08;\n    state.smoothPointerY += (state.pointerY - state.smoothPointerY) * 0.08;\n    state.speed += (state.targetSpeed - state.speed) * 0.06;\n\n    // Update speedometer readout\n    const displayKmh = Math.round(42 * state.speed + Math.sin(state.time * 3) * 2);\n    speedReadout.textContent = displayKmh;\n\n    // Hover bobbing & pitch\n    const hoverFreq = 3.2 * (0.85 + state.speed * 0.15);\n    const hoverBobY = Math.sin(state.time * hoverFreq) * 11;\n    const hoverPitch = Math.cos(state.time * hoverFreq) * 2.2\n                     + state.smoothPointerX * 7\n                     + (state.isBoosting ? -4.5 : 0);\n\n    let jumpOffsetY = 0;\n    let trickRotation = 0;\n    let bodySquashY = 1;\n\n    if (state.isJumping) {\n      state.jumpProgress += dt * 1.45;\n      if (state.jumpProgress >= 1) {\n        state.isJumping = false;\n        state.jumpProgress = 0;\n        vibeLabel.textContent = state.isBoosting ? 'MAXIMUM CITRUS OVERDRIVE' : 'UNBOTHERED HOVER-CRUISE';\n        yuzuStatus.textContent = 'YUZU STABLE';\n      } else {\n        const p = state.jumpProgress;\n        jumpOffsetY = -Math.sin(p * Math.PI) * 135;\n        if (state.trickType === 0) {\n          trickRotation = p * 360;\n        } else {\n          trickRotation = -p * 360;\n        }\n        // Subtle squash at takeoff and landing\n        if (p < 0.12) {\n          bodySquashY = 0.92;\n        } else if (p > 0.88) {\n          bodySquashY = 0.94;\n        }\n      }\n    }\n\n    const totalX = state.smoothPointerX * 32;\n    const totalY = hoverBobY + jumpOffsetY + state.smoothPointerY * 18;\n    const totalRot = hoverPitch + trickRotation;\n\n    masterBoardGroup.setAttribute(\n      'transform',\n      `translate(${totalX.toFixed(2)}, ${totalY.toFixed(2)}) rotate(${totalRot.toFixed(2)} 300 320)`\n    );\n\n    // Subtle secondary knee/body breathing bounce\n    const bodyBounceY = Math.sin(state.time * hoverFreq - 0.5) * 3.2;\n    capyBodyGroup.setAttribute(\n      'transform',\n      `translate(0, ${bodyBounceY.toFixed(2)}) scale(1, ${bodySquashY.toFixed(3)})`\n    );\n\n    // Subtle head counter-stabilization (Capybara keeps its head remarkably level)\n    const headPitch = -hoverPitch * 0.35 + Math.sin(state.time * hoverFreq - 0.9) * 1.4;\n    capyHeadGroup.setAttribute(\n      'transform',\n      `rotate(${headPitch.toFixed(2)} 390 165)`\n    );\n\n    // Yuzu Physics on Head\n    if (state.isJumping) {\n      const yuzuArc = -Math.sin(state.jumpProgress * Math.PI) * 38;\n      const yuzuSpin = state.jumpProgress * 360;\n      yuzuGroup.setAttribute(\n        'transform',\n        `translate(384, ${(98 + yuzuArc).toFixed(2)}) rotate(${yuzuSpin.toFixed(1)} 0 -11)`\n      );\n    } else {\n      const yuzuBob = Math.max(0, Math.sin(state.time * hoverFreq - 1.1)) * -4.5;\n      const yuzuRock = Math.cos(state.time * hoverFreq) * 4;\n      yuzuGroup.setAttribute(\n        'transform',\n        `translate(384, ${(98 + yuzuBob).toFixed(2)}) rotate(${yuzuRock.toFixed(1)} 0 -4)`\n      );\n    }\n\n    // Dynamic Wind-Blown Scarf Wave\n    const wTime = state.time * (8 + state.speed * 5);\n    const sY1 = 204 + Math.sin(wTime) * 12;\n    const sY2 = 190 + Math.cos(wTime - 1.2) * 18;\n    const sY3 = 194 + Math.sin(wTime - 2.4) * (24 * state.speed);\n    const sX3 = 52 - (state.speed - 1) * 24;\n\n    const scarfPath = `M 318,198 Q 225,${sY1.toFixed(1)} 140,${sY2.toFixed(1)} T ${sX3.toFixed(1)},${sY3.toFixed(1)}`;\n    scarfTailMain.setAttribute('d', scarfPath);\n    scarfTailStripe.setAttribute('d', scarfPath);\n    scarfTailShadow.setAttribute(\n      'd',\n      `M 318,203 Q 225,${(sY1 + 6).toFixed(1)} 140,${(sY2 + 6).toFixed(1)} T ${sX3.toFixed(1)},${(sY3 + 6).toFixed(1)}`\n    );\n\n    // Thruster Plume Pulsing\n    const thrustPulse = 0.85 + Math.sin(state.time * 28) * 0.18 + (state.speed - 1) * 0.35;\n    rearPlumeOuter.setAttribute('rx', (44 * thrustPulse).toFixed(1));\n    rearPlumeCore.setAttribute('rx', (27 * thrustPulse).toFixed(1));\n    frontPlumeOuter.setAttribute('rx', (44 * thrustPulse).toFixed(1));\n    frontPlumeCore.setAttribute('rx', (27 * thrustPulse).toFixed(1));\n\n    // Spawn Exhaust Trail Particles from Hoverboard Rear & Thrusters\n    const rigRect = masterBoardGroup.getBoundingClientRect();\n    const tailX = rigRect.left + rigRect.width * 0.19;\n    const tailY = rigRect.top + rigRect.height * 0.72;\n\n    if (Math.random() < 0.85) {\n      particles.push({\n        x: tailX + (Math.random() - 0.5) * 14,\n        y: tailY + (Math.random() - 0.5) * 12,\n        vx: -(4.5 + Math.random() * 4) * state.speed,\n        vy: (Math.random() - 0.5) * 1.4,\n        size: 6 + Math.random() * 10,\n        life: 1,\n        decay: 0.022 + Math.random() * 0.015,\n        color: Math.random() > 0.45 ? theme.accent1 : theme.accent2,\n        type: 'ring'\n      });\n    }\n\n    // Update & Render Foreground Particles\n    for (let i = particles.length - 1; i >= 0; i--) {\n      const pt = particles[i];\n      pt.x += pt.vx;\n      pt.y += pt.vy;\n      pt.life -= pt.decay;\n\n      if (pt.life <= 0) {\n        particles.splice(i, 1);\n        continue;\n      }\n\n      fgCtx.save();\n      fgCtx.globalAlpha = Math.max(0, pt.life);\n      if (pt.type === 'ring') {\n        fgCtx.strokeStyle = pt.color;\n        fgCtx.lineWidth = 2.2;\n        fgCtx.beginPath();\n        fgCtx.ellipse(\n          pt.x,\n          pt.y,\n          pt.size * (1.5 - pt.life * 0.5),\n          pt.size * 0.45 * (1.5 - pt.life * 0.5),\n          0, 0, Math.PI * 2\n        );\n        fgCtx.stroke();\n      } else {\n        fgCtx.fillStyle = pt.color;\n        fgCtx.beginPath();\n        fgCtx.arc(pt.x, pt.y, pt.size * pt.life, 0, Math.PI * 2);\n        fgCtx.fill();\n      }\n      fgCtx.restore();\n    }\n\n    // High-Speed Wind Streaks\n    fgCtx.save();\n    for (let i = 0; i < speedLines.length; i++) {\n      const sl = speedLines[i];\n      sl.x -= sl.speed * state.speed;\n      if (sl.x + sl.len < 0) {\n        sl.x = width + Math.random() * 200;\n        sl.y = Math.random() * height * 0.88;\n      }\n\n      const boostAlpha = state.isBoosting ? sl.alpha * 1.9 : sl.alpha * 0.65;\n      const grad = fgCtx.createLinearGradient(sl.x, sl.y, sl.x + sl.len * state.speed, sl.y);\n      grad.addColorStop(0, 'rgba(255, 255, 255, 0)');\n      grad.addColorStop(0.5, `rgba(0, 243, 255, ${boostAlpha.toFixed(2)})`);\n      grad.addColorStop(1, 'rgba(255, 255, 255, 0)');\n\n      fgCtx.strokeStyle = grad;\n      fgCtx.lineWidth = state.isBoosting ? 2.2 : 1.2;\n      fgCtx.beginPath();\n      fgCtx.moveTo(sl.x, sl.y);\n      fgCtx.lineTo(sl.x + sl.len * state.speed, sl.y);\n      fgCtx.stroke();\n    }\n    fgCtx.restore();\n  }\n\n  let lastTime = performance.now();\n\n  function animate(now) {\n    const dt = Math.min((now - lastTime) / 1000, 0.05);\n    lastTime = now;\n\n    state.time += dt;\n    state.scrollOffset += dt * 240 * state.speed;\n\n    const theme = themes[currentThemeIdx];\n    drawBackground(dt, theme);\n    updateAndDrawForeground(dt, theme);\n\n    requestAnimationFrame(animate);\n  }\n\n  resize();\n  initWorld();\n  requestAnimationFrame(animate);\n})();\n</script>\n</body>\n</html>"
    }
  ]
