      "role": "assistant",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Capybara on a Hoverboard</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{height:100%}\n  body{\n    display:flex;align-items:center;justify-content:center;\n    min-height:100vh;overflow:hidden;\n    background:radial-gradient(circle at 50% 28%, #1b1c38, #06060e 72%);\n    font-family:ui-sans-serif,system-ui,-apple-system,sans-serif;\n  }\n\n  /* ---------- stage ---------- */\n  .scene{\n    position:relative;\n    width:min(96vw, 1000px);\n    height:min(54vw, 562px);\n    border-radius:22px;\n    overflow:hidden;\n    isolation:isolate;\n    background:#150c29;\n    cursor:pointer;\n    user-select:none;\n    box-shadow:0 40px 90px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.07);\n  }\n  .world{\n    position:absolute;inset:0;\n    transition:transform .45s cubic-bezier(.2,.7,.3,1);\n  }\n\n  /* ---------- sky ---------- */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(180deg,\n      #0b0e2e 0%, #1e1a4e 20%, #4b2765 38%,\n      #8f3a6b 54%, #d25a55 68%, #f5994f 82%, #ffd28d 100%);\n  }\n\n  /* stars */\n  .stars{position:absolute;left:0;right:0;top:0;height:62%;pointer-events:none}\n  .stars i{\n    position:absolute;border-radius:50%;background:#fff;\n    opacity:.7;animation:twinkle 4s ease-in-out infinite;\n  }\n  @keyframes twinkle{\n    0%,100%{opacity:.12;transform:scale(.6)}\n    50%{opacity:.95;transform:scale(1.1)}\n  }\n\n  /* sun */\n  .sun{\n    position:absolute;left:15%;top:29%;width:14%;aspect-ratio:1/1;border-radius:50%;\n    background:radial-gradient(circle at 42% 38%, #fff6cf, #ffcb6d 42%, #ff8b4d 72%, rgba(255,120,80,0) 74%);\n    box-shadow:0 0 120px 34px rgba(255,145,80,.35);\n    animation:sunPulse 6s ease-in-out infinite;\n  }\n  @keyframes sunPulse{\n    0%,100%{box-shadow:0 0 110px 28px rgba(255,145,80,.30);transform:scale(1)}\n    50%{box-shadow:0 0 150px 46px rgba(255,155,90,.42);transform:scale(1.04)}\n  }\n\n  /* clouds */\n  .cloud{\n    position:absolute;left:0;border-radius:100px;\n    background:#ffd0a2;opacity:.24;filter:blur(1.6px);\n    animation:drift linear infinite;\n  }\n  .cloud::before,.cloud::after{\n    content:\"\";position:absolute;border-radius:50%;background:inherit;\n  }\n  .cloud::before{width:56%;height:180%;left:12%;top:-80%}\n  .cloud::after{width:40%;height:150%;right:9%;top:-56%}\n  @keyframes drift{\n    from{transform:translateX(-34vw)}\n    to{transform:translateX(116vw)}\n  }\n  .c1{top:9%;width:16%;height:4.4%;animation-duration:64s;animation-delay:-8s;opacity:.20}\n  .c2{top:19%;width:11%;height:3.2%;animation-duration:46s;animation-delay:-30s;opacity:.17}\n  .c3{top:31%;width:20%;height:5%;animation-duration:82s;animation-delay:-52s;opacity:.22}\n  .c4{top:5%;width:9%;height:2.6%;animation-duration:38s;animation-delay:-20s;opacity:.14}\n\n  /* ---------- landscape ---------- */\n  .hills{position:absolute;left:0;bottom:0;width:100%;height:62%;display:block}\n  .ground{\n    position:absolute;left:0;right:0;bottom:0;height:26%;overflow:hidden;\n    background:linear-gradient(#3d2354 0%, #211238 34%, #0d0619 100%);\n  }\n  .ground::before{\n    content:\"\";position:absolute;inset:0 -14% 0 -14%;\n    background-image:repeating-linear-gradient(90deg,\n      rgba(120,230,255,0) 0 46px,\n      rgba(120,230,255,.17) 46px 50px,\n      rgba(120,230,255,0) 50px 117px,\n      rgba(255,175,115,.13) 117px 120px);\n    animation:roadLine .68s linear infinite;\n    -webkit-mask-image:linear-gradient(#000, rgba(0,0,0,0) 92%);\n    mask-image:linear-gradient(#000, rgba(0,0,0,0) 92%);\n  }\n  @keyframes roadLine{to{transform:translateX(-120px)}}\n  .ground::after{\n    content:\"\";position:absolute;left:0;right:0;top:0;height:3px;\n    background:linear-gradient(90deg,transparent 4%,rgba(255,190,120,.85) 34%,rgba(150,238,255,.85) 66%,transparent 96%);\n    filter:blur(1.2px);\n    box-shadow:0 0 26px rgba(255,180,110,.55);\n  }\n\n  /* hover puddle on the road */\n  .puddle{\n    position:absolute;left:50%;bottom:5.5%;width:34%;height:8%;\n    transform:translateX(-50%);border-radius:50%;\n    background:radial-gradient(ellipse at center, rgba(120,238,255,.5), rgba(120,238,255,0) 70%);\n    filter:blur(4px);\n    animation:puddle 2.8s ease-in-out infinite;\n  }\n  @keyframes puddle{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.7}\n    50%{transform:translateX(-50%) scale(.8);opacity:1}\n  }\n\n  /* ---------- rider ---------- */\n  .rider{\n    position:absolute;left:50%;bottom:3%;width:44%;\n    transform:translate(-50%,0);\n    will-change:transform;\n    animation:bob 2.8s ease-in-out infinite;\n  }\n  @keyframes bob{\n    0%,100%{transform:translate(-50%,0) rotate(-1.5deg)}\n    50%{transform:translate(-50%,-16px) rotate(1.5deg)}\n  }\n  .capy{\n    display:block;width:100%;height:auto;overflow:visible;\n    filter:drop-shadow(0 14px 22px rgba(0,0,0,.45));\n  }\n  .scene.boost .rider{animation-duration:1.45s}\n\n  /* svg part animations */\n  .torso{\n    transform-box:fill-box;transform-origin:50% 76%;\n    animation:breathe 2.8s ease-in-out infinite;\n  }\n  @keyframes breathe{\n    0%,100%{transform:scale(1,1)}\n    50%{transform:scale(1.016,.978)}\n  }\n  .head{\n    transform-box:fill-box;transform-origin:24% 86%;\n    animation:headBob 3.5s ease-in-out infinite;\n  }\n  @keyframes headBob{\n    0%,100%{transform:rotate(-1.8deg) translateY(0)}\n    50%{transform:rotate(1.8deg) translateY(-3px)}\n  }\n  .eye{\n    transform-box:fill-box;transform-origin:50% 50%;\n    animation:blink 5.4s ease-in-out infinite;\n  }\n  @keyframes blink{\n    0%,89%,100%{transform:scaleY(1)}\n    92%{transform:scaleY(.06)}\n    95%{transform:scaleY(1)}\n  }\n  .ear{\n    transform-box:fill-box;transform-origin:62% 88%;\n    animation:earTwitch 4.6s ease-in-out infinite;\n  }\n  @keyframes earTwitch{\n    0%,64%,100%{transform:rotate(0deg)}\n    71%{transform:rotate(-11deg)}\n    79%{transform:rotate(5deg)}\n  }\n  .scarfTails{\n    transform-box:fill-box;transform-origin:98% 26%;\n    animation:wave 1.15s ease-in-out infinite;\n  }\n  @keyframes wave{\n    0%,100%{transform:rotate(-3deg) scaleY(1)}\n    50%{transform:rotate(9deg) scaleY(.9)}\n  }\n  .flame{\n    transform-box:fill-box;transform-origin:50% 0%;\n    animation:flicker .15s steps(2,end) infinite alternate;\n  }\n  .f1{animation-delay:-.04s}\n  .f2{animation-delay:-.11s}\n  @keyframes flicker{\n    from{transform:scaleY(.9) scaleX(1.05);opacity:.8}\n    to{transform:scaleY(1.5) scaleX(.82);opacity:1}\n  }\n  .boardGlow{\n    transform-box:fill-box;transform-origin:50% 50%;\n    animation:glowPulse 1.9s ease-in-out infinite;\n  }\n  @keyframes glowPulse{\n    0%,100%{opacity:.6;transform:scale(1)}\n    50%{opacity:1;transform:scale(1.09)}\n  }\n\n  /* ---------- particles ---------- */\n  .fx{position:absolute;inset:0;overflow:hidden;pointer-events:none}\n  .fx i{position:absolute;display:block;border-radius:99px}\n  .fx i.streak{\n    right:-12%;\n    background:linear-gradient(90deg, rgba(190,245,255,0), rgba(200,248,255,.85) 65%, #ffffff);\n    animation:streak linear forwards;\n  }\n  @keyframes streak{\n    0%{transform:translateX(0);opacity:0}\n    14%{opacity:var(--o,.55)}\n    100%{transform:translateX(var(--dx));opacity:0}\n  }\n  .fx i.spark{\n    background:radial-gradient(circle at 35% 35%, #ffffff, #7ee9ff 45%, rgba(90,200,255,0) 72%);\n    animation:spark ease-out forwards;\n  }\n  @keyframes spark{\n    0%{transform:translate(0,0) scale(1);opacity:1}\n    100%{transform:translate(var(--dx), var(--dy)) scale(.15);opacity:0}\n  }\n\n  /* vignette */\n  .vignette{\n    position:absolute;inset:0;pointer-events:none;\n    background:radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0) 48%, rgba(6,4,14,.72) 100%);\n  }\n\n  @media (max-width:520px){\n    .rider{width:52%}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"scene\" id=\"scene\">\n  <div class=\"world\" id=\"world\">\n\n    <div class=\"sky\"></div>\n    <div class=\"stars\" id=\"stars\"></div>\n    <div class=\"sun\"></div>\n\n    <div class=\"cloud c1\"></div>\n    <div class=\"cloud c2\"></div>\n    <div class=\"cloud c3\"></div>\n    <div class=\"cloud c4\"></div>\n\n    <svg class=\"hills\" viewBox=\"0 0 1000 300\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n      <path d=\"M0 196 L118 92 L198 152 L302 58 L420 176 L522 108 L642 192 L762 98 L882 168 L1000 118 L1000 300 L0 300 Z\"\n            fill=\"#4a2b5f\" opacity=\".85\"/>\n      <path d=\"M0 234 L92 162 L190 224 L312 142 L432 228 L560 156 L690 232 L822 166 L922 226 L1000 186 L1000 300 L0 300 Z\"\n            fill=\"#2b1740\"/>\n    </svg>\n\n    <div class=\"ground\"></div>\n    <div class=\"puddle\"></div>\n\n    <div class=\"rider\">\n      <svg class=\"capy\" viewBox=\"0 0 360 280\" xmlns=\"http://www.w3.org/2000/svg\"\n           role=\"img\" aria-label=\"An animated capybara riding a glowing hoverboard\">\n        <defs>\n          <linearGradient id=\"furBody\" x1=\"0.25\" y1=\"0\" x2=\"0.65\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#d8a668\"/>\n            <stop offset=\"0.5\" stop-color=\"#b17b3e\"/>\n            <stop offset=\"1\" stop-color=\"#8a5a29\"/>\n          </linearGradient>\n          <linearGradient id=\"furHead\" x1=\"0.2\" y1=\"0\" x2=\"0.7\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#deae71\"/>\n            <stop offset=\"0.6\" stop-color=\"#bc8648\"/>\n            <stop offset=\"1\" stop-color=\"#9a6a34\"/>\n          </linearGradient>\n          <linearGradient id=\"legLight\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#c48e4d\"/>\n            <stop offset=\"1\" stop-color=\"#9a6a34\"/>\n          </linearGradient>\n          <linearGradient id=\"deckGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#96f8ff\"/>\n            <stop offset=\"0.35\" stop-color=\"#2ab6dd\"/>\n            <stop offset=\"1\" stop-color=\"#0b4463\"/>\n          </linearGradient>\n          <radialGradient id=\"glowGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"0\" stop-color=\"#9df4ff\" stop-opacity=\"0.8\"/>\n            <stop offset=\"0.55\" stop-color=\"#4fd8ff\" stop-opacity=\"0.28\"/>\n            <stop offset=\"1\" stop-color=\"#4fd8ff\" stop-opacity=\"0\"/>\n          </radialGradient>\n          <radialGradient id=\"flameGrad\" cx=\"50%\" cy=\"18%\" r=\"72%\">\n            <stop offset=\"0\" stop-color=\"#ffffff\" stop-opacity=\"0.95\"/>\n            <stop offset=\"0.34\" stop-color=\"#8df2ff\" stop-opacity=\"0.8\"/>\n            <stop offset=\"1\" stop-color=\"#2aa8ff\" stop-opacity=\"0\"/>\n          </radialGradient>\n        </defs>\n\n        <!-- hoverboard -->\n        <g class=\"board\">\n          <ellipse class=\"boardGlow\" cx=\"180\" cy=\"244\" rx=\"152\" ry=\"30\" fill=\"url(#glowGrad)\"/>\n          <ellipse cx=\"98\" cy=\"248\" rx=\"30\" ry=\"11\" fill=\"#0b2c44\"/>\n          <ellipse cx=\"262\" cy=\"248\" rx=\"30\" ry=\"11\" fill=\"#0b2c44\"/>\n          <ellipse class=\"flame f1\" cx=\"98\" cy=\"264\" rx=\"25\" ry=\"15\" fill=\"url(#flameGrad)\"/>\n          <ellipse class=\"flame f2\" cx=\"262\" cy=\"264\" rx=\"25\" ry=\"15\" fill=\"url(#flameGrad)\"/>\n          <rect x=\"34\" y=\"220\" width=\"292\" height=\"24\" rx=\"12\" fill=\"url(#deckGrad)\"/>\n          <rect x=\"42\" y=\"223\" width=\"276\" height=\"7\" rx=\"3.5\" fill=\"#cdfbff\" opacity=\"0.6\"/>\n          <rect x=\"46\" y=\"237\" width=\"268\" height=\"7\" rx=\"3.5\" fill=\"#041826\" opacity=\"0.5\"/>\n          <circle cx=\"180\" cy=\"231\" r=\"4.2\" fill=\"#e6ffff\" opacity=\"0.9\"/>\n        </g>\n\n        <!-- far legs -->\n        <g fill=\"#7a5024\">\n          <rect x=\"92\" y=\"166\" width=\"28\" height=\"56\" rx=\"14\"/>\n          <rect x=\"210\" y=\"166\" width=\"28\" height=\"56\" rx=\"14\"/>\n        </g>\n        <g fill=\"#5f3c18\">\n          <rect x=\"92\" y=\"206\" width=\"28\" height=\"16\" rx=\"8\"/>\n          <rect x=\"210\" y=\"206\" width=\"28\" height=\"16\" rx=\"8\"/>\n        </g>\n\n        <!-- torso -->\n        <g class=\"torso\">\n          <ellipse cx=\"170\" cy=\"150\" rx=\"92\" ry=\"56\" fill=\"url(#furBody)\"/>\n          <ellipse cx=\"176\" cy=\"184\" rx=\"66\" ry=\"24\" fill=\"#eac795\" opacity=\"0.22\"/>\n          <ellipse cx=\"118\" cy=\"152\" rx=\"46\" ry=\"44\" fill=\"#8a5a29\" opacity=\"0.16\"/>\n        </g>\n\n        <!-- near legs -->\n        <g>\n          <rect x=\"128\" y=\"172\" width=\"30\" height=\"50\" rx=\"15\" fill=\"url(#legLight)\"/>\n          <rect x=\"236\" y=\"172\" width=\"30\" height=\"50\" rx=\"15\" fill=\"url(#legLight)\"/>\n          <rect x=\"128\" y=\"206\" width=\"30\" height=\"16\" rx=\"8\" fill=\"#6b4520\"/>\n          <rect x=\"236\" y=\"206\" width=\"30\" height=\"16\" rx=\"8\" fill=\"#6b4520\"/>\n        </g>\n\n        <!-- head -->\n        <g class=\"head\">\n          <g transform=\"rotate(-6 259 107)\">\n            <rect x=\"212\" y=\"68\" width=\"96\" height=\"80\" rx=\"34\" fill=\"url(#furHead)\"/>\n            <ellipse cx=\"296\" cy=\"118\" rx=\"26\" ry=\"23\" fill=\"#e4c294\"/>\n            <ellipse cx=\"316\" cy=\"105\" rx=\"8\" ry=\"6\" fill=\"#4a2e14\" transform=\"rotate(-14 316 105)\"/>\n            <path d=\"M303 128 q9 6 17 0\" stroke=\"#6b4520\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n            <g stroke=\"#f0dcbb\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\"0.7\">\n              <path d=\"M318 117 l23 5\"/>\n              <path d=\"M318 124 l20 13\"/>\n            </g>\n            <g class=\"eye\">\n              <circle cx=\"274\" cy=\"96\" r=\"7\" fill=\"#2a1a0c\"/>\n              <circle cx=\"276.5\" cy=\"93.5\" r=\"2.4\" fill=\"#ffffff\"/>\n            </g>\n            <path d=\"M261 83 q14 -7 26 -1\" stroke=\"#8a5a29\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" opacity=\"0.8\"/>\n            <g class=\"ear\">\n              <ellipse cx=\"240\" cy=\"72\" rx=\"15\" ry=\"13\" fill=\"#a9743f\" transform=\"rotate(-24 240 72)\"/>\n              <ellipse cx=\"241\" cy=\"73\" rx=\"8\" ry=\"6.5\" fill=\"#8a5a29\" transform=\"rotate(-24 241 73)\"/>\n            </g>\n          </g>\n        </g>\n\n        <!-- scarf -->\n        <g class=\"scarf\">\n          <g class=\"scarfTails\">\n            <path d=\"M214 138 C 188 138, 164 147, 148 165 C 166 167, 186 157, 206 148 Z\" fill=\"#d9413a\"/>\n            <path d=\"M212 147 C 190 153, 170 169, 160 189 C 176 184, 192 170, 206 158 Z\" fill=\"#ef5a4e\"/>\n          </g>\n          <path d=\"M194 142 C 214 124, 242 122, 256 138\" stroke=\"#e0473f\" stroke-width=\"21\" fill=\"none\" stroke-linecap=\"round\"/>\n          <path d=\"M194 142 C 214 124, 242 122, 256 138\" stroke=\"#ff8375\" stroke-width=\"8\" fill=\"none\" stroke-linecap=\"round\" opacity=\"0.45\"/>\n        </g>\n      </svg>\n    </div>\n\n    <div class=\"fx\" id=\"fx\"></div>\n    <div class=\"vignette\"></div>\n  </div>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var scene = document.getElementById(\"scene\");\n  var world = document.getElementById(\"world\");\n  var starBox = document.getElementById(\"stars\");\n  var fx = document.getElementById(\"fx\");\n\n  function rnd(a, b) { return a + Math.random() * (b - a); }\n\n  /* ---- starfield ---- */\n  (function makeStars() {\n    var frag = document.createDocumentFragment();\n    for (var i = 0; i < 78; i++) {\n      var s = document.createElement(\"i\");\n      var size = rnd(0.8, 2.4).toFixed(2);\n      s.style.left = rnd(0, 100).toFixed(2) + \"%\";\n      s.style.top = rnd(0, 56).toFixed(2) + \"%\";\n      s.style.width = size + \"px\";\n      s.style.height = size + \"px\";\n      s.style.animationDelay = (-rnd(0, 5)).toFixed(2) + \"s\";\n      s.style.animationDuration = rnd(2.4, 5.5).toFixed(2) + \"s\";\n      frag.appendChild(s);\n    }\n    starBox.appendChild(frag);\n  })();\n\n  /* ---- speed streaks ---- */\n  function makeStreak() {\n    var el = document.createElement(\"i\");\n    el.className = \"streak\";\n    el.style.top = rnd(14, 80).toFixed(1) + \"%\";\n    el.style.width = rnd(28, 120).toFixed(0) + \"px\";\n    el.style.height = rnd(1.4, 3).toFixed(1) + \"px\";\n    el.style.setProperty(\"--o\", rnd(0.2, 0.7).toFixed(2));\n    el.style.setProperty(\"--dx\", (-scene.clientWidth * rnd(1.05, 1.4)).toFixed(0) + \"px\");\n    el.style.animationDuration = rnd(0.42, 1.05).toFixed(2) + \"s\";\n    fx.appendChild(el);\n    el.addEventListener(\"animationend\", function () { el.remove(); });\n  }\n\n  /* ---- hoverboard sparks ---- */\n  function makeSpark() {\n    var el = document.createElement(\"i\");\n    el.className = \"spark\";\n    var side = Math.random() < 0.5 ? 40 : 60;\n    el.style.left = (side + rnd(-6, 6)).toFixed(1) + \"%\";\n    el.style.top = rnd(81, 88).toFixed(1) + \"%\";\n    var size = rnd(2.5, 6).toFixed(1);\n    el.style.width = size + \"px\";\n    el.style.height = size + \"px\";\n    el.style.setProperty(\"--dx\", rnd(-190, -40).toFixed(0) + \"px\");\n    el.style.setProperty(\"--dy\", rnd(30, 150).toFixed(0) + \"px\");\n    el.style.animationDuration = rnd(0.5, 1.15).toFixed(2) + \"s\";\n    fx.appendChild(el);\n    el.addEventListener(\"animationend\", function () { el.remove(); });\n  }\n\n  var streakTimer = setInterval(function () {\n    makeStreak();\n    if (scene.classList.contains(\"boost\")) { makeStreak(); makeStreak(); }\n  }, 105);\n\n  var sparkTimer = setInterval(function () {\n    makeSpark();\n    if (Math.random() < 0.45) { makeSpark(); }\n  }, 85);\n\n  /* ---- boost on tap / click ---- */\n  var boostTimeout = null;\n  scene.addEventListener(\"pointerdown\", function () {\n    scene.classList.add(\"boost\");\n    for (var i = 0; i < 22; i++) {\n      (function (n) { setTimeout(makeSpark, n * 14); })(i);\n    }\n    clearTimeout(boostTimeout);\n    boostTimeout = setTimeout(function () {\n      scene.classList.remove(\"boost\");\n    }, 1500);\n  });\n\n  /* ---- gentle pointer parallax ---- */\n  var raf = null;\n  scene.addEventListener(\"pointermove\", function (e) {\n    var r = scene.getBoundingClientRect();\n    var nx = (e.clientX - r.left) / r.width - 0.5;\n    var ny = (e.clientY - r.top) / r.height - 0.5;\n    if (raf) return;\n    raf = requestAnimationFrame(function () {\n      raf = null;\n      world.style.transform =\n        \"translate(\" + (nx * 14).toFixed(2) + \"px,\" + (ny * 9).toFixed(2) + \"px)\";\n    });\n  });\n  scene.addEventListener(\"pointerleave\", function () {\n    world.style.transform = \"translate(0,0)\";\n  });\n\n  void streakTimer; void sparkTimer;\n})();\n</script>\n</body>\n</html>"
    }
