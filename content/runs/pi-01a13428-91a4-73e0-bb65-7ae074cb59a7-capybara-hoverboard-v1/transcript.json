    {
      "role": "assistant",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Capybara on a Hoverboard</title>\n<style>\n  :root{\n    --cyan:#5ff2ff;\n    --magenta:#ff6ad5;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;height:100%;}\n  body{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    min-height:100%;\n    background:radial-gradient(circle at 50% 20%, #16233f 0%, #0a0f1c 55%, #05070d 100%);\n    padding:18px;\n    font-family:system-ui, sans-serif;\n  }\n  .scene{\n    position:relative;\n    width:100%;\n    max-width:1000px;\n    aspect-ratio:8 / 5;\n    border-radius:20px;\n    overflow:hidden;\n    background:#0a1424;\n    box-shadow:0 30px 70px -20px rgba(0,0,0,.9), 0 0 0 1px rgba(120,220,255,.18), 0 0 60px -10px rgba(95,242,255,.25);\n  }\n  .art,.fx{\n    position:absolute;\n    inset:0;\n    width:100%;\n    height:100%;\n    display:block;\n  }\n  .fx{pointer-events:none;}\n  .vignette{\n    position:absolute;\n    inset:0;\n    pointer-events:none;\n    background:radial-gradient(120% 90% at 50% 45%, rgba(0,0,0,0) 45%, rgba(0,0,0,.55) 100%);\n    mix-blend-mode:multiply;\n  }\n\n  /* ---------- scene animations ---------- */\n  @keyframes drift{\n    from{ transform:translateX(-260px); }\n    to{ transform:translateX(980px); }\n  }\n  .cloud{ animation:drift linear infinite; opacity:.85; }\n  .c1{ animation-duration:44s; animation-delay:-6s; }\n  .c2{ animation-duration:64s; animation-delay:-30s; }\n  .c3{ animation-duration:84s; animation-delay:-52s; }\n\n  @keyframes twinkle{\n    0%,100%{ opacity:.15; }\n    50%{ opacity:.9; }\n  }\n  .star{ animation:twinkle 3.4s ease-in-out infinite; }\n  .s2{ animation-duration:4.6s; animation-delay:-1.2s; }\n  .s3{ animation-duration:5.8s; animation-delay:-2.5s; }\n  .s4{ animation-duration:4.1s; animation-delay:-3.1s; }\n\n  @keyframes sunPulse{\n    0%,100%{ opacity:.55; transform:scale(1); }\n    50%{ opacity:.9; transform:scale(1.06); }\n  }\n  .sunGlow{ transform-box:fill-box; transform-origin:50% 50%; animation:sunPulse 6s ease-in-out infinite; }\n\n  @keyframes gridMove{\n    from{ transform:translateY(0); }\n    to{ transform:translateY(22px); }\n  }\n  .gridLines{ animation:gridMove 1.6s linear infinite; opacity:.5; }\n\n  /* ---------- rider ---------- */\n  @keyframes float{\n    0%,100%{ transform:translateY(-6px) rotate(-1.1deg); }\n    50%    { transform:translateY(6px)  rotate(1.1deg); }\n  }\n  .craft{\n    transform-box:fill-box;\n    transform-origin:50% 80%;\n    animation:float 2.6s ease-in-out infinite;\n  }\n  @keyframes legSway{\n    0%,100%{ transform:rotate(4deg); }\n    50%    { transform:rotate(-4deg); }\n  }\n  .leg{\n    transform-box:fill-box;\n    transform-origin:50% 6%;\n    animation:legSway 1.3s ease-in-out infinite;\n  }\n  .leg.l2{ animation-delay:-.32s; }\n  .leg.l3{ animation-delay:-.65s; }\n  .leg.l4{ animation-delay:-.98s; }\n\n  @keyframes headBob{\n    0%,100%{ transform:rotate(-2deg) translateY(0); }\n    50%    { transform:rotate(2deg)  translateY(-3px); }\n  }\n  .head{\n    transform-box:fill-box;\n    transform-origin:18% 78%;\n    animation:headBob 2.6s ease-in-out infinite;\n  }\n  @keyframes earTwitch{\n    0%,84%,100%{ transform:rotate(0deg); }\n    88%{ transform:rotate(-16deg); }\n    92%{ transform:rotate(7deg); }\n    96%{ transform:rotate(-4deg); }\n  }\n  .ear{\n    transform-box:fill-box;\n    transform-origin:65% 92%;\n    animation:earTwitch 4.2s ease-in-out infinite;\n  }\n  @keyframes blink{\n    0%,92%,100%{ transform:scaleY(1); }\n    95%{ transform:scaleY(.06); }\n    98%{ transform:scaleY(1); }\n  }\n  .eye{\n    transform-box:fill-box;\n    transform-origin:50% 50%;\n    animation:blink 5.4s infinite;\n  }\n  @keyframes glowPulse{\n    0%,100%{ opacity:.55; }\n    50%    { opacity:1; }\n  }\n  .hoverGlow{ animation:glowPulse 2.6s ease-in-out infinite; }\n  .thruster{ animation:glowPulse 1.1s ease-in-out infinite; }\n  .thruster.t2{ animation-delay:-.55s; }\n  @keyframes flame{\n    0%,100%{ transform:scaleY(.75); opacity:.65; }\n    50%    { transform:scaleY(1.15); opacity:1; }\n  }\n  .flame{\n    transform-box:fill-box;\n    transform-origin:50% 0%;\n    animation:flame .55s ease-in-out infinite;\n  }\n  .flame.f2{ animation-delay:-.28s; }\n\n  /* subtle motion streaks */\n  @keyframes streak{\n    0%{ transform:translateX(140px); opacity:0; }\n    15%{ opacity:.9; }\n    100%{ transform:translateX(-460px); opacity:0; }\n  }\n  .streak{ animation:streak linear infinite; }\n  .st1{ animation-duration:1.5s; animation-delay:-.2s; }\n  .st2{ animation-duration:1.9s; animation-delay:-1.1s; }\n  .st3{ animation-duration:1.2s; animation-delay:-.7s; }\n\n  @media (prefers-reduced-motion: reduce){\n    *{ animation-duration:.001s !important; animation-iteration-count:1 !important; }\n  }\n</style>\n</head>\n<body>\n<div class=\"scene\" id=\"scene\">\n  <svg class=\"art\" viewBox=\"0 0 800 500\" preserveAspectRatio=\"xMidYMid meet\" aria-label=\"Animated capybara riding a neon hoverboard\">\n    <defs>\n      <linearGradient id=\"skyGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\"  stop-color=\"#111b3d\"/>\n        <stop offset=\"38%\" stop-color=\"#33406e\"/>\n        <stop offset=\"66%\" stop-color=\"#7d5a93\"/>\n        <stop offset=\"84%\" stop-color=\"#e2815f\"/>\n        <stop offset=\"100%\" stop-color=\"#ffb46b\"/>\n      </linearGradient>\n      <radialGradient id=\"sunGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n        <stop offset=\"0%\"  stop-color=\"#fff6d8\"/>\n        <stop offset=\"45%\" stop-color=\"#ffd07a\"/>\n        <stop offset=\"100%\" stop-color=\"#ff7a59\"/>\n      </radialGradient>\n      <radialGradient id=\"sunGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n        <stop offset=\"0%\"   stop-color=\"#ffb066\" stop-opacity=\".75\"/>\n        <stop offset=\"55%\"  stop-color=\"#ff7a59\" stop-opacity=\".28\"/>\n        <stop offset=\"100%\" stop-color=\"#ff7a59\" stop-opacity=\"0\"/>\n      </radialGradient>\n      <linearGradient id=\"hillFar\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\"  stop-color=\"#4d3f74\"/>\n        <stop offset=\"100%\" stop-color=\"#2c2547\"/>\n      </linearGradient>\n      <linearGradient id=\"hillNear\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\"  stop-color=\"#25315a\"/>\n        <stop offset=\"100%\" stop-color=\"#141b33\"/>\n      </linearGradient>\n      <linearGradient id=\"groundGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\"  stop-color=\"#0d1830\"/>\n        <stop offset=\"100%\" stop-color=\"#060a16\"/>\n      </linearGradient>\n      <linearGradient id=\"deckGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0%\"   stop-color=\"#123a4d\"/>\n        <stop offset=\"30%\"  stop-color=\"#1f7f95\"/>\n        <stop offset=\"50%\"  stop-color=\"#7ff4ff\"/>\n        <stop offset=\"70%\"  stop-color=\"#1f7f95\"/>\n        <stop offset=\"100%\" stop-color=\"#123a4d\"/>\n      </linearGradient>\n      <linearGradient id=\"bodyGrad\" x1=\"0.2\" y1=\"0\" x2=\"0.8\" y2=\"1\">\n        <stop offset=\"0%\"   stop-color=\"#b98053\"/>\n        <stop offset=\"55%\"  stop-color=\"#9a6338\"/>\n        <stop offset=\"100%\" stop-color=\"#673f22\"/>\n      </linearGradient>\n      <radialGradient id=\"boardGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n        <stop offset=\"0%\"   stop-color=\"#7ff4ff\" stop-opacity=\".85\"/>\n        <stop offset=\"45%\"  stop-color=\"#2fd0ff\" stop-opacity=\".35\"/>\n        <stop offset=\"100%\" stop-color=\"#2fd0ff\" stop-opacity=\"0\"/>\n      </radialGradient>\n      <radialGradient id=\"thrusterGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n        <stop offset=\"0%\"   stop-color=\"#ffffff\" stop-opacity=\".95\"/>\n        <stop offset=\"40%\"  stop-color=\"#5ff2ff\" stop-opacity=\".6\"/>\n        <stop offset=\"100%\" stop-color=\"#ff6ad5\" stop-opacity=\"0\"/>\n      </radialGradient>\n      <linearGradient id=\"flameGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\"   stop-color=\"#ffffff\" stop-opacity=\".95\"/>\n        <stop offset=\"45%\"  stop-color=\"#5ff2ff\" stop-opacity=\".7\"/>\n        <stop offset=\"100%\" stop-color=\"#ff6ad5\" stop-opacity=\"0\"/>\n      </linearGradient>\n      <filter id=\"softGlow\" x=\"-80%\" y=\"-80%\" width=\"260%\" height=\"260%\">\n        <feGaussianBlur stdDeviation=\"6\" result=\"b\"/>\n        <feMerge>\n          <feMergeNode in=\"b\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n      <filter id=\"bigBlur\" x=\"-100%\" y=\"-100%\" width=\"300%\" height=\"300%\">\n        <feGaussianBlur stdDeviation=\"12\"/>\n      </filter>\n    </defs>\n\n    <!-- sky -->\n    <rect x=\"0\" y=\"0\" width=\"800\" height=\"500\" fill=\"url(#skyGrad)\"/>\n\n    <!-- stars -->\n    <circle class=\"star\"    cx=\"90\"  cy=\"60\"  r=\"1.8\" fill=\"#eaf6ff\"/>\n    <circle class=\"star s2\" cx=\"180\" cy=\"110\" r=\"1.4\" fill=\"#eaf6ff\"/>\n    <circle class=\"star s3\" cx=\"300\" cy=\"46\"  r=\"1.6\" fill=\"#eaf6ff\"/>\n    <circle class=\"star s4\" cx=\"430\" cy=\"92\"  r=\"1.3\" fill=\"#eaf6ff\"/>\n    <circle class=\"star s2\" cx=\"520\" cy=\"40\"  r=\"1.7\" fill=\"#eaf6ff\"/>\n    <circle class=\"star s3\" cx=\"700\" cy=\"70\"  r=\"1.5\" fill=\"#eaf6ff\"/>\n    <circle class=\"star\"    cx=\"760\" cy=\"140\" r=\"1.2\" fill=\"#eaf6ff\"/>\n    <circle class=\"star s4\" cx=\"250\" cy=\"160\" r=\"1.1\" fill=\"#eaf6ff\"/>\n\n    <!-- sun -->\n    <circle class=\"sunGlow\" cx=\"628\" cy=\"150\" r=\"120\" fill=\"url(#sunGlow)\"/>\n    <circle cx=\"628\" cy=\"150\" r=\"46\" fill=\"url(#sunGrad)\"/>\n\n    <!-- clouds -->\n    <g class=\"cloud c1\" opacity=\".38\" fill=\"#ffd9c0\">\n      <ellipse cx=\"140\" cy=\"120\" rx=\"52\" ry=\"18\"/>\n      <ellipse cx=\"180\" cy=\"108\" rx=\"38\" ry=\"20\"/>\n      <ellipse cx=\"106\" cy=\"112\" rx=\"30\" ry=\"14\"/>\n    </g>\n    <g class=\"cloud c2\" opacity=\".28\" fill=\"#ffc9d8\">\n      <ellipse cx=\"360\" cy=\"82\" rx=\"66\" ry=\"20\"/>\n      <ellipse cx=\"410\" cy=\"70\" rx=\"44\" ry=\"22\"/>\n      <ellipse cx=\"316\" cy=\"74\" rx=\"34\" ry=\"15\"/>\n    </g>\n    <g class=\"cloud c3\" opacity=\".22\" fill=\"#c9dcff\">\n      <ellipse cx=\"560\" cy=\"200\" rx=\"80\" ry=\"20\"/>\n      <ellipse cx=\"620\" cy=\"188\" rx=\"50\" ry=\"20\"/>\n      <ellipse cx=\"506\" cy=\"192\" rx=\"38\" ry=\"14\"/>\n    </g>\n\n    <!-- far hills -->\n    <path d=\"M0 400 L0 296 L88 214 L176 300 L262 232 L360 318 L470 208 L560 298 L662 236 L758 306 L800 274 L800 430 L0 430 Z\"\n          fill=\"url(#hillFar)\" opacity=\".9\"/>\n    <!-- near hills -->\n    <path d=\"M0 420 C110 356 230 404 348 380 C470 356 610 344 800 402 L800 470 L0 470 Z\"\n          fill=\"url(#hillNear)\"/>\n\n    <!-- ground -->\n    <rect x=\"0\" y=\"420\" width=\"800\" height=\"80\" fill=\"url(#groundGrad)\"/>\n\n    <!-- synthwave grid -->\n    <g class=\"gridLines\">\n      <line x1=\"0\" y1=\"432\" x2=\"800\" y2=\"432\" stroke=\"#2fd0ff\" stroke-opacity=\".10\" stroke-width=\"1\"/>\n      <line x1=\"0\" y1=\"448\" x2=\"800\" y2=\"448\" stroke=\"#2fd0ff\" stroke-opacity=\".16\" stroke-width=\"1.2\"/>\n      <line x1=\"0\" y1=\"468\" x2=\"800\" y2=\"468\" stroke=\"#2fd0ff\" stroke-opacity=\".22\" stroke-width=\"1.4\"/>\n      <line x1=\"0\" y1=\"492\" x2=\"800\" y2=\"492\" stroke=\"#2fd0ff\" stroke-opacity=\".28\" stroke-width=\"1.6\"/>\n      <line x1=\"0\" y1=\"518\" x2=\"800\" y2=\"518\" stroke=\"#2fd0ff\" stroke-opacity=\".34\" stroke-width=\"1.8\"/>\n      <line x1=\"0\" y1=\"546\" x2=\"800\" y2=\"546\" stroke=\"#2fd0ff\" stroke-opacity=\".4\"  stroke-width=\"2\"/>\n    </g>\n    <g stroke=\"#5ff2ff\" stroke-opacity=\".18\" stroke-width=\"1\">\n      <line x1=\"0\"   y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"100\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"200\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"300\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"500\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"600\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"700\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n      <line x1=\"800\" y1=\"500\" x2=\"400\" y2=\"420\"/>\n    </g>\n\n    <!-- motion streaks -->\n    <g fill=\"#bfefff\">\n      <rect class=\"streak st1\" x=\"620\" y=\"250\" width=\"70\" height=\"2.5\" rx=\"1.25\" opacity=\".5\"/>\n      <rect class=\"streak st2\" x=\"700\" y=\"320\" width=\"110\" height=\"2\"   rx=\"1\"    opacity=\".35\"/>\n      <rect class=\"streak st3\" x=\"560\" y=\"360\" width=\"60\"  height=\"2.5\" rx=\"1.25\" opacity=\".4\"/>\n    </g>\n\n    <!-- ground reflection pool -->\n    <ellipse cx=\"400\" cy=\"424\" rx=\"150\" ry=\"14\" fill=\"url(#boardGlow)\" opacity=\".55\" filter=\"url(#bigBlur)\"/>\n\n    <!-- ================= THE CRAFT ================= -->\n    <g class=\"craft\">\n\n      <!-- under-board glow -->\n      <ellipse class=\"hoverGlow\" cx=\"400\" cy=\"420\" rx=\"155\" ry=\"26\" fill=\"url(#boardGlow)\"/>\n\n      <!-- board flames / exhaust -->\n      <g fill=\"url(#flameGrad)\">\n        <ellipse class=\"flame\"    cx=\"322\" cy=\"428\" rx=\"16\" ry=\"26\"/>\n        <ellipse class=\"flame f2\" cx=\"478\" cy=\"428\" rx=\"16\" ry=\"26\"/>\n        <ellipse class=\"flame\"    cx=\"400\" cy=\"424\" rx=\"22\" ry=\"18\" opacity=\".5\"/>\n      </g>\n\n      <!-- board deck -->\n      <rect x=\"268\" y=\"392\" width=\"264\" height=\"22\" rx=\"11\" fill=\"url(#deckGrad)\"/>\n      <rect x=\"276\" y=\"394\" width=\"248\" height=\"5\" rx=\"2.5\" fill=\"#ffffff\" opacity=\".35\"/>\n      <rect x=\"300\" y=\"409\" width=\"200\" height=\"3\" rx=\"1.5\" fill=\"#7ff4ff\" opacity=\".55\"/>\n      <rect x=\"306\" y=\"404\" width=\"24\" height=\"6\" rx=\"3\" fill=\"#ff6ad5\" opacity=\".85\"/>\n      <rect x=\"470\" y=\"404\" width=\"24\" height=\"6\" rx=\"3\" fill=\"#ff6ad5\" opacity=\".85\"/>\n      <rect x=\"380\" y=\"404\" width=\"40\" height=\"6\" rx=\"3\" fill=\"#eafcff\" opacity=\".8\"/>\n      <path d=\"M268 413 Q400 424 532 413 L532 414 Q400 426 268 414 Z\" fill=\"#0a2733\" opacity=\".8\"/>\n\n      <!-- thruster pods -->\n      <ellipse class=\"thruster\"    cx=\"322\" cy=\"414\" rx=\"30\" ry=\"15\" fill=\"url(#thrusterGlow)\" filter=\"url(#softGlow)\"/>\n      <ellipse class=\"thruster t2\" cx=\"478\" cy=\"414\" rx=\"30\" ry=\"15\" fill=\"url(#thrusterGlow)\" filter=\"url(#softGlow)\"/>\n      <ellipse cx=\"322\" cy=\"414\" rx=\"11\" ry=\"7\" fill=\"#0b2a3a\" stroke=\"#5ff2ff\" stroke-width=\"2\"/>\n      <ellipse cx=\"478\" cy=\"414\" rx=\"11\" ry=\"7\" fill=\"#0b2a3a\" stroke=\"#5ff2ff\" stroke-width=\"2\"/>\n\n      <!-- far legs -->\n      <g fill=\"#6b4227\">\n        <rect class=\"leg l1\" x=\"332\" y=\"338\" width=\"24\" height=\"58\" rx=\"12\"/>\n        <rect class=\"leg l2\" x=\"430\" y=\"338\" width=\"24\" height=\"58\" rx=\"12\"/>\n      </g>\n      <ellipse cx=\"344\" cy=\"394\" rx=\"15\" ry=\"7\" fill=\"#4f2f18\"/>\n      <ellipse cx=\"442\" cy=\"394\" rx=\"15\" ry=\"7\" fill=\"#4f2f18\"/>\n\n      <!-- body -->\n      <ellipse cx=\"400\" cy=\"303\" rx=\"120\" ry=\"70\" fill=\"url(#bodyGrad)\"/>\n      <ellipse cx=\"398\" cy=\"330\" rx=\"88\" ry=\"40\" fill=\"#d3a276\" opacity=\".45\"/>\n      <ellipse cx=\"388\" cy=\"268\" rx=\"92\" ry=\"34\" fill=\"#c58e60\" opacity=\".35\"/>\n      <path d=\"M300 320 q-16 10 -6 22 q10 10 22 2\" fill=\"none\" stroke=\"#5c3a1f\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\".5\"/>\n      <circle cx=\"286\" cy=\"300\" r=\"9\" fill=\"#7d4f31\"/>\n\n      <!-- near legs -->\n      <g fill=\"#855536\">\n        <rect class=\"leg l3\" x=\"360\" y=\"336\" width=\"25\" height=\"60\" rx=\"12.5\"/>\n        <rect class=\"leg l4\" x=\"458\" y=\"336\" width=\"25\" height=\"60\" rx=\"12.5\"/>\n      </g>\n      <ellipse cx=\"372\" cy=\"394\" rx=\"16\" ry=\"7.5\" fill=\"#5f3a1f\"/>\n      <ellipse cx=\"470\" cy=\"394\" rx=\"16\" ry=\"7.5\" fill=\"#5f3a1f\"/>\n\n      <!-- tail nub -->\n      <ellipse cx=\"282\" cy=\"290\" rx=\"8\" ry=\"6\" fill=\"#6b4227\"/>\n\n      <!-- neck -->\n      <ellipse cx=\"472\" cy=\"286\" rx=\"44\" ry=\"46\" fill=\"#92603c\"/>\n\n      <!-- back ear -->\n      <ellipse cx=\"474\" cy=\"240\" rx=\"15\" ry=\"12\" fill=\"#5c3820\"/>\n\n      <!-- head -->\n      <g class=\"head\">\n        <ellipse cx=\"526\" cy=\"272\" rx=\"64\" ry=\"54\" fill=\"url(#bodyGrad)\"/>\n        <ellipse cx=\"520\" cy=\"248\" rx=\"46\" ry=\"28\" fill=\"#c58e60\" opacity=\".35\"/>\n\n        <!-- snout -->\n        <ellipse cx=\"580\" cy=\"292\" rx=\"38\" ry=\"31\" fill=\"#9a6a45\"/>\n        <ellipse cx=\"576\" cy=\"282\" rx=\"26\" ry=\"14\" fill=\"#c08d61\" opacity=\".5\"/>\n\n        <!-- nose -->\n        <ellipse cx=\"604\" cy=\"280\" rx=\"12\" ry=\"9\" fill=\"#3a241a\"/>\n        <ellipse cx=\"600\" cy=\"277\" rx=\"4\" ry=\"3\" fill=\"#ffffff\" opacity=\".6\"/>\n\n        <!-- mouth -->\n        <path d=\"M566 312 q16 12 34 3\" fill=\"none\" stroke=\"#4a2c18\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        <path d=\"M604 292 q6 6 4 12\" fill=\"none\" stroke=\"#4a2c18\" stroke-width=\"2.4\" stroke-linecap=\"round\" opacity=\".7\"/>\n\n        <!-- whiskers -->\n        <g stroke=\"#e8c9a8\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\".5\">\n          <path d=\"M590 296 L616 302\"/>\n          <path d=\"M590 302 L614 312\"/>\n        </g>\n\n        <!-- cheek blush -->\n        <circle cx=\"548\" cy=\"290\" r=\"13\" fill=\"#e08a6a\" opacity=\".3\"/>\n\n        <!-- eye -->\n        <g class=\"eye\">\n          <circle cx=\"556\" cy=\"254\" r=\"12\" fill=\"#241a12\"/>\n          <circle cx=\"559.5\" cy=\"250\" r=\"4.2\" fill=\"#ffffff\" opacity=\".9\"/>\n          <circle cx=\"551\" cy=\"259\" r=\"2\" fill=\"#ffffff\" opacity=\".45\"/>\n        </g>\n\n        <!-- eyebrow -->\n        <path d=\"M544 236 q12 -6 24 -1\" fill=\"none\" stroke=\"#4a2c18\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\".55\"/>\n\n        <!-- front ear -->\n        <g class=\"ear\">\n          <ellipse cx=\"500\" cy=\"230\" rx=\"18\" ry=\"15\" fill=\"#7d4f31\" stroke=\"#5c3820\" stroke-width=\"2\"/>\n          <ellipse cx=\"501\" cy=\"232\" rx=\"9\" ry=\"7\" fill=\"#b07a52\"/>\n        </g>\n      </g>\n    </g>\n  </svg>\n\n  <canvas class=\"fx\" id=\"fx\"></canvas>\n  <div class=\"vignette\"></div>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var scene  = document.getElementById(\"scene\");\n  var canvas = document.getElementById(\"fx\");\n  var ctx    = canvas.getContext(\"2d\");\n  var craft  = document.querySelector(\".craft\");\n\n  var W = 0, H = 0, scale = 1, ox = 0, oy = 0, dpr = 1;\n  var craftOffset = 0;\n\n  function resize() {\n    var rect = scene.getBoundingClientRect();\n    dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = rect.width;\n    H = rect.height;\n    canvas.width  = Math.max(1, Math.round(W * dpr));\n    canvas.height = Math.max(1, Math.round(H * dpr));\n    canvas.style.width  = W + \"px\";\n    canvas.style.height = H + \"px\";\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    scale = Math.min(W / 800, H / 500);\n    ox = (W - 800 * scale) / 2;\n    oy = (H - 500 * scale) / 2;\n  }\n\n  function toScreen(x, y) {\n    return [ox + x * scale, oy + y * scale];\n  }\n\n  var COLORS = [\"#5ff2ff\", \"#9bffff\", \"#ff6ad5\", \"#ffffff\", \"#7aa8ff\"];\n  var parts = [];\n\n  function spawnSpark() {\n    var p = toScreen(295 + Math.random() * 210, 407 + craftOffset);\n    parts.push({\n      x: p[0],\n      y: p[1],\n      vx: (Math.random() - 0.5) * 55 * scale,\n      vy: (35 + Math.random() * 80) * scale,\n      life: 0,\n      max: 0.55 + Math.random() * 0.7,\n      r: (1.1 + Math.random() * 2.3) * scale,\n      c: COLORS[(Math.random() * COLORS.length) | 0],\n      kind: \"spark\"\n    });\n  }\n\n  function spawnDust() {\n    var p = toScreen(Math.random() * 800, 440 + Math.random() * 60);\n    parts.push({\n      x: p[0],\n      y: p[1],\n      vx: (Math.random() - 0.5) * 12 * scale,\n      vy: -(8 + Math.random() * 24) * scale,\n      life: 0,\n      max: 2 + Math.random() * 2.6,\n      r: (0.6 + Math.random() * 1.3) * scale,\n      c: \"#7fdcff\",\n      kind: \"dust\"\n    });\n  }\n\n  function readCraftOffset() {\n    var t = getComputedStyle(craft).transform;\n    if (!t || t === \"none\") { craftOffset = 0; return; }\n    var m = t.match(/matrix\\(([^)]+)\\)/);\n    if (m) {\n      var v = m[1].split(\",\");\n      var f = parseFloat(v[5]);\n      craftOffset = isNaN(f) ? 0 : f;\n    }\n  }\n\n  var last = performance.now();\n  var sparkAcc = 0;\n  var dustAcc = 0;\n\n  function frame(now) {\n    var dt = Math.min(0.05, (now - last) / 1000);\n    last = now;\n\n    readCraftOffset();\n\n    ctx.clearRect(0, 0, W, H);\n    ctx.globalCompositeOperation = \"lighter\";\n\n    sparkAcc += dt;\n    while (sparkAcc > 0.02) { sparkAcc -= 0.02; spawnSpark(); }\n\n    dustAcc += dt;\n    if (dustAcc > 0.14) { dustAcc = 0; spawnDust(); }\n\n    for (var i = parts.length - 1; i >= 0; i--) {\n      var p = parts[i];\n      p.life += dt;\n      if (p.life >= p.max) { parts.splice(i, 1); continue; }\n\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n\n      if (p.kind === \"spark\") {\n        p.vy += 70 * scale * dt;\n        p.vx *= (1 - 1.7 * dt);\n      } else {\n        p.vx += Math.sin(p.y * 0.06 + p.life * 3) * 7 * scale * dt;\n      }\n\n      var t = p.life / p.max;\n      var alpha = (1 - t) * (p.kind === \"spark\" ? 1 : 0.45);\n      var radius = p.r * (p.kind === \"spark\" ? 4 : 3.4);\n\n      var g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, radius);\n      g.addColorStop(0, p.c);\n      g.addColorStop(1, \"rgba(0,0,0,0)\");\n\n      ctx.globalAlpha = alpha;\n      ctx.fillStyle = g;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    ctx.globalAlpha = 1;\n    ctx.globalCompositeOperation = \"source-over\";\n    requestAnimationFrame(frame);\n  }\n\n  window.addEventListener(\"resize\", resize);\n  resize();\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>"
    }
  ]
