      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Capybara Hoverboard</title>\n<style>\nhtml,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#a8def0;}\n.scene{position:relative;width:100%;height:100%;}\n.capy{position:absolute;bottom:15%;left:-200px;animation:ride 10s linear infinite;}\n@keyframes ride{\n  0%   {transform:translateX(0)   translateY(0);}\n  25%  {transform:translateX(30vw) translateY(-5px);}\n  50%  {transform:translateX(60vw) translateY(0);}\n  75%  {transform:translateX(90vw) translateY(-5px);}\n  100% {transform:translateX(120vw) translateY(0);}\n}\n.board{animation: hover 2s ease-in-out infinite;}\n@keyframes hover{\n  0%,100%{transform:translateY(0);}\n  50%    {transform:translateY(-8px);}\n}\n.tail{transform-origin:70% 50%;animation: tailwiggle .4s infinite alternate;}\n@keyframes tailwiggle{\n  from{transform:rotate(0deg);}\n  to  {transform:rotate(15deg);}\n}\n</style>\n</head>\n<body>\n<div class=\"scene\">\n<svg class=\"capy\" width=\"200\" height=\"130\" viewBox=\"0 0 200 130\" xmlns=\"http://www.w3.org/2000/svg\">\n  <!-- Hoverboard -->\n  <g class=\"board\">\n    <rect x=\"30\" y=\"90\" width=\"140\" height=\"20\" rx=\"10\" fill=\"#555\"/>\n    <circle cx=\"60\" cy=\"110\" r=\"12\" fill=\"#222\"/>\n    <circle cx=\"140\" cy=\"110\" r=\"12\" fill=\"#222\"/>\n  </g>\n  <!-- Capybara body -->\n  <g class=\"body\">\n    <ellipse cx=\"100\" cy=\"80\" rx=\"55\" ry=\"35\" fill=\"#8B5A2B\"/>\n    <circle cx=\"100\" cy=\"50\" r=\"22\" fill=\"#8B5A2B\"/>\n    <!-- Ears -->\n    <polygon points=\"85,35 78,12 92,25\" fill=\"#8B5A2B\"/>\n    <polygon points=\"115,35 122,12 108,25\" fill=\"#8B5A2B\"/>\n    <!-- Eyes -->\n    <circle cx=\"92\" cy=\"48\" r=\"4\" fill=\"#fff\"/>\n    <circle cx=\"108\" cy=\"48\" r=\"4\" fill=\"#fff\"/>\n    <circle cx=\"92\" cy=\"48\" r=\"2\" fill=\"#000\"/>\n    <circle cx=\"108\" cy=\"48\" r=\"2\" fill=\"#000\"/>\n    <!-- Nose -->\n    <ellipse cx=\"100\" cy=\"58\" rx=\"5\" ry=\"2.5\" fill=\"#000\"/>\n    <!-- Front legs -->\n    <rect x=\"70\" y=\"95\" width=\"12\" height=\"22\" fill=\"#8B5A2B\"/>\n    <rect x=\"118\" y=\"95\" width=\"12\" height=\"22\" fill=\"#8B5A2B\"/>\n    <!-- Tail -->\n    <path class=\"tail\" d=\"M155,80 q8 -12 0 -24\" stroke=\"#8B5A2B\" stroke-width=\"6\" fill=\"none\"/>\n  </g>\n</svg>\n</div>\n</body>\n</html>"
