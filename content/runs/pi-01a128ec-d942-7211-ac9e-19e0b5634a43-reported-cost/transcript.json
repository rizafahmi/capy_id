      "role": "assistant",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>Capyboard - The Chillest Hoverboarder</title>\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    user-select: none;\n    -webkit-user-select: none;\n    touch-action: none;\n  }\n  body, html {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #090614;\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n  #stage {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    perspective: 1000px;\n  }\n  canvas#bg-canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  /* Capybara & Hoverboard 3D Stage Container */\n  #rider-container {\n    position: absolute;\n    top: 48%;\n    left: 48%;\n    width: 680px;\n    height: 480px;\n    margin-left: -340px;\n    margin-top: -240px;\n    z-index: 10;\n    transform-style: preserve-3d;\n    cursor: grab;\n    pointer-events: auto;\n    transition: filter 0.3s ease;\n  }\n  #rider-container:active {\n    cursor: grabbing;\n  }\n  svg#capy-svg {\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n    filter: drop-shadow(0 20px 35px rgba(0,0,0,0.65));\n    transform-origin: 50% 75%;\n  }\n\n  /* HUD Interface */\n  .hud-panel {\n    position: absolute;\n    top: 20px;\n    left: 20px;\n    z-index: 30;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    pointer-events: none;\n  }\n  .hud-badge {\n    background: rgba(14, 11, 26, 0.82);\n    border: 1px solid rgba(0, 246, 255, 0.4);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    border-radius: 14px;\n    padding: 8px 16px;\n    color: #fff;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.5), inset 0 0 10px rgba(0, 246, 255, 0.12);\n  }\n  .hud-title {\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: #00f6ff;\n    text-shadow: 0 0 8px #00f6ff;\n  }\n  .hud-value {\n    font-size: 24px;\n    font-weight: 900;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n    color: #ffffff;\n    display: flex;\n    align-items: baseline;\n    gap: 4px;\n  }\n  .hud-unit {\n    font-size: 12px;\n    font-weight: 700;\n    color: #ff0077;\n  }\n  .zen-bar-wrap {\n    width: 130px;\n    height: 6px;\n    background: rgba(255,255,255,0.15);\n    border-radius: 3px;\n    overflow: hidden;\n    margin-top: 4px;\n  }\n  .zen-bar {\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(90deg, #00f6ff, #ff00aa);\n    box-shadow: 0 0 10px #00f6ff;\n    transition: width 0.3s ease;\n  }\n\n  /* Control buttons at bottom */\n  .controls-bar {\n    position: absolute;\n    bottom: 18px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 30;\n    display: flex;\n    gap: 8px;\n    pointer-events: auto;\n    flex-wrap: nowrap;\n    justify-content: center;\n    max-width: 96%;\n  }\n  .cyber-btn {\n    background: rgba(16, 12, 32, 0.88);\n    border: 1px solid rgba(0, 246, 255, 0.45);\n    color: #00f6ff;\n    padding: 8px 14px;\n    border-radius: 30px;\n    font-size: 11.5px;\n    font-weight: 800;\n    letter-spacing: 0.8px;\n    cursor: pointer;\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    box-shadow: 0 4px 14px rgba(0,0,0,0.4), inset 0 0 8px rgba(0, 246, 255, 0.12);\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    white-space: nowrap;\n  }\n  .cyber-btn:hover {\n    background: rgba(0, 246, 255, 0.25);\n    border-color: #00f6ff;\n    color: #ffffff;\n    box-shadow: 0 0 18px rgba(0, 246, 255, 0.6), inset 0 0 12px rgba(0, 246, 255, 0.3);\n    transform: translateY(-2px);\n  }\n  .cyber-btn:active, .cyber-btn.active {\n    background: #ff0077;\n    border-color: #ff0077;\n    color: #ffffff;\n    box-shadow: 0 0 20px rgba(255, 0, 119, 0.8);\n    transform: translateY(1px);\n  }\n  .hint-text {\n    position: absolute;\n    bottom: 60px;\n    left: 50%;\n    transform: translateX(-50%);\n    color: rgba(255,255,255,0.7);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    text-shadow: 0 2px 6px rgba(0,0,0,0.9);\n    pointer-events: none;\n    z-index: 30;\n    white-space: nowrap;\n  }\n\n  @media (max-width: 768px) {\n    #rider-container {\n      width: 500px;\n      height: 360px;\n      margin-left: -250px;\n      margin-top: -180px;\n    }\n    .hud-panel {\n      top: 12px;\n      left: 12px;\n      gap: 6px;\n    }\n    .hud-badge {\n      padding: 6px 12px;\n    }\n    .hud-value {\n      font-size: 18px;\n    }\n    .hint-text {\n      display: none;\n    }\n    .controls-bar {\n      bottom: 12px;\n      gap: 6px;\n      flex-wrap: wrap;\n    }\n    .cyber-btn {\n      padding: 7px 11px;\n      font-size: 10.5px;\n    }\n  }\n</style>\n</head>\n<body>\n\n<div id=\"stage\">\n  <!-- Parallax Background Canvas -->\n  <canvas id=\"bg-canvas\"></canvas>\n\n  <!-- HUD Interface -->\n  <div class=\"hud-panel\">\n    <div class=\"hud-badge\">\n      <div class=\"hud-title\">HOVER SPEED</div>\n      <div class=\"hud-value\"><span id=\"speed-display\">84</span><span class=\"hud-unit\">MPH</span></div>\n    </div>\n    <div class=\"hud-badge\">\n      <div class=\"hud-title\">CHILL LEVEL</div>\n      <div class=\"hud-value\" id=\"zen-text\" style=\"font-size: 14px; color: #ff88dd;\">MAXIMUM ZEN</div>\n      <div class=\"zen-bar-wrap\"><div class=\"zen-bar\" id=\"zen-bar\"></div></div>\n    </div>\n  </div>\n\n  <div class=\"hint-text\">🖱️ STEER WITH MOUSE • SPACE / CLICK TO BOOST • 'T' FOR 360 SPIN</div>\n\n  <!-- Interactive Controls -->\n  <div class=\"controls-bar\">\n    <button class=\"cyber-btn\" id=\"btn-boost\">🚀 TURBO BOOST</button>\n    <button class=\"cyber-btn\" id=\"btn-trick\">✨ 360 SPIN</button>\n    <button class=\"cyber-btn\" id=\"btn-shades\">😎 SHADES</button>\n    <button class=\"cyber-btn\" id=\"btn-citrus\">🍊 CITRUS</button>\n    <button class=\"cyber-btn\" id=\"btn-theme\">🎨 THEME</button>\n  </div>\n\n  <!-- Animated Capybara & Hoverboard Rig -->\n  <div id=\"rider-container\">\n    <svg id=\"capy-svg\" viewBox=\"0 0 900 600\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <!-- Fur Gradients -->\n        <linearGradient id=\"furBase\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#ba864e\"/>\n          <stop offset=\"45%\" stop-color=\"#96612f\"/>\n          <stop offset=\"80%\" stop-color=\"#734218\"/>\n          <stop offset=\"100%\" stop-color=\"#4e290b\"/>\n        </linearGradient>\n\n        <linearGradient id=\"snoutDark\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"#8a5628\"/>\n          <stop offset=\"60%\" stop-color=\"#552c0e\"/>\n          <stop offset=\"100%\" stop-color=\"#2c1404\"/>\n        </linearGradient>\n\n        <linearGradient id=\"furShadow\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#693b14\"/>\n          <stop offset=\"100%\" stop-color=\"#361a05\"/>\n        </linearGradient>\n\n        <linearGradient id=\"boardNeon\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"#00f6ff\"/>\n          <stop offset=\"35%\" stop-color=\"#0088ff\"/>\n          <stop offset=\"70%\" stop-color=\"#9000ff\"/>\n          <stop offset=\"100%\" stop-color=\"#ff0077\"/>\n        </linearGradient>\n\n        <linearGradient id=\"boardDeck\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#2a3044\"/>\n          <stop offset=\"60%\" stop-color=\"#191c28\"/>\n          <stop offset=\"100%\" stop-color=\"#0e1017\"/>\n        </linearGradient>\n\n        <radialGradient id=\"plasmaExhaust\" cx=\"50%\" cy=\"0%\" r=\"90%\">\n          <stop offset=\"0%\" stop-color=\"#ffffff\"/>\n          <stop offset=\"20%\" stop-color=\"#00ffff\"/>\n          <stop offset=\"60%\" stop-color=\"#7000ff\" stop-opacity=\"0.8\"/>\n          <stop offset=\"100%\" stop-color=\"#ff0099\" stop-opacity=\"0\"/>\n        </radialGradient>\n\n        <radialGradient id=\"groundGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n          <stop offset=\"0%\" stop-color=\"#00f6ff\" stop-opacity=\"0.85\"/>\n          <stop offset=\"30%\" stop-color=\"#7700ff\" stop-opacity=\"0.4\"/>\n          <stop offset=\"70%\" stop-color=\"#ff0066\" stop-opacity=\"0.15\"/>\n          <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0\"/>\n        </radialGradient>\n\n        <filter id=\"bloom\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n          <feGaussianBlur stdDeviation=\"5\" result=\"blur1\"/>\n          <feGaussianBlur stdDeviation=\"12\" result=\"blur2\"/>\n          <feMerge>\n            <feMergeNode in=\"blur2\"/>\n            <feMergeNode in=\"blur1\"/>\n            <feMergeNode in=\"SourceGraphic\"/>\n          </feMerge>\n        </filter>\n      </defs>\n\n      <!-- Dynamic Ground Shadow & Plasma Reflection -->\n      <g id=\"ground-fx\">\n        <ellipse id=\"ground-shadow\" cx=\"450\" cy=\"530\" rx=\"270\" ry=\"24\" fill=\"#000000\" opacity=\"0.6\"/>\n        <ellipse id=\"ground-neon\" cx=\"450\" cy=\"530\" rx=\"220\" ry=\"18\" fill=\"url(#groundGlow)\" filter=\"url(#bloom)\"/>\n      </g>\n\n      <!-- Main Animated Rider and Board Rig -->\n      <g id=\"hover-assembly\">\n        <!-- Thrusters with Plasma Jets -->\n        <g id=\"thrusters\">\n          <path id=\"rear-plume\" d=\"M 280,440 L 245,515 L 320,515 Z\" fill=\"url(#plasmaExhaust)\" filter=\"url(#bloom)\"/>\n          <ellipse cx=\"280\" cy=\"440\" rx=\"25\" ry=\"7\" fill=\"#00ffff\" filter=\"url(#bloom)\"/>\n          <ellipse cx=\"280\" cy=\"440\" rx=\"12\" ry=\"3.5\" fill=\"#ffffff\"/>\n\n          <path id=\"front-plume\" d=\"M 620,430 L 585,505 L 660,505 Z\" fill=\"url(#plasmaExhaust)\" filter=\"url(#bloom)\"/>\n          <ellipse cx=\"620\" cy=\"430\" rx=\"25\" ry=\"7\" fill=\"#00ffff\" filter=\"url(#bloom)\"/>\n          <ellipse cx=\"620\" cy=\"430\" rx=\"12\" ry=\"3.5\" fill=\"#ffffff\"/>\n        </g>\n\n        <!-- Far Legs (behind board) -->\n        <g class=\"far-legs\">\n          <path d=\"M 270,330 C 255,360 260,395 272,428 L 302,426 C 296,398 295,365 302,330 Z\" fill=\"url(#furShadow)\"/>\n          <ellipse cx=\"287\" cy=\"427\" rx=\"17\" ry=\"6\" fill=\"#200d02\"/>\n\n          <!-- Far front leg neatly tucked behind near leg -->\n          <path d=\"M 480,310 C 472,345 478,385 490,424 L 518,421 C 512,385 510,345 515,310 Z\" fill=\"url(#furShadow)\"/>\n          <ellipse cx=\"504\" cy=\"423\" rx=\"16\" ry=\"6\" fill=\"#200d02\"/>\n        </g>\n\n        <!-- Hoverboard Model -->\n        <g id=\"hoverboard-model\">\n          <!-- Lower Hull -->\n          <path d=\"M 180,425 \n                   C 270,444 510,448 720,410 \n                   C 755,404 775,418 750,434 \n                   C 555,472 290,468 160,444 \n                   C 135,438 148,422 180,425 Z\" \n                fill=\"#0b0d14\" stroke=\"#1d2235\" stroke-width=\"2\"/>\n\n          <!-- Neon Trim -->\n          <path id=\"board-neon-line\" d=\"M 175,434 C 350,455 565,446 735,417\" \n                stroke=\"url(#boardNeon)\" stroke-width=\"6\" stroke-linecap=\"round\" fill=\"none\" filter=\"url(#bloom)\"/>\n\n          <!-- Upper Deck -->\n          <path d=\"M 170,422 \n                   C 265,432 540,428 730,400 \n                   C 755,396 770,406 748,420 \n                   C 550,452 275,448 158,434 \n                   C 142,428 152,419 170,422 Z\" \n                fill=\"url(#boardDeck)\" stroke=\"#3e4766\" stroke-width=\"2\"/>\n\n          <!-- Grip Pads -->\n          <path d=\"M 220,426 C 270,432 325,432 370,429 L 365,436 C 315,439 260,438 210,432 Z\" fill=\"#08090f\"/>\n          <path d=\"M 510,422 C 580,414 650,405 700,400 L 705,407 C 650,413 580,422 505,429 Z\" fill=\"#08090f\"/>\n\n          <!-- Battery Gauge -->\n          <g transform=\"translate(400, 427)\">\n            <rect x=\"0\" y=\"0\" width=\"80\" height=\"8\" rx=\"4\" fill=\"#0a0c12\" stroke=\"#22283a\" stroke-width=\"1.2\"/>\n            <rect x=\"5\" y=\"2\" width=\"14\" height=\"4\" rx=\"1.5\" fill=\"#00f6ff\" filter=\"url(#bloom)\"/>\n            <rect x=\"23\" y=\"2\" width=\"14\" height=\"4\" rx=\"1.5\" fill=\"#00f6ff\" filter=\"url(#bloom)\"/>\n            <rect x=\"41\" y=\"2\" width=\"14\" height=\"4\" rx=\"1.5\" fill=\"#00f6ff\" filter=\"url(#bloom)\"/>\n            <rect x=\"59\" y=\"2\" width=\"16\" height=\"4\" rx=\"1.5\" fill=\"#ff0077\" filter=\"url(#bloom)\"/>\n          </g>\n\n          <!-- Headlight -->\n          <polygon points=\"742,408 762,404 758,416 738,417\" fill=\"#00f6ff\" filter=\"url(#bloom)\"/>\n          <path d=\"M 760,410 L 855,390 L 865,445 Z\" fill=\"#00f6ff\" opacity=\"0.14\"/>\n        </g>\n\n        <!-- Near Limbs (Surfer Stance) -->\n        <g class=\"near-legs\">\n          <!-- Near Hind Leg -->\n          <path id=\"hind-leg-path\" d=\"M 255,275 \n                   C 210,305 215,365 235,406 \n                   C 246,424 255,433 270,435 \n                   L 310,432 \n                   C 312,396 308,355 330,312 \n                   C 305,280 280,272 255,275 Z\" \n                fill=\"url(#furBase)\"/>\n          <ellipse cx=\"290\" cy=\"433\" rx=\"24\" ry=\"9\" fill=\"#422208\"/>\n          <circle cx=\"275\" cy=\"435\" r=\"4\" fill=\"#1b0a01\"/>\n          <circle cx=\"288\" cy=\"437\" r=\"4.2\" fill=\"#1b0a01\"/>\n          <circle cx=\"302\" cy=\"437\" r=\"4.2\" fill=\"#1b0a01\"/>\n          <circle cx=\"314\" cy=\"434\" r=\"3.6\" fill=\"#1b0a01\"/>\n          <line x1=\"275\" y1=\"436\" x2=\"274\" y2=\"440\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <line x1=\"288\" y1=\"439\" x2=\"288\" y2=\"443\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <line x1=\"302\" y1=\"439\" x2=\"302\" y2=\"443\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <line x1=\"314\" y1=\"436\" x2=\"315\" y2=\"440\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n\n          <!-- Near Front Leg -->\n          <path id=\"front-leg-path\" d=\"M 485,300 \n                   C 460,342 470,390 490,428 \n                   L 530,425 \n                   C 538,380 540,335 528,290 Z\" \n                fill=\"url(#furBase)\"/>\n          <ellipse cx=\"510\" cy=\"426\" rx=\"24\" ry=\"9\" fill=\"#422208\"/>\n          <circle cx=\"495\" cy=\"428\" r=\"4\" fill=\"#1b0a01\"/>\n          <circle cx=\"508\" cy=\"430\" r=\"4.2\" fill=\"#1b0a01\"/>\n          <circle cx=\"522\" cy=\"430\" r=\"4.2\" fill=\"#1b0a01\"/>\n          <circle cx=\"534\" cy=\"427\" r=\"3.6\" fill=\"#1b0a01\"/>\n          <line x1=\"495\" y1=\"429\" x2=\"494\" y2=\"433\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <line x1=\"508\" y1=\"432\" x2=\"508\" y2=\"436\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <line x1=\"522\" y1=\"432\" x2=\"522\" y2=\"436\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <line x1=\"534\" y1=\"429\" x2=\"535\" y2=\"433\" stroke=\"#d5b895\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n        </g>\n\n        <!-- Torso with Breathing Motion -->\n        <g id=\"capy-torso\">\n          <path d=\"M 240,270 \n                   C 195,225 225,165 305,158 \n                   C 375,155 425,178 475,220 \n                   C 515,255 510,320 460,350 \n                   C 380,372 290,355 240,270 Z\" \n                fill=\"url(#furBase)\"/>\n          <!-- Dorsal Highlight -->\n          <path d=\"M 260,178 C 315,160 380,160 445,188\" \n                stroke=\"#fad69b\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.6\"/>\n          <!-- Belly Glow -->\n          <path d=\"M 315,360 C 375,368 435,356 465,330\" \n                stroke=\"#00f6ff\" stroke-width=\"4.5\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.45\" filter=\"url(#bloom)\"/>\n          <!-- Agouti Fur texture details -->\n          <g stroke=\"#552c0e\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\"0.4\">\n            <line x1=\"280\" y1=\"198\" x2=\"320\" y2=\"206\"/>\n            <line x1=\"335\" y1=\"194\" x2=\"380\" y2=\"202\"/>\n            <line x1=\"265\" y1=\"238\" x2=\"310\" y2=\"248\"/>\n            <line x1=\"325\" y1=\"242\" x2=\"375\" y2=\"254\"/>\n            <line x1=\"390\" y1=\"235\" x2=\"435\" y2=\"248\"/>\n            <line x1=\"300\" y1=\"290\" x2=\"355\" y2=\"302\"/>\n            <line x1=\"370\" y1=\"295\" x2=\"425\" y2=\"308\"/>\n          </g>\n        </g>\n\n        <!-- Head Assembly (Bobs & tilts) -->\n        <g id=\"capy-head-group\">\n          <!-- Neck -->\n          <path d=\"M 430,205 \n                   C 455,172 500,160 555,156 \n                   L 575,248 \n                   C 525,285 475,280 430,238 Z\" \n                fill=\"url(#furBase)\"/>\n\n          <!-- Capybara Skull: Flat top, blunt snout, deep jowl -->\n          <path d=\"M 475,165 \n                   C 515,150 580,146 645,150 \n                   C 678,152 702,160 710,180 \n                   C 715,202 710,228 694,245 \n                   C 665,272 600,278 550,260 \n                   C 502,245 472,210 475,165 Z\" \n                fill=\"url(#furBase)\"/>\n\n          <!-- Top Highlight -->\n          <path d=\"M 500,158 C 555,148 625,150 690,164\" \n                stroke=\"#fad69b\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.65\"/>\n\n          <!-- Dark Snout / Muzzle Pad -->\n          <path d=\"M 645,152 \n                   C 682,156 706,168 710,188 \n                   C 714,210 706,232 686,248 \n                   C 662,260 635,256 625,235 \n                   C 618,202 625,172 645,152 Z\" \n                fill=\"url(#snoutDark)\"/>\n\n          <!-- Comma Nostril -->\n          <path d=\"M 696,178 C 703,180 704,187 698,190 C 693,190 693,183 696,178 Z\" fill=\"#140902\"/>\n          <ellipse cx=\"697\" cy=\"184\" rx=\"2.8\" ry=\"4\" fill=\"#080301\"/>\n\n          <!-- Gentle Zen Smile -->\n          <path d=\"M 698,200 C 690,215 668,222 638,218\" \n                stroke=\"#140902\" stroke-width=\"3.2\" stroke-linecap=\"round\" fill=\"none\"/>\n          <!-- Chin crease -->\n          <path d=\"M 670,238 Q 642,248 615,242\" \n                stroke=\"#3a1c07\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.5\"/>\n\n          <!-- Whiskers -->\n          <g stroke=\"#ffffff\" stroke-width=\"1.1\" opacity=\"0.65\" stroke-linecap=\"round\">\n            <line x1=\"680\" y1=\"202\" x2=\"740\" y2=\"195\"/>\n            <line x1=\"684\" y1=\"209\" x2=\"746\" y2=\"210\"/>\n            <line x1=\"678\" y1=\"216\" x2=\"738\" y2=\"228\"/>\n            <line x1=\"668\" y1=\"223\" x2=\"724\" y2=\"242\"/>\n          </g>\n\n          <!-- Zen Calm Eye (Horizontal peaceful sleepy lid) -->\n          <g id=\"capy-eye\" transform=\"translate(580, 180)\">\n            <ellipse cx=\"0\" cy=\"0\" rx=\"14\" ry=\"9.5\" fill=\"#2d1505\"/>\n            <ellipse cx=\"1\" cy=\"0\" rx=\"9.5\" ry=\"7.5\" fill=\"#110601\"/>\n            <circle cx=\"3\" cy=\"-2.8\" r=\"2.3\" fill=\"#ffffff\" opacity=\"0.9\"/>\n            <path id=\"eyelid-path\" d=\"M -14,0 Q 0,-8 14,-1 L 14,3 Q 0,-2 -14,3 Z\" fill=\"#8a5324\"/>\n            <path d=\"M -14,0 Q 0,-7 14,-1\" stroke=\"#200c02\" stroke-width=\"2.8\" stroke-linecap=\"round\" fill=\"none\"/>\n            <path d=\"M 14,-1 Q 19,-5 22,-2\" stroke=\"#3d1b06\" stroke-width=\"1.8\" stroke-linecap=\"round\" fill=\"none\"/>\n          </g>\n\n          <!-- Ear (Twitches) -->\n          <g id=\"capy-ear\" transform=\"translate(488, 156)\">\n            <path d=\"M 0,20 C -11,-9 20,-18 30,5 C 32,18 18,26 0,20 Z\" fill=\"#4d270a\"/>\n            <path d=\"M 4,16 C -2,-2 16,-8 21,4 C 22,13 13,17 4,16 Z\" fill=\"#9e4e2b\"/>\n            <ellipse cx=\"11\" cy=\"7\" rx=\"4\" ry=\"7\" fill=\"#1b0902\"/>\n          </g>\n\n          <!-- Yuzu / Orange on Head (Togglable & Bobs) -->\n          <g id=\"citrus-fruit\" transform=\"translate(575, 134)\">\n            <ellipse cx=\"0\" cy=\"16\" rx=\"16\" ry=\"4.5\" fill=\"#261205\" opacity=\"0.35\"/>\n            <circle cx=\"0\" cy=\"0\" r=\"18\" fill=\"#ff8c00\"/>\n            <circle cx=\"-3\" cy=\"-3\" r=\"15\" fill=\"#ffa700\"/>\n            <ellipse cx=\"-4\" cy=\"-5\" rx=\"7\" ry=\"4\" fill=\"#ffdf66\" opacity=\"0.65\"/>\n            <circle cx=\"-5\" cy=\"-6\" r=\"1.8\" fill=\"#ffffff\" opacity=\"0.9\"/>\n            <circle cx=\"0\" cy=\"-16\" r=\"2.8\" fill=\"#e07000\"/>\n            <path d=\"M 0,-16 Q 4,-23 1,-28\" stroke=\"#2d5e1e\" stroke-width=\"2.8\" stroke-linecap=\"round\" fill=\"none\"/>\n            <path id=\"leaf-path\" d=\"M 1,-25 Q 16,-34 20,-23 Q 13,-16 1,-25 Z\" fill=\"#43a020\"/>\n            <path d=\"M 2,-25 Q 11,-27 18,-23\" stroke=\"#7be344\" stroke-width=\"1.2\" fill=\"none\"/>\n          </g>\n\n          <!-- Cyber Shades (Togglable) -->\n          <g id=\"cyber-shades\" transform=\"translate(565, 158)\" style=\"display: none;\">\n            <polygon points=\"0,14 65,2 70,27 7,34\" fill=\"#090b12\" stroke=\"#00f6ff\" stroke-width=\"1.8\" filter=\"url(#bloom)\"/>\n            <polygon points=\"3,16 62,4 66,25 9,31\" fill=\"url(#boardNeon)\" opacity=\"0.95\"/>\n            <line x1=\"16\" y1=\"28\" x2=\"44\" y2=\"9\" stroke=\"#ffffff\" stroke-width=\"3.5\" stroke-linecap=\"round\" opacity=\"0.95\"/>\n            <line x1=\"48\" y1=\"23\" x2=\"59\" y2=\"14\" stroke=\"#ffffff\" stroke-width=\"2.2\" stroke-linecap=\"round\" opacity=\"0.75\"/>\n            <path d=\"M 2,16 Q -32,9 -62,0\" stroke=\"#090b12\" stroke-width=\"4\" stroke-linecap=\"round\" fill=\"none\"/>\n            <path d=\"M 2,16 Q -32,9 -62,0\" stroke=\"#00f6ff\" stroke-width=\"1.5\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.85\"/>\n          </g>\n        </g>\n\n        <!-- Dynamic Animated Scarf -->\n        <g id=\"scarf-assembly\">\n          <!-- Collar Wrap -->\n          <path d=\"M 460,225 C 495,210 540,220 556,244 C 518,264 476,260 450,242 Z\" fill=\"#ff0055\"/>\n          <path d=\"M 468,223 C 500,213 536,221 548,237\" stroke=\"#ff66a3\" stroke-width=\"3\" stroke-linecap=\"round\" fill=\"none\"/>\n          <ellipse cx=\"456\" cy=\"238\" rx=\"9\" ry=\"12\" fill=\"#d90048\"/>\n          <ellipse cx=\"457\" cy=\"238\" rx=\"5\" ry=\"8\" fill=\"#ff1a66\"/>\n\n          <!-- Dynamic Billowing Streamers (Updated in JS for wave flutter) -->\n          <path id=\"scarf-top\" d=\"M 452,226 C 390,195 310,160 220,175 C 160,185 130,150 130,150 Z\" fill=\"#ff0055\"/>\n          <path id=\"scarf-top-highlight\" d=\"M 450,228 C 390,198 310,163 220,178\" stroke=\"#ff66a3\" stroke-width=\"2.2\" fill=\"none\"/>\n\n          <path id=\"scarf-bot\" d=\"M 454,238 C 400,220 330,190 250,205 C 190,215 170,185 170,185 Z\" fill=\"#c40040\"/>\n        </g>\n      </g>\n    </svg>\n  </div>\n</div>\n\n<script>\n// Canvas Engine & Parallax Environment\nconst canvas = document.getElementById('bg-canvas');\nconst ctx = canvas.getContext('2d');\n\nlet width, height;\nfunction resize() {\n  width = canvas.width = window.innerWidth;\n  height = canvas.height = window.innerHeight;\n}\nwindow.addEventListener('resize', resize);\nresize();\n\n// Starfield\nconst stars = [];\nfor (let i = 0; i < 110; i++) {\n  stars.push({\n    x: Math.random(),\n    y: Math.random() * 0.55,\n    r: Math.random() * 1.6 + 0.4,\n    alpha: Math.random() * 0.8 + 0.2,\n    blinkSpeed: Math.random() * 0.03 + 0.01\n  });\n}\n\n// Distant mountains\nconst mountainPoints = [];\nfor (let i = 0; i <= 24; i++) {\n  mountainPoints.push(50 + Math.random() * 75);\n}\n\n// Neon Skyline buildings\nconst skyline = [];\nfor (let i = 0; i < 35; i++) {\n  skyline.push({\n    x: i * 65,\n    w: 40 + Math.random() * 35,\n    h: 70 + Math.random() * 130,\n    hue: Math.random() > 0.5 ? 280 : 190,\n    windows: Math.random() > 0.25\n  });\n}\n\n// Palm trees / light posts parallax midground\nconst landmarks = [];\nfor (let i = 0; i < 18; i++) {\n  landmarks.push({\n    x: i * 200 + Math.random() * 40,\n    type: i % 2 === 0 ? 'palm' : 'lamp'\n  });\n}\n\n// Particle pool for thruster exhaust & trick sparkles\nconst particles = [];\nfor (let i = 0; i < 100; i++) {\n  particles.push({ active: false, x: 0, y: 0, vx: 0, vy: 0, r: 0, alpha: 0, color: '#00f6ff', spark: false });\n}\n\nfunction spawnParticle(x, y, vx, vy, r, color, spark = false) {\n  const p = particles.find(p => !p.active);\n  if (!p) return;\n  p.active = true;\n  p.x = x;\n  p.y = y;\n  p.vx = vx;\n  p.vy = vy;\n  p.r = r;\n  p.alpha = 1;\n  p.color = color;\n  p.spark = spark;\n}\n\n// Themes\nconst themes = [\n  {\n    name: 'RETRO SUNSET',\n    skyTop: '#06030e',\n    skyMid: '#1a0928',\n    skyBot: '#661545',\n    sunAura: 'rgba(255, 0, 119, 0.45)',\n    sun1: '#fff455',\n    sun2: '#ff0077',\n    sun3: '#7000ff',\n    mountain: '#160924',\n    mtnStroke: '#ff0088',\n    road1: '#130520',\n    road2: '#0b0213',\n    road3: '#050109',\n    gridH: 'rgba(0, 246, 255, 0.65)',\n    gridV: 'rgba(255, 0, 136, 0.22)',\n    centerStrip: 'rgba(0, 255, 200, 0.95)',\n    palm: '#00f6ff',\n    lamp: '#ff0088'\n  },\n  {\n    name: 'CYBER NIGHT',\n    skyTop: '#020712',\n    skyMid: '#06162d',\n    skyBot: '#0a3048',\n    sunAura: 'rgba(0, 246, 255, 0.4)',\n    sun1: '#88ffff',\n    sun2: '#00a2ff',\n    sun3: '#0033aa',\n    mountain: '#05182a',\n    mtnStroke: '#00f6ff',\n    road1: '#04121f',\n    road2: '#020b14',\n    road3: '#01050a',\n    gridH: 'rgba(0, 255, 170, 0.65)',\n    gridV: 'rgba(0, 170, 255, 0.25)',\n    centerStrip: 'rgba(0, 255, 255, 0.95)',\n    palm: '#00ffaa',\n    lamp: '#00d0ff'\n  },\n  {\n    name: 'NEON DREAM',\n    skyTop: '#10031a',\n    skyMid: '#280536',\n    skyBot: '#520a50',\n    sunAura: 'rgba(255, 120, 240, 0.45)',\n    sun1: '#ffffff',\n    sun2: '#ff77d9',\n    sun3: '#9900ee',\n    mountain: '#20082a',\n    mtnStroke: '#ff55cc',\n    road1: '#1d0526',\n    road2: '#100216',\n    road3: '#07010a',\n    gridH: 'rgba(255, 110, 220, 0.65)',\n    gridV: 'rgba(150, 60, 255, 0.3)',\n    centerStrip: 'rgba(255, 230, 100, 0.95)',\n    palm: '#ff77d9',\n    lamp: '#ffff55'\n  }\n];\n\nlet currentThemeIdx = 0;\nlet currentTheme = themes[0];\n\n// State\nlet time = 0;\nlet speed = 84;\nlet targetSpeed = 84;\nlet boost = false;\nlet tricking = false;\nlet trickProgress = 0;\nlet shadesOn = false;\nlet citrusOn = true;\n\n// Mouse / Touch Steering\nlet targetX = 0; // -1 to 1\nlet targetY = 0; // -1 to 1\nlet currentX = 0;\nlet currentY = 0;\n\nwindow.addEventListener('mousemove', (e) => {\n  targetX = (e.clientX / window.innerWidth) * 2 - 1;\n  targetY = (e.clientY / window.innerHeight) * 2 - 1;\n});\n\nwindow.addEventListener('touchmove', (e) => {\n  if (e.touches.length > 0) {\n    targetX = (e.touches[0].clientX / window.innerWidth) * 2 - 1;\n    targetY = (e.touches[0].clientY / window.innerHeight) * 2 - 1;\n  }\n}, { passive: true });\n\n// Keyboard Steering\nconst keys = {};\nwindow.addEventListener('keydown', (e) => {\n  keys[e.code] = true;\n  if (e.code === 'Space') {\n    e.preventDefault();\n    setBoost(true);\n  }\n  if (e.key === 't' || e.key === 'T') {\n    triggerTrick();\n  }\n  if (e.key === 's' || e.key === 'S') {\n    toggleShades();\n  }\n  if (e.key === 'c' || e.key === 'C') {\n    toggleCitrus();\n  }\n});\nwindow.addEventListener('keyup', (e) => {\n  keys[e.code] = false;\n  if (e.code === 'Space') {\n    e.preventDefault();\n    setBoost(false);\n  }\n});\n\n// Controls\nconst btnBoost = document.getElementById('btn-boost');\nconst btnTrick = document.getElementById('btn-trick');\nconst btnShades = document.getElementById('btn-shades');\nconst btnCitrus = document.getElementById('btn-citrus');\nconst btnTheme = document.getElementById('btn-theme');\nconst speedDisplay = document.getElementById('speed-display');\nconst zenText = document.getElementById('zen-text');\nconst zenBar = document.getElementById('zen-bar');\n\nfunction setBoost(state) {\n  boost = state;\n  targetSpeed = boost ? 152 : 84;\n  btnBoost.classList.toggle('active', boost);\n  if (boost) {\n    zenText.textContent = 'HYPER CHILL 120%';\n    zenText.style.color = '#00ffff';\n    zenBar.style.width = '100%';\n  } else {\n    zenText.textContent = tricking ? 'RADICAL ZEN 110%' : 'MAXIMUM ZEN';\n    zenText.style.color = '#ff88dd';\n    zenBar.style.width = '100%';\n  }\n}\n\nbtnBoost.addEventListener('mousedown', () => setBoost(true));\nwindow.addEventListener('mouseup', () => setBoost(false));\nbtnBoost.addEventListener('touchstart', (e) => { e.preventDefault(); setBoost(true); });\nwindow.addEventListener('touchend', () => setBoost(false));\n\nfunction triggerTrick() {\n  if (tricking) return;\n  tricking = true;\n  trickProgress = 0;\n  btnTrick.classList.add('active');\n  zenText.textContent = 'RADICAL ZEN 110%';\n  zenText.style.color = '#ffff00';\n\n  // Burst trick sparkle particles\n  const rect = riderContainer.getBoundingClientRect();\n  const cx = rect.left + rect.width * 0.5;\n  const cy = rect.top + rect.height * 0.6;\n  for (let i = 0; i < 25; i++) {\n    const angle = (i / 25) * Math.PI * 2;\n    const spd = Math.random() * 8 + 4;\n    spawnParticle(cx, cy, Math.cos(angle) * spd, Math.sin(angle) * spd, Math.random() * 4 + 2, Math.random() > 0.5 ? '#ffff00' : '#00ffff', true);\n  }\n\n  setTimeout(() => {\n    tricking = false;\n    btnTrick.classList.remove('active');\n    if (!boost) {\n      zenText.textContent = 'MAXIMUM ZEN';\n      zenText.style.color = '#ff88dd';\n    }\n  }, 1000);\n}\nbtnTrick.addEventListener('click', triggerTrick);\n\nfunction toggleShades() {\n  shadesOn = !shadesOn;\n  document.getElementById('cyber-shades').style.display = shadesOn ? 'block' : 'none';\n  btnShades.classList.toggle('active', shadesOn);\n}\nbtnShades.addEventListener('click', toggleShades);\n\nfunction toggleCitrus() {\n  citrusOn = !citrusOn;\n  document.getElementById('citrus-fruit').style.display = citrusOn ? 'block' : 'none';\n  btnCitrus.classList.toggle('active', citrusOn);\n}\nbtnCitrus.addEventListener('click', toggleCitrus);\n\nbtnTheme.addEventListener('click', () => {\n  currentThemeIdx = (currentThemeIdx + 1) % themes.length;\n  currentTheme = themes[currentThemeIdx];\n  btnTheme.textContent = '🎨 ' + currentTheme.name.split(' ')[0];\n});\n\n// Render Loop\nlet roadOffset = 0;\nlet skylineOffset = 0;\nlet mountainOffset = 0;\nlet landmarksOffset = 0;\n\nfunction drawBackground() {\n  ctx.clearRect(0, 0, width, height);\n\n  const horizonY = height * 0.65;\n  const th = currentTheme;\n\n  // 1. Sky Gradient Background\n  const skyGrad = ctx.createLinearGradient(0, 0, 0, horizonY);\n  skyGrad.addColorStop(0, th.skyTop);\n  skyGrad.addColorStop(0.4, th.skyMid);\n  skyGrad.addColorStop(1, th.skyBot);\n  ctx.fillStyle = skyGrad;\n  ctx.fillRect(0, 0, width, horizonY);\n\n  // 2. Twinkling Stars\n  stars.forEach(s => {\n    s.alpha += Math.sin(time * 5 + s.x * 20) * 0.01;\n    ctx.fillStyle = `rgba(255, 255, 255, ${Math.max(0.15, Math.min(1, s.alpha))})`;\n    ctx.beginPath();\n    ctx.arc(s.x * width, s.y * height, s.r, 0, Math.PI * 2);\n    ctx.fill();\n  });\n\n  // 3. Huge Glowing Retrowave Sun\n  const sunX = width * 0.5;\n  const sunRadius = Math.min(width, height) * 0.22;\n  const sunY = horizonY - sunRadius * 0.68;\n\n  // Sun outer atmospheric aura\n  const sunAura = ctx.createRadialGradient(sunX, sunY, sunRadius * 0.5, sunX, sunY, sunRadius * 2);\n  sunAura.addColorStop(0, th.sunAura);\n  sunAura.addColorStop(0.6, 'rgba(112, 0, 255, 0.15)');\n  sunAura.addColorStop(1, 'rgba(112, 0, 255, 0)');\n  ctx.fillStyle = sunAura;\n  ctx.beginPath();\n  ctx.arc(sunX, sunY, sunRadius * 2, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Sun disc\n  const sunGrad = ctx.createLinearGradient(sunX, sunY - sunRadius, sunX, sunY + sunRadius);\n  sunGrad.addColorStop(0, th.sun1);\n  sunGrad.addColorStop(0.38, th.sun2);\n  sunGrad.addColorStop(0.88, th.sun3);\n  sunGrad.addColorStop(1, th.skyMid);\n\n  ctx.save();\n  ctx.fillStyle = sunGrad;\n  ctx.beginPath();\n  ctx.arc(sunX, sunY, sunRadius, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Retrowave horizontal horizon slices\n  ctx.fillStyle = th.skyMid;\n  for (let y = sunY + 12; y < sunY + sunRadius; y += 7 + (y - sunY) * 0.14) {\n    const sliceH = 2.5 + (y - sunY) * 0.09;\n    ctx.fillRect(sunX - sunRadius - 10, y, (sunRadius + 10) * 2, sliceH);\n  }\n  ctx.restore();\n\n  // 4. Distant Parallax Neon Mountains\n  const mtnSpeed = (speed / 80) * 0.6;\n  mountainOffset = (mountainOffset + mtnSpeed) % 400;\n  ctx.save();\n  ctx.fillStyle = th.mountain;\n  ctx.strokeStyle = th.mtnStroke;\n  ctx.lineWidth = 1.2;\n  ctx.beginPath();\n  ctx.moveTo(0, horizonY);\n  for (let x = 0; x <= width + 80; x += 40) {\n    const idx = Math.floor((x + mountainOffset) / 40) % mountainPoints.length;\n    const my = horizonY - mountainPoints[idx];\n    ctx.lineTo(x, my);\n  }\n  ctx.lineTo(width, horizonY);\n  ctx.closePath();\n  ctx.fill();\n  ctx.stroke();\n  ctx.restore();\n\n  // 5. Parallax Skyline\n  const skylineSpeed = (speed / 80) * 1.8;\n  skylineOffset = (skylineOffset + skylineSpeed) % (skyline.length * 65);\n\n  ctx.save();\n  skyline.forEach(b => {\n    let bx = (b.x - skylineOffset) % (skyline.length * 65);\n    if (bx < -120) bx += skyline.length * 65;\n    const by = horizonY - b.h;\n\n    // Building silhouette with neon edge\n    ctx.fillStyle = '#0d0517';\n    ctx.fillRect(bx, by, b.w, b.h);\n    ctx.strokeStyle = `rgba(${b.hue === 280 ? '160, 32, 240' : '0, 246, 255'}, 0.45)`;\n    ctx.lineWidth = 1;\n    ctx.strokeRect(bx, by, b.w, b.h);\n\n    if (b.windows) {\n      ctx.fillStyle = `rgba(${b.hue === 280 ? '255, 0, 128' : '0, 246, 255'}, 0.35)`;\n      for (let wy = by + 12; wy < horizonY - 8; wy += 14) {\n        for (let wx = bx + 6; wx < bx + b.w - 6; wx += 9) {\n          if (Math.sin(wx * 8 + wy) > 0.2) {\n            ctx.fillRect(wx, wy, 3.5, 5);\n          }\n        }\n      }\n    }\n  });\n  ctx.restore();\n\n  // 6. Parallax Midground (Cyber Palms & Lamps)\n  const landmarkSpeed = (speed / 80) * 5.5;\n  landmarksOffset = (landmarksOffset + landmarkSpeed) % 3600;\n\n  landmarks.forEach(lm => {\n    let lx = (lm.x - landmarksOffset) % 3600;\n    if (lx < -150) lx += 3600;\n\n    if (lm.type === 'palm') {\n      ctx.save();\n      ctx.translate(lx, horizonY);\n      ctx.strokeStyle = th.palm;\n      ctx.lineWidth = 4;\n      ctx.beginPath();\n      ctx.moveTo(0, 0);\n      ctx.quadraticCurveTo(-15, -60, -5, -125);\n      ctx.stroke();\n\n      ctx.lineWidth = 2.5;\n      for (let f = 0; f < 5; f++) {\n        const ang = -Math.PI * 0.2 - (f * Math.PI * 0.15);\n        ctx.beginPath();\n        ctx.moveTo(-5, -125);\n        ctx.quadraticCurveTo(Math.cos(ang) * 40 - 5, -125 + Math.sin(ang) * 40, Math.cos(ang) * 75 - 5, -105 + Math.sin(ang) * 55);\n        ctx.stroke();\n      }\n      ctx.restore();\n    } else {\n      ctx.save();\n      ctx.translate(lx, horizonY);\n      ctx.strokeStyle = th.lamp;\n      ctx.lineWidth = 3;\n      ctx.beginPath();\n      ctx.moveTo(0, 0);\n      ctx.lineTo(0, -110);\n      ctx.lineTo(20, -110);\n      ctx.stroke();\n\n      const lampGrad = ctx.createRadialGradient(20, -110, 2, 20, -110, 45);\n      lampGrad.addColorStop(0, '#ffffff');\n      lampGrad.addColorStop(0.35, th.lamp);\n      lampGrad.addColorStop(1, 'rgba(255, 0, 136, 0)');\n      ctx.fillStyle = lampGrad;\n      ctx.beginPath();\n      ctx.arc(20, -110, 45, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n    }\n  });\n\n  // 7. High-speed Neon Perspective Grid Highway\n  const roadSpeed = (speed / 80) * 18;\n  roadOffset = (roadOffset + roadSpeed) % 80;\n\n  const roadGrad = ctx.createLinearGradient(0, horizonY, 0, height);\n  roadGrad.addColorStop(0, th.road1);\n  roadGrad.addColorStop(0.35, th.road2);\n  roadGrad.addColorStop(1, th.road3);\n  ctx.fillStyle = roadGrad;\n  ctx.fillRect(0, horizonY, width, height - horizonY);\n\n  // Horizontal Grid Lines\n  ctx.lineWidth = 1.5;\n  for (let d = 0; d < 1; d += 0.05) {\n    const curY = horizonY + Math.pow((d + (roadOffset / 80) * 0.05) % 1, 3) * (height - horizonY);\n    const alpha = (curY - horizonY) / (height - horizonY);\n    ctx.strokeStyle = th.gridH.replace('0.65', (alpha * 0.7).toFixed(2));\n    ctx.beginPath();\n    ctx.moveTo(0, curY);\n    ctx.lineTo(width, curY);\n    ctx.stroke();\n  }\n\n  // Perspective Vanishing Lines\n  const vpX = width * 0.5;\n  for (let x = -width; x <= width * 2; x += 110) {\n    ctx.strokeStyle = th.gridV;\n    ctx.beginPath();\n    ctx.moveTo(vpX, horizonY);\n    ctx.lineTo(x, height);\n    ctx.stroke();\n  }\n\n  // Center High-Speed Dashed Road Strip\n  ctx.lineWidth = 7;\n  for (let i = 0; i < 15; i++) {\n    const p1 = Math.pow((i * 0.08 + (roadOffset / 80) * 0.08) % 1, 2.5);\n    const p2 = Math.pow(((i + 0.5) * 0.08 + (roadOffset / 80) * 0.08) % 1, 2.5);\n    const y1 = horizonY + p1 * (height - horizonY);\n    const y2 = horizonY + p2 * (height - horizonY);\n    ctx.strokeStyle = th.centerStrip.replace('0.95', (p1 * 0.95).toFixed(2));\n    ctx.beginPath();\n    ctx.moveTo(vpX, y1);\n    ctx.lineTo(vpX, y2);\n    ctx.stroke();\n  }\n\n  // 8. Thruster Sparks & Speed Wind Streaks\n  particles.forEach(p => {\n    if (!p.active) return;\n    p.x += p.vx;\n    p.y += p.vy;\n    p.alpha -= p.spark ? 0.035 : 0.022;\n    if (p.alpha <= 0) {\n      p.active = false;\n      return;\n    }\n    ctx.fillStyle = p.color;\n    ctx.globalAlpha = p.alpha;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  });\n\n  // Wind speed streaks when boosting\n  if (boost) {\n    for (let i = 0; i < 8; i++) {\n      const sy = Math.random() * height;\n      const len = 180 + Math.random() * 260;\n      const sx = Math.random() * width;\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.moveTo(sx, sy);\n      ctx.lineTo(sx - len, sy);\n      ctx.stroke();\n    }\n  }\n}\n\n// Rig Animation & Physics\nconst riderContainer = document.getElementById('rider-container');\nconst capySvg = document.getElementById('capy-svg');\nconst headGroup = document.getElementById('capy-head-group');\nconst earGroup = document.getElementById('capy-ear');\nconst eyelidPath = document.getElementById('eyelid-path');\nconst citrusFruit = document.getElementById('citrus-fruit');\nconst leafPath = document.getElementById('leaf-path');\nconst scarfTop = document.getElementById('scarf-top');\nconst scarfTopH = document.getElementById('scarf-top-highlight');\nconst scarfBot = document.getElementById('scarf-bot');\nconst rearPlume = document.getElementById('rear-plume');\nconst frontPlume = document.getElementById('front-plume');\nconst groundShadow = document.getElementById('ground-shadow');\nconst groundNeon = document.getElementById('ground-neon');\n\nlet blinkTimer = 0;\nlet earTwitchTimer = 0;\n\nfunction animate(timestamp) {\n  time = timestamp * 0.001;\n\n  // Arrow / WASD key control\n  if (keys['ArrowLeft'] || keys['KeyA']) targetX = Math.max(-1, targetX - 0.04);\n  if (keys['ArrowRight'] || keys['KeyD']) targetX = Math.min(1, targetX + 0.04);\n  if (keys['ArrowUp'] || keys['KeyW']) targetY = Math.max(-1, targetY - 0.04);\n  if (keys['ArrowDown'] || keys['KeyS']) targetY = Math.min(1, targetY + 0.04);\n\n  // Smooth Speed interpolation\n  speed += (targetSpeed - speed) * 0.08;\n  speedDisplay.textContent = Math.round(speed);\n\n  // Mouse / Pointer Smooth follow\n  currentX += (targetX - currentX) * 0.05;\n  currentY += (targetY - currentY) * 0.05;\n\n  // Board Hover Oscillation\n  const hoverFreq = boost ? 9 : 5;\n  const hoverAmp = boost ? 6 : 12;\n  const hoverY = Math.sin(time * hoverFreq) * hoverAmp;\n  const hoverPitch = Math.cos(time * hoverFreq * 0.8) * 2.5 + (currentX * 4) + (boost ? 4 : 0);\n  const hoverRoll = -currentX * 14;\n\n  // Trick 360 spin animation\n  let trickRot = 0;\n  let trickLift = 0;\n  if (tricking) {\n    trickProgress += 0.035;\n    trickRot = Math.sin(trickProgress * Math.PI) * 360;\n    trickLift = -Math.sin(trickProgress * Math.PI) * 45;\n    if (trickProgress >= 1) tricking = false;\n  }\n\n  // Apply 3D Transform to Rider Container\n  const posX = currentX * 110;\n  const posY = currentY * 55 + hoverY + trickLift;\n  riderContainer.style.transform = `translate(${posX}px, ${posY}px) rotateZ(${hoverPitch + trickRot}deg) rotateX(${hoverRoll}deg) rotateY(${-currentX * 10}deg)`;\n\n  // Thruster Particle Generation\n  const rect = riderContainer.getBoundingClientRect();\n  const rearJetX = rect.left + rect.width * 0.31;\n  const rearJetY = rect.top + rect.height * 0.86;\n  const frontJetX = rect.left + rect.width * 0.69;\n  const frontJetY = rect.top + rect.height * 0.84;\n\n  if (Math.random() > (boost ? 0.08 : 0.35)) {\n    const pColor = Math.random() > 0.4 ? '#00f6ff' : (Math.random() > 0.5 ? '#ff00aa' : '#ffffff');\n    const pSpeed = (speed / 80) * 14 + Math.random() * 6;\n    spawnParticle(rearJetX, rearJetY, -pSpeed, (Math.random() - 0.5) * 5, Math.random() * 4 + 2, pColor);\n    spawnParticle(frontJetX, frontJetY, -pSpeed, (Math.random() - 0.5) * 5, Math.random() * 4 + 2, pColor);\n  }\n\n  // Thruster Plume Size Flicker\n  const plumeScale = (boost ? 1.5 : 1.0) + Math.sin(time * 30) * 0.15;\n  rearPlume.setAttribute('transform', `scale(${plumeScale}) translate(${280 * (1 - plumeScale) / plumeScale}, ${440 * (1 - plumeScale) / plumeScale})`);\n  frontPlume.setAttribute('transform', `scale(${plumeScale}) translate(${620 * (1 - plumeScale) / plumeScale}, ${430 * (1 - plumeScale) / plumeScale})`);\n\n  // Ground shadow reaction to height\n  const shadowScale = Math.max(0.4, 1 - (posY / 350));\n  groundShadow.setAttribute('rx', 270 * shadowScale);\n  groundNeon.setAttribute('rx', 220 * shadowScale);\n\n  // Capybara Head Bob (secondary delayed organic motion)\n  const headBob = Math.sin(time * hoverFreq - 0.6) * 3.5;\n  headGroup.setAttribute('transform', `translate(0, ${headBob}) rotate(${hoverPitch * 0.25}, 560, 200)`);\n\n  // Ear Twitch\n  earTwitchTimer += 0.016;\n  let earRot = 0;\n  if (earTwitchTimer > 3.0) {\n    earRot = Math.sin((earTwitchTimer - 3.0) * 25) * 12;\n    if (earTwitchTimer > 3.4) earTwitchTimer = 0;\n  }\n  earGroup.setAttribute('transform', `translate(488, 156) rotate(${earRot}, 12, 18)`);\n\n  // Eye Blink\n  blinkTimer += 0.016;\n  if (blinkTimer > 4.0) {\n    const blinkPhase = (blinkTimer - 4.0) / 0.25;\n    if (blinkPhase <= 1) {\n      const lidY = Math.sin(blinkPhase * Math.PI) * 7.5;\n      eyelidPath.setAttribute('d', `M -14,${lidY} Q 0,${lidY - 8} 14,${lidY - 1} L 14,3 Q 0,-2 -14,3 Z`);\n    } else {\n      blinkTimer = 0;\n      eyelidPath.setAttribute('d', `M -14,0 Q 0,-8 14,-1 L 14,3 Q 0,-2 -14,3 Z`);\n    }\n  }\n\n  // Citrus Orange Jiggle & Leaf Flutter\n  const orangeJiggle = Math.sin(time * hoverFreq * 1.2) * 1.8;\n  citrusFruit.setAttribute('transform', `translate(575, ${134 + headBob + orangeJiggle}) rotate(${-hoverPitch * 0.2}, 0, 0)`);\n  const leafWiggle = Math.sin(time * 22) * 4.5;\n  leafPath.setAttribute('transform', `rotate(${leafWiggle}, 1, -25)`);\n\n  // Dynamic Fluid S-Curve Cloth Flutter Physics for Scarf\n  const waveFreq = boost ? 28 : 16;\n  const waveAmp = boost ? 22 : 12;\n\n  // Streamer 1 (Top / Main)\n  const t = time * waveFreq;\n  const c1x = 390, c1y = 205 + Math.sin(t) * waveAmp;\n  const c2x = 310, c2y = 160 + Math.cos(t) * (waveAmp * 1.3);\n  const c3x = 220, c3y = 175 - Math.sin(t + 0.5) * (waveAmp * 1.4);\n  const tipX = 130, tipY = 150 + Math.sin(t + 1.2) * (waveAmp * 1.6);\n\n  scarfTop.setAttribute('d', \n    `M 452,226 \n     C ${c1x},${c1y - 8} ${c2x},${c2y - 10} ${c3x},${c3y - 6} \n     S ${tipX + 40},${tipY - 4} ${tipX},${tipY} \n     C ${tipX + 35},${tipY + 12} ${c3x},${c3y + 12} ${c2x},${c2y + 10} \n     S ${c1x},${c1y + 12} 450,236 Z`);\n\n  scarfTopH.setAttribute('d', \n    `M 450,228 \n     C ${c1x},${c1y - 5} ${c2x},${c2y - 7} ${c3x},${c3y - 4} \n     S ${tipX + 35},${tipY - 2} ${tipX + 5},${tipY}`);\n\n  // Streamer 2 (Bottom / Secondary with harmonic phase shift)\n  const tb = t + 1.4;\n  const b1x = 400, b1y = 225 + Math.cos(tb) * (waveAmp * 0.9);\n  const b2x = 330, b2y = 190 + Math.sin(tb) * (waveAmp * 1.2);\n  const b3x = 250, b3y = 205 - Math.cos(tb + 0.6) * (waveAmp * 1.3);\n  const bTipX = 170, bTipY = 185 + Math.sin(tb + 1.4) * (waveAmp * 1.5);\n\n  scarfBot.setAttribute('d', \n    `M 454,238 \n     C ${b1x},${b1y - 6} ${b2x},${b2y - 8} ${b3x},${b3y - 5} \n     S ${bTipX + 35},${bTipY - 3} ${bTipX},${bTipY} \n     C ${bTipX + 30},${bTipY + 10} ${b3x},${b3y + 10} ${b2x},${b2y + 8} \n     S ${b1x},${b1y + 10} 452,246 Z`);\n\n  // Render Background\n  drawBackground();\n\n  requestAnimationFrame(animate);\n}\n\nrequestAnimationFrame(animate);\n</script>\n\n</body>\n</html>"
    }
  ]
