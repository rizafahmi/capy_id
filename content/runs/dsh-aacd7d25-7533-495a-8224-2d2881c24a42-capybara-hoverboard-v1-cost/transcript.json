      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Capybara Riding a Hoverboard</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body { height: 100%; }\n  body {\n    margin: 0;\n    overflow: hidden;\n    background: #0b0420;\n    font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  }\n\n  /* ---------------------------------------------------------------- scene */\n  .scene {\n    position: fixed;\n    inset: 0;\n    overflow: hidden;\n    background:\n      linear-gradient(180deg,\n        #07021a 0%,\n        #150a3a 18%,\n        #2f1059 34%,\n        #5d1a6b 47%,\n        #9c2765 56%,\n        #dc4f5f 64%,\n        #f98a4a 74%,\n        #ffc36b 86%,\n        #ffe9a8 96%);\n  }\n\n  /* twinkling star field */\n  .stars {\n    position: absolute;\n    inset: 0 0 40% 0;\n    background-image:\n      radial-gradient(1.7px 1.7px at 30px 46px, rgba(255,255,255,.95), transparent 70%),\n      radial-gradient(1.2px 1.2px at 128px 18px, rgba(178,222,255,.9), transparent 70%),\n      radial-gradient(2.0px 2.0px at 226px 82px, rgba(255,214,255,.85), transparent 70%),\n      radial-gradient(1.3px 1.3px at 318px 34px, rgba(255,255,255,.7), transparent 70%),\n      radial-gradient(1.6px 1.6px at 386px 102px, rgba(255,236,190,.8), transparent 70%),\n      radial-gradient(1.1px 1.1px at 92px 132px, rgba(255,255,255,.6), transparent 70%),\n      radial-gradient(1.5px 1.5px at 268px 158px, rgba(190,230,255,.75), transparent 70%);\n    background-size: 420px 200px;\n    animation: twinkle 3.6s ease-in-out infinite alternate;\n    pointer-events: none;\n  }\n  @keyframes twinkle { from { opacity: .40; } to { opacity: 1; } }\n\n  /* the synthwave sun */\n  .sun {\n    position: absolute;\n    left: 38%;\n    top: 62%;\n    width: min(44vmin, 400px);\n    aspect-ratio: 1;\n    transform: translate(-50%, -100%);\n    border-radius: 50%;\n    background: linear-gradient(180deg,\n      #fffbd0 0%, #ffe083 26%, #ffab63 48%, #ff5f9e 72%, #b52a86 100%);\n    -webkit-mask-image:\n      linear-gradient(180deg, #000 0 42%, transparent 42%),\n      repeating-linear-gradient(180deg, #000 0 15px, transparent 15px 24px);\n    mask-image:\n      linear-gradient(180deg, #000 0 42%, transparent 42%),\n      repeating-linear-gradient(180deg, #000 0 15px, transparent 15px 24px);\n    filter: drop-shadow(0 0 70px rgba(255, 96, 170, .8));\n    animation: sunPulse 7s ease-in-out infinite;\n    pointer-events: none;\n  }\n  @keyframes sunPulse {\n    0%, 100% { filter: drop-shadow(0 0 60px rgba(255, 96, 170, .70)); }\n    50%      { filter: drop-shadow(0 0 92px rgba(255, 140, 90, .95)); }\n  }\n\n  /* drifting clouds */\n  .cloud {\n    position: absolute;\n    border-radius: 999px;\n    background: linear-gradient(180deg, rgba(255,180,220,.55), rgba(140,80,200,.28));\n    filter: blur(14px);\n    opacity: .75;\n    pointer-events: none;\n    animation: drift linear infinite;\n  }\n  .c1 { width: 260px; height: 54px; top: 16%; animation-duration: 46s; animation-delay: -4s; }\n  .c2 { width: 380px; height: 70px; top: 30%; animation-duration: 62s; animation-delay: -26s; }\n  .c3 { width: 190px; height: 40px; top: 8%;  animation-duration: 38s; animation-delay: -18s; }\n  .c4 { width: 320px; height: 62px; top: 41%; animation-duration: 74s; animation-delay: -50s; }\n  @keyframes drift {\n    from { transform: translateX(-45vw) scale(.9); }\n    to   { transform: translateX(115vw) scale(1.15); }\n  }\n\n  /* speed streaks whipping past */\n  .streaks { position: absolute; inset: 0; pointer-events: none; }\n  .streaks i {\n    position: absolute;\n    height: 2px;\n    border-radius: 2px;\n    background: linear-gradient(90deg, transparent, rgba(190,240,255,.85));\n    opacity: 0;\n    animation: whoosh linear infinite;\n  }\n  @keyframes whoosh {\n    0%   { transform: translateX(40vw); opacity: 0; }\n    12%  { opacity: .85; }\n    70%  { opacity: .5; }\n    100% { transform: translateX(-120vw); opacity: 0; }\n  }\n\n  /* ------------------------------------------------------------- horizon  */\n  .ground {\n    position: absolute;\n    inset: 62% 0 0 0;\n    overflow: hidden;\n    background: linear-gradient(180deg, #2a0a48 0%, #1a0430 42%, #0a0116 100%);\n  }\n  .ground::before {\n    content: \"\";\n    position: absolute;\n    left: 0; right: 0; top: -2px; height: 3px;\n    background: linear-gradient(90deg,\n      transparent 0%, #3df0ff 18%, #ff3ea5 48%, #ffd36e 74%, transparent 100%);\n    filter: blur(1px);\n    box-shadow: 0 0 26px rgba(61,240,255,.85), 0 0 60px rgba(255,62,165,.6);\n  }\n  .grid {\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 300%;\n    height: 130%;\n    transform-origin: 50% 0%;\n    transform: perspective(60vh) rotateX(62deg);\n    background-image:\n      linear-gradient(rgba(61,240,255,.95) 2px, transparent 2px),\n      linear-gradient(90deg, rgba(255,62,165,.95) 2px, transparent 2px);\n    background-size: 44px 26px;\n    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 100%);\n    mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 100%);\n    opacity: .8;\n    animation: gridScroll .8s linear infinite;\n  }\n  @keyframes gridScroll {\n    from { background-position: 0 0, 0 0; }\n    to   { background-position: 0 26px, 0 0; }\n  }\n\n  /* --------------------------------------------------------------- rider  */\n  .rider-wrap {\n    position: absolute;\n    left: 50%;\n    top: 62%;\n    width: min(62vmin, 560px);\n    transform: translate(-50%, -84%);\n    z-index: 6;\n    animation: bob 3.4s ease-in-out infinite;\n  }\n  @keyframes bob {\n    0%, 100% { transform: translate(-50%, -84%); }\n    50%      { transform: translate(-50%, -90%); }\n  }\n  .rider { display: block; width: 100%; height: auto; overflow: visible; }\n\n  /* whole craft tilts gently as it floats */\n  .floaty {\n    transform-box: view-box;\n    transform-origin: 230px 320px;\n    animation: tilt 4.2s ease-in-out infinite;\n  }\n  @keyframes tilt {\n    0%, 100% { transform: rotate(-2.2deg); }\n    50%      { transform: rotate(2.2deg); }\n  }\n\n  /* legs */\n  .leg {\n    transform-box: fill-box;\n    transform-origin: 50% 6%;\n    animation: step 1.7s ease-in-out infinite;\n  }\n  .leg-b { animation-delay: -0.85s; }\n  @keyframes step {\n    0%, 100% { transform: rotate(-4deg); }\n    50%      { transform: rotate(4deg); }\n  }\n\n  /* head, ears, blink */\n  .head {\n    transform-box: fill-box;\n    transform-origin: 12% 70%;\n    animation: look 5.6s ease-in-out infinite;\n  }\n  @keyframes look {\n    0%, 100% { transform: rotate(-1.6deg); }\n    50%      { transform: rotate(2.4deg); }\n  }\n  .ear {\n    transform-box: fill-box;\n    transform-origin: 50% 92%;\n    animation: earTwitch 6.4s ease-in-out infinite;\n  }\n  .ear-b { animation-delay: -1.1s; }\n  @keyframes earTwitch {\n    0%, 78%, 100% { transform: rotate(0deg); }\n    84%           { transform: rotate(-15deg); }\n    90%           { transform: rotate(9deg); }\n    94%           { transform: rotate(-4deg); }\n  }\n  .eye { transform-box: fill-box; transform-origin: 50% 50%; animation: blink 5.2s infinite; }\n  @keyframes blink {\n    0%, 90%, 100% { transform: scaleY(1); }\n    94%           { transform: scaleY(.08); }\n  }\n  .brow { animation: brow 3.6s ease-in-out infinite; }\n  @keyframes brow {\n    0%, 100% { transform: translateY(0); }\n    50%      { transform: translateY(-2px); }\n  }\n\n  /* scarf tails fluttering in the wind */\n  .scarf {\n    transform-box: fill-box;\n    transform-origin: 88% 40%;\n    animation: flutter 1.5s ease-in-out infinite;\n  }\n  .scarf-b { animation-duration: 1.9s; animation-delay: -0.6s; }\n  @keyframes flutter {\n    0%, 100% { transform: rotate(-5deg) skewY(-2deg); }\n    50%      { transform: rotate(6deg) skewY(3deg); }\n  }\n\n  /* hoverboard energy */\n  .beam { animation: beamPulse 1.8s ease-in-out infinite; transform-box: fill-box; transform-origin: 50% 0%; }\n  @keyframes beamPulse {\n    0%, 100% { opacity: .55; transform: scaleY(.9) scaleX(.96); }\n    50%      { opacity: .95; transform: scaleY(1.12) scaleX(1.02); }\n  }\n  .board {\n    transform-box: fill-box;\n    transform-origin: 50% 50%;\n    animation: boardHum 1.2s ease-in-out infinite;\n  }\n  @keyframes boardHum {\n    0%, 100% { transform: translateY(0) rotate(-.5deg); }\n    50%      { transform: translateY(-2.5px) rotate(.5deg); }\n  }\n  .underGlow { animation: underGlow 1.6s ease-in-out infinite; }\n  @keyframes underGlow {\n    0%, 100% { opacity: .6; }\n    50%      { opacity: 1; }\n  }\n\n  /* exhaust puffs */\n  .puff {\n    transform-box: fill-box;\n    transform-origin: 50% 50%;\n    animation: puff 1.5s ease-out infinite;\n  }\n  @keyframes puff {\n    0%   { transform: translate(0, 0) scale(.5); opacity: 0; }\n    14%  { opacity: .95; }\n    100% { transform: translate(-120px, 74px) scale(1.6); opacity: 0; }\n  }\n\n  /* ------------------------------------------------------------- overlays */\n  .vignette {\n    position: absolute; inset: 0; pointer-events: none; z-index: 9;\n    background: radial-gradient(115% 85% at 50% 44%, transparent 52%, rgba(4,0,18,.78) 100%);\n  }\n  .scanlines {\n    position: absolute; inset: 0; pointer-events: none; z-index: 10; opacity: .35;\n    background: repeating-linear-gradient(180deg,\n      rgba(255,255,255,.045) 0 1px, transparent 1px 3px);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    * { animation-duration: 6s !important; animation-iteration-count: 1 !important; }\n  }\n</style>\n</head>\n<body>\n<div class=\"scene\">\n\n  <div class=\"stars\"></div>\n\n  <div class=\"cloud c1\"></div>\n  <div class=\"cloud c2\"></div>\n  <div class=\"cloud c3\"></div>\n  <div class=\"cloud c4\"></div>\n\n  <div class=\"sun\"></div>\n\n  <div class=\"streaks\">\n    <i style=\"top:12%; width:120px; left:10%; animation-duration:1.5s; animation-delay:-0.2s\"></i>\n    <i style=\"top:22%; width:220px; left:30%; animation-duration:2.0s; animation-delay:-1.1s\"></i>\n    <i style=\"top:31%; width:90px;  left:60%; animation-duration:1.2s; animation-delay:-0.7s\"></i>\n    <i style=\"top:44%; width:180px; left:20%; animation-duration:1.8s; animation-delay:-1.5s\"></i>\n    <i style=\"top:52%; width:140px; left:70%; animation-duration:1.4s; animation-delay:-0.4s\"></i>\n    <i style=\"top:66%; width:260px; left:45%; animation-duration:2.3s; animation-delay:-1.9s\"></i>\n    <i style=\"top:76%; width:110px; left:15%; animation-duration:1.1s; animation-delay:-0.9s\"></i>\n    <i style=\"top:86%; width:200px; left:55%; animation-duration:1.7s; animation-delay:-1.3s\"></i>\n  </div>\n\n  <div class=\"ground\">\n    <div class=\"grid\"></div>\n  </div>\n\n  <div class=\"rider-wrap\">\n    <svg class=\"rider\" viewBox=\"0 0 460 400\" role=\"img\" aria-label=\"An animated capybara riding a glowing hoverboard\">\n      <defs>\n        <linearGradient id=\"furGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#cd9a5c\"/>\n          <stop offset=\"0.5\" stop-color=\"#ac763d\"/>\n          <stop offset=\"1\" stop-color=\"#8a5a2b\"/>\n        </linearGradient>\n        <linearGradient id=\"furLight\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#e6bd88\"/>\n          <stop offset=\"1\" stop-color=\"#c1914f\"/>\n        </linearGradient>\n        <linearGradient id=\"furDark\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#8d5e2d\"/>\n          <stop offset=\"1\" stop-color=\"#6a431f\"/>\n        </linearGradient>\n        <linearGradient id=\"boardGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n          <stop offset=\"0\" stop-color=\"#141a55\"/>\n          <stop offset=\"0.5\" stop-color=\"#3744cc\"/>\n          <stop offset=\"1\" stop-color=\"#141a55\"/>\n        </linearGradient>\n        <linearGradient id=\"boardTop\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n          <stop offset=\"0\" stop-color=\"#3df0ff\"/>\n          <stop offset=\"0.5\" stop-color=\"#a8fbff\"/>\n          <stop offset=\"1\" stop-color=\"#3df0ff\"/>\n        </linearGradient>\n        <linearGradient id=\"boardBottom\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n          <stop offset=\"0\" stop-color=\"#ff3ea5\"/>\n          <stop offset=\"0.5\" stop-color=\"#ff9ad0\"/>\n          <stop offset=\"1\" stop-color=\"#ff3ea5\"/>\n        </linearGradient>\n        <radialGradient id=\"glowGrad\">\n          <stop offset=\"0\" stop-color=\"#8dfbff\" stop-opacity=\"0.95\"/>\n          <stop offset=\"0.45\" stop-color=\"#3df0ff\" stop-opacity=\"0.42\"/>\n          <stop offset=\"1\" stop-color=\"#3df0ff\" stop-opacity=\"0\"/>\n        </radialGradient>\n        <radialGradient id=\"padGrad\">\n          <stop offset=\"0\" stop-color=\"#ff9ad0\" stop-opacity=\"0.9\"/>\n          <stop offset=\"1\" stop-color=\"#ff3ea5\" stop-opacity=\"0\"/>\n        </radialGradient>\n        <filter id=\"glow\" x=\"-70%\" y=\"-70%\" width=\"240%\" height=\"240%\">\n          <feGaussianBlur stdDeviation=\"5\" result=\"b\"/>\n          <feMerge>\n            <feMergeNode in=\"b\"/>\n            <feMergeNode in=\"SourceGraphic\"/>\n          </feMerge>\n        </filter>\n        <filter id=\"softGlow\" x=\"-120%\" y=\"-120%\" width=\"340%\" height=\"340%\">\n          <feGaussianBlur stdDeviation=\"16\"/>\n        </filter>\n      </defs>\n\n      <g class=\"floaty\">\n\n        <!-- hoverboard under-glow / energy field -->\n        <ellipse class=\"beam\" cx=\"230\" cy=\"352\" rx=\"152\" ry=\"42\" fill=\"url(#glowGrad)\"/>\n        <ellipse cx=\"230\" cy=\"336\" rx=\"118\" ry=\"14\" fill=\"url(#padGrad)\" filter=\"url(#softGlow)\"/>\n\n        <!-- exhaust puffs -->\n        <g class=\"puffs\">\n          <circle class=\"puff\" cx=\"132\" cy=\"330\" r=\"7\" fill=\"#7ef9ff\" style=\"animation-delay:-0.0s\"/>\n          <circle class=\"puff\" cx=\"170\" cy=\"336\" r=\"5\" fill=\"#a8fbff\" style=\"animation-delay:-0.25s\"/>\n          <circle class=\"puff\" cx=\"214\" cy=\"332\" r=\"8\" fill=\"#3df0ff\" style=\"animation-delay:-0.5s\"/>\n          <circle class=\"puff\" cx=\"258\" cy=\"338\" r=\"5\" fill=\"#ff9ad0\" style=\"animation-delay:-0.75s\"/>\n          <circle class=\"puff\" cx=\"298\" cy=\"331\" r=\"7\" fill=\"#7ef9ff\" style=\"animation-delay:-1.0s\"/>\n          <circle class=\"puff\" cx=\"336\" cy=\"337\" r=\"5\" fill=\"#a8fbff\" style=\"animation-delay:-1.25s\"/>\n        </g>\n\n        <!-- ------------------------------- behind-body legs ------------------------------- -->\n        <g transform=\"translate(150,198)\">\n          <g class=\"leg leg-a\">\n            <rect x=\"-16\" y=\"-12\" width=\"32\" height=\"106\" rx=\"16\" fill=\"url(#furDark)\"/>\n            <ellipse cx=\"0\" cy=\"90\" rx=\"20\" ry=\"13\" fill=\"#5c3a18\"/>\n          </g>\n        </g>\n        <g transform=\"translate(198,206)\">\n          <g class=\"leg leg-b\">\n            <rect x=\"-16\" y=\"-12\" width=\"32\" height=\"100\" rx=\"16\" fill=\"url(#furDark)\"/>\n            <ellipse cx=\"0\" cy=\"84\" rx=\"20\" ry=\"13\" fill=\"#5c3a18\"/>\n          </g>\n        </g>\n\n        <!-- ------------------------------- scarf tails ------------------------------- -->\n        <g class=\"scarf\">\n          <path d=\"M292,104 C246,86 206,92 158,70 C186,108 240,124 296,126 Z\" fill=\"#e8433f\"/>\n        </g>\n        <g class=\"scarf scarf-b\">\n          <path d=\"M294,120 C252,110 214,120 168,102 C196,142 248,152 298,146 Z\" fill=\"#c9302f\"/>\n        </g>\n\n        <!-- ------------------------------- body ------------------------------- -->\n        <ellipse cx=\"232\" cy=\"152\" rx=\"122\" ry=\"72\" fill=\"url(#furGrad)\"/>\n        <ellipse cx=\"238\" cy=\"186\" rx=\"98\" ry=\"44\" fill=\"url(#furLight)\" opacity=\"0.55\"/>\n        <ellipse cx=\"196\" cy=\"112\" rx=\"72\" ry=\"30\" fill=\"#ffffff\" opacity=\"0.09\"/>\n\n        <!-- ------------------------------- head ------------------------------- -->\n        <g class=\"head\">\n          <g transform=\"translate(312,76)\">\n            <g class=\"ear ear-a\">\n              <ellipse rx=\"17\" ry=\"21\" transform=\"rotate(-16)\" fill=\"#8a5a2b\"/>\n              <ellipse rx=\"9\" ry=\"12\" transform=\"rotate(-16)\" fill=\"#5f3d1b\"/>\n            </g>\n          </g>\n          <g transform=\"translate(348,70)\">\n            <g class=\"ear ear-b\">\n              <ellipse rx=\"17\" ry=\"21\" transform=\"rotate(8)\" fill=\"#9c6933\"/>\n              <ellipse rx=\"9\" ry=\"12\" transform=\"rotate(8)\" fill=\"#5f3d1b\"/>\n            </g>\n          </g>\n\n          <!-- skull + muzzle -->\n          <ellipse cx=\"328\" cy=\"126\" rx=\"70\" ry=\"60\" fill=\"url(#furGrad)\"/>\n          <ellipse cx=\"300\" cy=\"150\" rx=\"52\" ry=\"42\" fill=\"url(#furLight)\" opacity=\"0.45\"/>\n          <ellipse cx=\"392\" cy=\"148\" rx=\"44\" ry=\"34\" fill=\"url(#furLight)\"/>\n          <ellipse cx=\"416\" cy=\"150\" rx=\"20\" ry=\"17\" fill=\"#b0803f\"/>\n\n          <!-- nose + mouth -->\n          <ellipse cx=\"428\" cy=\"136\" rx=\"9\" ry=\"6.5\" fill=\"#40260f\"/>\n          <ellipse cx=\"425\" cy=\"133\" rx=\"3\" ry=\"2\" fill=\"#ffffff\" opacity=\"0.45\"/>\n          <path d=\"M408,154 q16,10 30,1\" stroke=\"#4d2d13\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n          <path d=\"M398,166 q10,8 22,4\" stroke=\"#7a4a22\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\" opacity=\"0.7\"/>\n\n          <!-- eye -->\n          <g class=\"eye\">\n            <ellipse cx=\"360\" cy=\"112\" rx=\"11\" ry=\"12\" fill=\"#241305\"/>\n            <circle cx=\"356\" cy=\"107\" r=\"4\" fill=\"#ffffff\" opacity=\"0.9\"/>\n            <circle cx=\"364\" cy=\"117\" r=\"1.8\" fill=\"#ffffff\" opacity=\"0.5\"/>\n          </g>\n          <path class=\"brow\" d=\"M350,92 q12,-7 24,-2\" stroke=\"#5c3a18\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/>\n\n          <!-- whiskers -->\n          <g stroke=\"#f4e2c8\" stroke-width=\"1.8\" stroke-linecap=\"round\" opacity=\"0.55\">\n            <path d=\"M414,150 l-30,-10\"/>\n            <path d=\"M414,156 l-32,2\"/>\n            <path d=\"M412,162 l-28,12\"/>\n          </g>\n        </g>\n\n        <!-- ------------------------------- front legs ------------------------------- -->\n        <g transform=\"translate(288,206)\">\n          <g class=\"leg leg-b\">\n            <rect x=\"-16\" y=\"-12\" width=\"32\" height=\"102\" rx=\"16\" fill=\"url(#furGrad)\"/>\n            <ellipse cx=\"0\" cy=\"86\" rx=\"20\" ry=\"13\" fill=\"#6b4420\"/>\n          </g>\n        </g>\n        <g transform=\"translate(336,200)\">\n          <g class=\"leg leg-a\">\n            <rect x=\"-16\" y=\"-12\" width=\"32\" height=\"106\" rx=\"16\" fill=\"url(#furGrad)\"/>\n            <ellipse cx=\"0\" cy=\"90\" rx=\"20\" ry=\"13\" fill=\"#6b4420\"/>\n          </g>\n        </g>\n\n        <!-- ------------------------------- hoverboard ------------------------------- -->\n        <g class=\"board\">\n          <rect x=\"88\" y=\"296\" width=\"284\" height=\"28\" rx=\"14\" fill=\"url(#boardGrad)\"/>\n          <rect x=\"96\" y=\"299\" width=\"268\" height=\"9\" rx=\"4.5\" fill=\"url(#boardTop)\" filter=\"url(#glow)\"/>\n          <rect x=\"104\" y=\"316\" width=\"252\" height=\"6\" rx=\"3\" fill=\"url(#boardBottom)\" class=\"underGlow\" filter=\"url(#glow)\"/>\n          <ellipse cx=\"230\" cy=\"310\" rx=\"26\" ry=\"6\" fill=\"#ffffff\" opacity=\"0.18\"/>\n        </g>\n\n      </g>\n    </svg>\n  </div>\n\n  <div class=\"vignette\"></div>\n  <div class=\"scanlines\"></div>\n</div>\n</body>\n</html>"
    }
