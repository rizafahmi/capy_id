      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>Capyboard - The Chillest Hoverboard in the Multiverse</title>\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n  html, body {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #060312;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif;\n  }\n  #canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    display: block;\n  }\n  .hud {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 20px 24px;\n    z-index: 10;\n  }\n  .hud-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n  }\n  .hud-card {\n    background: rgba(14, 9, 28, 0.75);\n    border: 1px solid rgba(0, 240, 255, 0.35);\n    box-shadow: 0 0 16px rgba(0, 240, 255, 0.18), inset 0 0 16px rgba(0, 240, 255, 0.06);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    border-radius: 14px;\n    padding: 12px 18px;\n    color: #fff;\n  }\n  .hud-title {\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: #00f0ff;\n    margin-bottom: 6px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);\n  }\n  .meter-bar-container {\n    width: 190px;\n    height: 13px;\n    background: rgba(255, 255, 255, 0.08);\n    border-radius: 7px;\n    overflow: hidden;\n    position: relative;\n    border: 1px solid rgba(255, 0, 128, 0.45);\n  }\n  .meter-fill {\n    height: 100%;\n    width: 85%;\n    background: linear-gradient(90deg, #ff007f, #00f0ff, #ffe600);\n    border-radius: 7px;\n    box-shadow: 0 0 12px #00f0ff;\n    transition: width 0.25s cubic-bezier(0.2, 0.8, 0.3, 1);\n  }\n  .meter-label {\n    margin-top: 5px;\n    font-size: 11px;\n    font-weight: 800;\n    color: #ffe600;\n    letter-spacing: 1.5px;\n    display: flex;\n    justify-content: space-between;\n    text-shadow: 0 0 6px rgba(255, 230, 0, 0.4);\n  }\n  .stats-cluster {\n    display: flex;\n    gap: 14px;\n  }\n  .stat-box {\n    text-align: right;\n    min-width: 100px;\n  }\n  .stat-val {\n    font-size: 24px;\n    font-weight: 900;\n    font-family: monospace, monospace;\n    letter-spacing: 1.5px;\n    color: #fff;\n    text-shadow: 0 0 12px rgba(0, 240, 255, 0.7);\n  }\n  .hud-bottom {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n  }\n  .controls-hint {\n    background: rgba(10, 6, 22, 0.82);\n    border: 1px solid rgba(255, 0, 128, 0.35);\n    border-radius: 22px;\n    padding: 8px 18px;\n    color: rgba(255, 255, 255, 0.85);\n    font-size: 11.5px;\n    letter-spacing: 1px;\n    display: flex;\n    gap: 16px;\n    box-shadow: 0 0 18px rgba(255, 0, 128, 0.18);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n  }\n  .key {\n    background: rgba(255, 255, 255, 0.14);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    padding: 2px 7px;\n    border-radius: 4px;\n    color: #00f0ff;\n    font-weight: 800;\n    font-size: 11px;\n  }\n  .hud-buttons {\n    pointer-events: auto;\n    display: flex;\n    gap: 10px;\n  }\n  .cyber-btn {\n    background: linear-gradient(135deg, rgba(255, 0, 128, 0.25), rgba(0, 240, 255, 0.25));\n    border: 1px solid rgba(0, 240, 255, 0.65);\n    color: #fff;\n    font-weight: 800;\n    font-size: 12px;\n    letter-spacing: 1.2px;\n    padding: 10px 16px;\n    border-radius: 10px;\n    cursor: pointer;\n    box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);\n    transition: all 0.15s ease;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    backdrop-filter: blur(6px);\n    -webkit-backdrop-filter: blur(6px);\n  }\n  .cyber-btn:hover {\n    background: linear-gradient(135deg, rgba(255, 0, 128, 0.55), rgba(0, 240, 255, 0.55));\n    box-shadow: 0 0 20px rgba(0, 240, 255, 0.7);\n    transform: translateY(-2px);\n    border-color: #ffe600;\n  }\n  .cyber-btn:active {\n    transform: translateY(1px);\n    box-shadow: 0 0 8px rgba(0, 240, 255, 0.5);\n  }\n  @media (max-width: 820px) {\n    .controls-hint { display: none; }\n    .hud { padding: 12px 14px; }\n    .meter-bar-container { width: 130px; }\n    .stat-val { font-size: 18px; }\n    .stat-box { min-width: 75px; }\n    .cyber-btn { padding: 8px 12px; font-size: 11px; }\n  }\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n\n<div class=\"hud\">\n  <div class=\"hud-top\">\n    <div class=\"hud-card\">\n      <div class=\"hud-title\">⚡ CHILL DYNAMICS ⚡</div>\n      <div class=\"meter-bar-container\">\n        <div class=\"meter-fill\" id=\"meterFill\"></div>\n      </div>\n      <div class=\"meter-label\">\n        <span>VIBES</span>\n        <span id=\"meterText\">MAX CHILL</span>\n      </div>\n    </div>\n\n    <div class=\"stats-cluster\">\n      <div class=\"hud-card stat-box\">\n        <div class=\"hud-title\">🍊 YUZUS</div>\n        <div class=\"stat-val\" id=\"yuzuCount\">0</div>\n      </div>\n      <div class=\"hud-card stat-box\">\n        <div class=\"hud-title\">🚀 SPEED</div>\n        <div class=\"stat-val\" id=\"speedVal\">88 <span style=\"font-size:12px;color:#00f0ff;\">MPH</span></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"hud-bottom\">\n    <div class=\"controls-hint\">\n      <span><span class=\"key\">MOUSE / A D</span> Steer</span>\n      <span><span class=\"key\">SPACE</span> Ollie / Flip</span>\n      <span><span class=\"key\">SHIFT</span> Hyper Boost</span>\n      <span><span class=\"key\">G</span> Shades</span>\n      <span><span class=\"key\">C</span> Theme</span>\n    </div>\n\n    <div class=\"hud-buttons\">\n      <button class=\"cyber-btn\" id=\"btnJump\">🛹 OLLIE</button>\n      <button class=\"cyber-btn\" id=\"btnBoost\">⚡ BOOST</button>\n      <button class=\"cyber-btn\" id=\"btnShades\">😎 SHADES</button>\n      <button class=\"cyber-btn\" id=\"btnTheme\">🎨 THEME</button>\n    </div>\n  </div>\n</div>\n\n<script>\n// --- Canvas Setup ---\nconst canvas = document.getElementById('canvas');\nconst ctx = canvas.getContext('2d');\nlet W = window.innerWidth;\nlet H = window.innerHeight;\nlet dpr = Math.min(window.devicePixelRatio || 1, 2);\n\nfunction resize() {\n  W = window.innerWidth;\n  H = window.innerHeight;\n  canvas.width = Math.floor(W * dpr);\n  canvas.height = Math.floor(H * dpr);\n}\nwindow.addEventListener('resize', resize);\nresize();\n\n// --- Themes Palette ---\nconst THEMES = [\n  {\n    name: 'Synthwave Sunset',\n    skyTop: '#080315',\n    skyMid1: '#1b0933',\n    skyMid2: '#5c0f52',\n    skyMid3: '#9e2161',\n    skyBottom: '#ff5c39',\n    sunTop: '#fff59d',\n    sunMid: '#ff4081',\n    sunBottom: '#6a0080',\n    gridBase: '#0a011a',\n    gridLines: '#00f0ff',\n    gridRadials: 'rgba(255, 0, 128, 0.45)',\n    mountainFar: '#1c0c36',\n    mountainFarLine: '#ff007f',\n    mountainNear: '#100522',\n    mountainNearLine: '#00f0ff',\n    scarfColor: '#ff007f',\n    scarfTrim: '#ffe600',\n    palmSilhouette: '#0d041e',\n    neonAccent: '#00f0ff'\n  },\n  {\n    name: 'Cyber Midnight',\n    skyTop: '#020b14',\n    skyMid1: '#051b2c',\n    skyMid2: '#0b3d4f',\n    skyMid3: '#086e7d',\n    skyBottom: '#00f0ff',\n    sunTop: '#e0ffff',\n    sunMid: '#00e5ff',\n    sunBottom: '#004d61',\n    gridBase: '#020a12',\n    gridLines: '#00f0ff',\n    gridRadials: 'rgba(0, 240, 255, 0.45)',\n    mountainFar: '#051926',\n    mountainFarLine: '#00e5ff',\n    mountainNear: '#030e17',\n    mountainNearLine: '#39ff14',\n    scarfColor: '#00f0ff',\n    scarfTrim: '#39ff14',\n    palmSilhouette: '#020d18',\n    neonAccent: '#39ff14'\n  },\n  {\n    name: 'Solar Euphoria',\n    skyTop: '#14050b',\n    skyMid1: '#2e0a16',\n    skyMid2: '#691522',\n    skyMid3: '#b32e1e',\n    skyBottom: '#ffa726',\n    sunTop: '#ffffff',\n    sunMid: '#ffeb3b',\n    sunBottom: '#d84315',\n    gridBase: '#120409',\n    gridLines: '#ffb300',\n    gridRadials: 'rgba(255, 61, 0, 0.45)',\n    mountainFar: '#2b0914',\n    mountainFarLine: '#ff5252',\n    mountainNear: '#19040a',\n    mountainNearLine: '#ffab00',\n    scarfColor: '#ff3d00',\n    scarfTrim: '#ffea00',\n    palmSilhouette: '#1a040b',\n    neonAccent: '#ffe600'\n  }\n];\nlet currentThemeIndex = 0;\n\n// --- State ---\nconst state = {\n  time: 0,\n  speed: 1.0,\n  boost: false,\n  score: 0,\n  yuzusCollected: 0,\n  chillLevel: 90,\n  showShades: true,\n  lastUserInput: 0,\n  \n  // Capybara rider dynamics\n  rider: {\n    x: 0, // normalized -1 to 1\n    targetX: 0,\n    yOffset: 0, // jump offset\n    vy: 0,\n    isJumping: false,\n    jumpCount: 0,\n    tilt: 0,\n    spinAngle: 0,\n    isTricking: false\n  },\n\n  roadZ: 0,\n  vanishingYRatio: 0.56\n};\n\n// Particles, Texts, Collectibles, Roadside Palms, Speed Streaks\nconst particles = [];\nconst floatingTexts = [];\nconst collectibles = [];\nconst speedStreaks = [];\nconst roadPalms = [];\n\n// Initialize speed streaks\nfor (let i = 0; i < 50; i++) {\n  speedStreaks.push({\n    x: (Math.random() - 0.5) * 2.4,\n    y: Math.random() * 0.95 + 0.05,\n    z: Math.random() * 900 + 40,\n    len: Math.random() * 45 + 20,\n    speed: Math.random() * 0.5 + 0.8\n  });\n}\n\n// Initialize Roadside Palms (Left and Right shoulders)\nfor (let i = 0; i < 8; i++) {\n  roadPalms.push({\n    side: i % 2 === 0 ? -1 : 1,\n    z: (i / 8) * 1200 + 100\n  });\n}\n\n// Spawn Collectibles\nfunction spawnCollectible() {\n  if (collectibles.length < 5) {\n    const lane = (Math.random() - 0.5) * 1.6;\n    collectibles.push({\n      lane: lane,\n      z: 1200 + Math.random() * 400,\n      type: Math.random() > 0.35 ? 'yuzu' : 'gem',\n      rot: Math.random() * Math.PI * 2,\n      bobOffset: Math.random() * 10\n    });\n  }\n}\n\n// Add Floating Popup\nfunction addFloatingText(text, x, y, color = '#ffe600') {\n  floatingTexts.push({\n    text: text,\n    x: x,\n    y: y,\n    vy: -2.4,\n    alpha: 1,\n    scale: 0.75,\n    targetScale: 1.25,\n    color: color\n  });\n}\n\n// Thruster Ember Particle\nfunction emitThrusterParticles(originX, originY, isBoost) {\n  const count = isBoost ? 6 : 3;\n  for (let i = 0; i < count; i++) {\n    const angle = Math.PI + (Math.random() - 0.5) * 0.5;\n    const speed = (isBoost ? 16 : 9) * (0.8 + Math.random() * 0.5);\n    particles.push({\n      x: originX,\n      y: originY + (Math.random() - 0.5) * 12,\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed * 0.25 + (Math.random() - 0.5) * 1.8,\n      size: (isBoost ? 6 : 4) * (0.6 + Math.random() * 0.6),\n      life: 1.0,\n      decay: Math.random() * 0.035 + 0.02,\n      color: Math.random() > 0.4 ? '#00f0ff' : '#ff007f'\n    });\n  }\n}\n\n// Starburst Fireworks\nfunction emitStarburst(x, y, color = '#ffe600') {\n  for (let i = 0; i < 22; i++) {\n    const angle = Math.random() * Math.PI * 2;\n    const speed = Math.random() * 9 + 3;\n    particles.push({\n      x: x,\n      y: y,\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed,\n      size: Math.random() * 5 + 3,\n      life: 1.0,\n      decay: Math.random() * 0.04 + 0.02,\n      color: color\n    });\n  }\n}\n\n// Ollie / Jump / Trick\nfunction triggerJump() {\n  const r = state.rider;\n  state.lastUserInput = performance.now();\n  if (!r.isJumping) {\n    r.isJumping = true;\n    r.vy = -16.5;\n    r.jumpCount = 1;\n    addFloatingText('OLLIE! 🛹', W * 0.5 + r.x * W * 0.35, H * 0.6 + r.yOffset - 60, '#00f0ff');\n    emitStarburst(W * 0.5 + r.x * W * 0.35, H * 0.68, '#00f0ff');\n  } else if (r.jumpCount === 1) {\n    // Air Flip trick!\n    r.jumpCount = 2;\n    r.vy = -13;\n    r.isTricking = true;\n    r.spinAngle = 0;\n    state.chillLevel = Math.min(100, state.chillLevel + 15);\n    addFloatingText('⚡ 360° HOVER-FLIP! +500 ⚡', W * 0.5 + r.x * W * 0.35, H * 0.6 + r.yOffset - 80, '#ffe600');\n    emitStarburst(W * 0.5 + r.x * W * 0.35, H * 0.6 + r.yOffset, '#ff007f');\n  }\n}\n\n// User Controls Listeners\nwindow.addEventListener('mousemove', (e) => {\n  const normalized = (e.clientX / W - 0.5) * 2;\n  state.rider.targetX = Math.max(-0.95, Math.min(0.95, normalized));\n  state.lastUserInput = performance.now();\n});\n\nwindow.addEventListener('touchmove', (e) => {\n  if (e.touches.length > 0) {\n    const t = e.touches[0];\n    const normalized = (t.clientX / W - 0.5) * 2;\n    state.rider.targetX = Math.max(-0.95, Math.min(0.95, normalized));\n    state.lastUserInput = performance.now();\n  }\n}, { passive: true });\n\nwindow.addEventListener('keydown', (e) => {\n  state.lastUserInput = performance.now();\n  if (e.code === 'Space') {\n    e.preventDefault();\n    triggerJump();\n  } else if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.key.toLowerCase() === 'b') {\n    state.boost = true;\n  } else if (e.key.toLowerCase() === 'a' || e.key === 'ArrowLeft') {\n    state.rider.targetX = Math.max(-0.95, state.rider.targetX - 0.25);\n  } else if (e.key.toLowerCase() === 'd' || e.key === 'ArrowRight') {\n    state.rider.targetX = Math.min(0.95, state.rider.targetX + 0.25);\n  } else if (e.key.toLowerCase() === 'g') {\n    state.showShades = !state.showShades;\n    addFloatingText(state.showShades ? 'SHADES ON 😎' : 'BARE EYES 🐾', W * 0.5, H * 0.45, '#00f0ff');\n  } else if (e.key.toLowerCase() === 'c') {\n    currentThemeIndex = (currentThemeIndex + 1) % THEMES.length;\n    addFloatingText(THEMES[currentThemeIndex].name.toUpperCase(), W * 0.5, H * 0.45, '#ff007f');\n  } else if (e.key.toLowerCase() === 't') {\n    triggerJump();\n    if (state.rider.jumpCount === 1) triggerJump();\n  }\n});\n\nwindow.addEventListener('keyup', (e) => {\n  if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.key.toLowerCase() === 'b') {\n    state.boost = false;\n  }\n});\n\ncanvas.addEventListener('click', () => {\n  triggerJump();\n});\n\n// HUD Buttons\ndocument.getElementById('btnJump').addEventListener('click', (e) => {\n  e.stopPropagation();\n  triggerJump();\n});\n\nconst btnBoost = document.getElementById('btnBoost');\nbtnBoost.addEventListener('mousedown', (e) => { e.stopPropagation(); state.boost = true; });\nbtnBoost.addEventListener('mouseup', (e) => { e.stopPropagation(); state.boost = false; });\nbtnBoost.addEventListener('touchstart', (e) => { e.stopPropagation(); state.boost = true; }, { passive: false });\nbtnBoost.addEventListener('touchend', (e) => { e.stopPropagation(); state.boost = false; }, { passive: false });\n\ndocument.getElementById('btnShades').addEventListener('click', (e) => {\n  e.stopPropagation();\n  state.showShades = !state.showShades;\n  addFloatingText(state.showShades ? 'SHADES ON 😎' : 'BARE EYES 🐾', W * 0.5, H * 0.45, '#00f0ff');\n});\n\ndocument.getElementById('btnTheme').addEventListener('click', (e) => {\n  e.stopPropagation();\n  currentThemeIndex = (currentThemeIndex + 1) % THEMES.length;\n  addFloatingText(THEMES[currentThemeIndex].name.toUpperCase(), W * 0.5, H * 0.45, '#ff007f');\n});\n\n// --- Physics & Updates ---\nlet lastTime = performance.now();\n\nfunction update(dt) {\n  state.time += dt;\n\n  // Auto chill slalom cruise if idle for 2.5s\n  if (performance.now() - state.lastUserInput > 2500) {\n    state.rider.targetX = Math.sin(state.time * 0.75) * 0.35;\n  }\n\n  // Speed and Boost Lerp\n  const targetSpeed = state.boost ? 2.3 : 1.0;\n  state.speed += (targetSpeed - state.speed) * 0.08;\n\n  // Road grid scrolling\n  state.roadZ = (state.roadZ + state.speed * dt * 480) % 200;\n\n  // Rider position lerp\n  const r = state.rider;\n  r.x += (r.targetX - r.x) * 0.12;\n\n  // Lean / bank angle\n  const targetTilt = (r.targetX - r.x) * 0.85;\n  r.tilt += (targetTilt - r.tilt) * 0.15;\n\n  // Jump physics\n  if (r.isJumping) {\n    r.yOffset += r.vy;\n    r.vy += 0.88;\n    if (r.yOffset >= 0) {\n      r.yOffset = 0;\n      r.vy = 0;\n      r.isJumping = false;\n      r.isTricking = false;\n      r.spinAngle = 0;\n      r.jumpCount = 0;\n      emitStarburst(W * 0.5 + r.x * W * 0.35, H * 0.68, '#00f0ff');\n    }\n  }\n\n  // Trick Flip spin\n  if (r.isTricking) {\n    r.spinAngle += dt * 14;\n    if (r.spinAngle >= Math.PI * 2) {\n      r.spinAngle = Math.PI * 2;\n    }\n  }\n\n  // Spawn collectible\n  if (Math.random() < 0.022) {\n    spawnCollectible();\n  }\n\n  // Roadside Palms scrolling\n  for (let palm of roadPalms) {\n    palm.z -= state.speed * dt * 480;\n    if (palm.z <= 10) {\n      palm.z = 1200;\n    }\n  }\n\n  // Collectibles update & check collision\n  const riderScreenX = r.x * (W * 0.35);\n  for (let i = collectibles.length - 1; i >= 0; i--) {\n    const c = collectibles[i];\n    c.z -= state.speed * dt * 520;\n    c.rot += dt * 3.2;\n\n    if (c.z < 180 && c.z > 20) {\n      const itemScreenX = c.lane * (W * 0.35);\n      if (Math.abs(itemScreenX - riderScreenX) < 85 && Math.abs(r.yOffset) < 95) {\n        if (c.type === 'yuzu') {\n          state.yuzusCollected++;\n          state.score += 250;\n          state.chillLevel = Math.min(100, state.chillLevel + 10);\n          addFloatingText('+250 🍊 JUICY!', W * 0.5 + riderScreenX, H * 0.55 + r.yOffset, '#ffe600');\n          emitStarburst(W * 0.5 + riderScreenX, H * 0.55 + r.yOffset, '#ffe600');\n        } else {\n          state.score += 500;\n          state.chillLevel = Math.min(100, state.chillLevel + 20);\n          addFloatingText('💎 ULTRA CHILL! +500', W * 0.5 + riderScreenX, H * 0.55 + r.yOffset, '#00f0ff');\n          emitStarburst(W * 0.5 + riderScreenX, H * 0.55 + r.yOffset, '#00f0ff');\n        }\n        collectibles.splice(i, 1);\n        continue;\n      }\n    }\n\n    if (c.z <= 0) {\n      collectibles.splice(i, 1);\n    }\n  }\n\n  // Particles\n  for (let i = particles.length - 1; i >= 0; i--) {\n    const p = particles[i];\n    p.x += p.vx;\n    p.y += p.vy;\n    p.life -= p.decay;\n    if (p.life <= 0) particles.splice(i, 1);\n  }\n\n  // Floating text\n  for (let i = floatingTexts.length - 1; i >= 0; i--) {\n    const ft = floatingTexts[i];\n    ft.y += ft.vy;\n    ft.alpha -= 0.018;\n    if (ft.scale < ft.targetScale) ft.scale += 0.05;\n    if (ft.alpha <= 0) floatingTexts.splice(i, 1);\n  }\n\n  // Speed streaks\n  for (let s of speedStreaks) {\n    s.z -= state.speed * dt * 920 * s.speed;\n    if (s.z <= 10) {\n      s.z = 900;\n      s.x = (Math.random() - 0.5) * 2.4;\n      s.y = Math.random() * 0.95 + 0.05;\n    }\n  }\n\n  // HUD sync\n  const mph = Math.floor(88 * state.speed);\n  document.getElementById('speedVal').innerHTML = `${mph} <span style=\"font-size:12px;color:#00f0ff;\">MPH</span>`;\n  document.getElementById('yuzuCount').innerText = state.yuzusCollected;\n  document.getElementById('meterFill').style.width = `${state.chillLevel}%`;\n  document.getElementById('meterText').innerText = state.chillLevel > 90 ? 'MAX CHILL 🔥' : state.chillLevel > 60 ? 'SERENE 🌊' : 'CRUISIN 🍃';\n}\n\n// --- Render Methods ---\nfunction drawEnvironment(theme) {\n  const vy = H * state.vanishingYRatio;\n\n  // Sky Gradient\n  const sky = ctx.createLinearGradient(0, 0, 0, vy);\n  sky.addColorStop(0, theme.skyTop);\n  sky.addColorStop(0.3, theme.skyMid1);\n  sky.addColorStop(0.65, theme.skyMid2);\n  sky.addColorStop(0.85, theme.skyMid3);\n  sky.addColorStop(1, theme.skyBottom);\n  ctx.fillStyle = sky;\n  ctx.fillRect(0, 0, W, vy);\n\n  // Retro Slit Sun\n  const sunX = W * 0.5;\n  const sunY = vy - H * 0.13;\n  const sunR = Math.min(W, H) * 0.19;\n\n  const sunGrad = ctx.createLinearGradient(sunX, sunY - sunR, sunX, sunY + sunR);\n  sunGrad.addColorStop(0, theme.sunTop);\n  sunGrad.addColorStop(0.5, theme.sunMid);\n  sunGrad.addColorStop(1, theme.sunBottom);\n\n  ctx.fillStyle = sunGrad;\n  ctx.beginPath();\n  ctx.arc(sunX, sunY, sunR, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Sun Slits\n  ctx.fillStyle = theme.skyTop;\n  const slitStart = sunY - sunR * 0.25;\n  for (let y = slitStart; y < sunY + sunR; y += 14) {\n    const h = ((y - slitStart) / (sunR * 1.25)) * 8 + 2;\n    ctx.fillRect(sunX - sunR - 15, y, sunR * 2 + 30, h);\n  }\n\n  // Parallax Mountains\n  drawParallaxMountains(theme, vy);\n\n  // 3D Highway Road\n  drawHighway(theme, vy);\n\n  // Roadside 3D Palms\n  drawRoadPalms(theme, vy);\n}\n\nfunction drawParallaxMountains(theme, vy) {\n  // Far range\n  ctx.fillStyle = theme.mountainFar;\n  ctx.beginPath();\n  ctx.moveTo(0, vy);\n  const steps = 10;\n  for (let i = 0; i <= steps; i++) {\n    const mx = (W / steps) * i;\n    const my = vy - (i % 2 === 1 ? H * 0.15 : H * 0.05);\n    ctx.lineTo(mx, my);\n  }\n  ctx.lineTo(W, vy);\n  ctx.closePath();\n  ctx.fill();\n\n  ctx.strokeStyle = theme.mountainFarLine;\n  ctx.lineWidth = 1.6;\n  ctx.stroke();\n\n  // Near range\n  ctx.fillStyle = theme.mountainNear;\n  ctx.beginPath();\n  ctx.moveTo(0, vy);\n  for (let i = 0; i <= steps + 2; i++) {\n    const mx = (W / (steps + 2)) * i;\n    const my = vy - (i % 2 === 0 ? H * 0.09 : H * 0.02);\n    ctx.lineTo(mx, my);\n  }\n  ctx.lineTo(W, vy);\n  ctx.closePath();\n  ctx.fill();\n\n  ctx.strokeStyle = theme.mountainNearLine;\n  ctx.lineWidth = 2;\n  ctx.stroke();\n}\n\nfunction drawHighway(theme, vy) {\n  const roadHeight = H - vy;\n\n  // Road Surface\n  const roadGrad = ctx.createLinearGradient(0, vy, 0, H);\n  roadGrad.addColorStop(0, theme.gridBase);\n  roadGrad.addColorStop(1, '#1b0028');\n  ctx.fillStyle = roadGrad;\n  ctx.fillRect(0, vy, W, roadHeight);\n\n  // Radial grid lanes\n  const cx = W * 0.5;\n  const numRadials = 16;\n  for (let i = -numRadials; i <= numRadials; i++) {\n    const progress = i / numRadials;\n    const startX = cx + progress * (W * 0.12);\n    const endX = cx + progress * (W * 1.25);\n\n    ctx.strokeStyle = i === 0 ? '#ff007f' : theme.gridRadials;\n    ctx.lineWidth = i === 0 ? 3.2 : 1.3;\n    ctx.beginPath();\n    ctx.moveTo(startX, vy);\n    ctx.lineTo(endX, H);\n    ctx.stroke();\n  }\n\n  // Horizontal rungs scrolling forward\n  const numRungs = 16;\n  for (let i = 0; i < numRungs; i++) {\n    const norm = ((i * (200 / numRungs) + state.roadZ) % 200) / 200;\n    const y = vy + Math.pow(norm, 2.5) * roadHeight;\n    const alpha = Math.pow(norm, 1.8);\n\n    ctx.strokeStyle = `rgba(0, 240, 255, ${alpha * 0.85})`;\n    ctx.lineWidth = 1 + norm * 3.2;\n    ctx.beginPath();\n    ctx.moveTo(0, y);\n    ctx.lineTo(W, y);\n    ctx.stroke();\n  }\n}\n\nfunction drawRoadPalms(theme, vy) {\n  const cx = W * 0.5;\n  const roadHeight = H - vy;\n\n  for (let palm of roadPalms) {\n    const norm = Math.max(0.01, Math.min(1.0, 1.0 - palm.z / 1200));\n    const y = vy + Math.pow(norm, 2.2) * roadHeight;\n    const spread = palm.side * (W * 0.58) * norm;\n    const x = cx + spread;\n    const scale = norm * 1.6;\n\n    if (scale < 0.1) continue;\n\n    ctx.save();\n    ctx.translate(x, y);\n    ctx.scale(scale * (palm.side < 0 ? -1 : 1), scale);\n\n    ctx.fillStyle = theme.palmSilhouette;\n    // Palm trunk\n    ctx.beginPath();\n    ctx.moveTo(-5, 0);\n    ctx.quadraticCurveTo(15, -60, 20, -110);\n    ctx.lineTo(26, -110);\n    ctx.quadraticCurveTo(20, -60, 5, 0);\n    ctx.closePath();\n    ctx.fill();\n\n    // Palm neon outline\n    ctx.strokeStyle = theme.neonAccent;\n    ctx.lineWidth = 1.2;\n    ctx.stroke();\n\n    // Fronds\n    ctx.translate(22, -110);\n    for (let a = -3; a <= 3; a++) {\n      ctx.save();\n      ctx.rotate(a * 0.42);\n      ctx.fillStyle = theme.palmSilhouette;\n      ctx.beginPath();\n      ctx.moveTo(0, 0);\n      ctx.quadraticCurveTo(28, -22, 54, 5);\n      ctx.quadraticCurveTo(22, -6, 0, 0);\n      ctx.fill();\n      ctx.strokeStyle = theme.neonAccent;\n      ctx.lineWidth = 1;\n      ctx.stroke();\n      ctx.restore();\n    }\n    ctx.restore();\n  }\n}\n\n// Draw Collectibles in Perspective\nfunction drawCollectibles(vy) {\n  const cx = W * 0.5;\n  const roadHeight = H - vy;\n\n  for (let c of collectibles) {\n    const norm = Math.max(0.01, Math.min(1.0, 1.0 - c.z / 1200));\n    const y = vy + Math.pow(norm, 2.2) * roadHeight - (c.bobOffset + Math.sin(state.time * 6 + c.bobOffset) * 12) * norm;\n    const x = cx + c.lane * (W * 0.45) * norm;\n    const scale = norm * 1.6;\n\n    ctx.save();\n    ctx.translate(x, y);\n    ctx.scale(scale, scale);\n\n    if (c.type === 'yuzu') {\n      ctx.rotate(c.rot);\n      ctx.shadowColor = '#ffea00';\n      ctx.shadowBlur = 16;\n      const yGrad = ctx.createRadialGradient(-3, -3, 2, 0, 0, 16);\n      yGrad.addColorStop(0, '#ffffff');\n      yGrad.addColorStop(0.3, '#ffeb3b');\n      yGrad.addColorStop(0.8, '#ff9800');\n      yGrad.addColorStop(1, '#e65100');\n      ctx.fillStyle = yGrad;\n      ctx.beginPath();\n      ctx.arc(0, 0, 16, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Stem & leaf\n      ctx.fillStyle = '#4caf50';\n      ctx.beginPath();\n      ctx.ellipse(8, -12, 8, 4, 0.4, 0, Math.PI * 2);\n      ctx.fill();\n    } else {\n      ctx.rotate(c.rot * 1.5);\n      ctx.shadowColor = '#00f0ff';\n      ctx.shadowBlur = 18;\n      ctx.fillStyle = '#00f0ff';\n      ctx.beginPath();\n      ctx.moveTo(0, -18);\n      ctx.lineTo(14, 0);\n      ctx.lineTo(0, 18);\n      ctx.lineTo(-14, 0);\n      ctx.closePath();\n      ctx.fill();\n      ctx.fillStyle = '#ffffff';\n      ctx.beginPath();\n      ctx.moveTo(0, -10);\n      ctx.lineTo(7, 0);\n      ctx.lineTo(0, 10);\n      ctx.lineTo(-7, 0);\n      ctx.closePath();\n      ctx.fill();\n    }\n    ctx.restore();\n  }\n}\n\n// Draw Speed Streaks\nfunction drawSpeedStreaks() {\n  ctx.save();\n  for (let s of speedStreaks) {\n    const norm = 1.0 - s.z / 900;\n    const sx = W * 0.5 + s.x * W * 0.55 * norm;\n    const sy = s.y * H;\n    const len = s.len * (1 + norm * 2.2) * (state.boost ? 3.2 : 1);\n\n    ctx.strokeStyle = state.boost ? 'rgba(0, 240, 255, 0.85)' : 'rgba(255, 255, 255, 0.35)';\n    ctx.lineWidth = norm * (state.boost ? 2.6 : 1.5);\n    ctx.beginPath();\n    ctx.moveTo(sx, sy);\n    ctx.lineTo(sx - len, sy);\n    ctx.stroke();\n  }\n  ctx.restore();\n}\n\n// Draw Hoverboard & Capybara\nfunction drawCapybaraScene() {\n  const r = state.rider;\n  const time = state.time;\n  const theme = THEMES[currentThemeIndex];\n\n  const riderCenterX = W * 0.5 + r.x * (W * 0.35);\n  const hoverBaseY = H * 0.67;\n  const floatOffset = Math.sin(time * 3.5) * 11;\n  const boardY = hoverBaseY + r.yOffset + floatOffset;\n\n  // Ground Shadow & Repulsor Projection Rings\n  ctx.save();\n  const shadowDist = Math.max(0.18, 1.0 - Math.abs(r.yOffset) / 230);\n  ctx.translate(riderCenterX, hoverBaseY + 14);\n  ctx.scale(shadowDist, shadowDist * 0.32);\n\n  // Soft dark ground shadow\n  ctx.fillStyle = 'rgba(0, 0, 0, 0.62)';\n  ctx.beginPath();\n  ctx.arc(0, 0, 145, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Cyan repulsor projection rings on asphalt\n  ctx.strokeStyle = `rgba(0, 240, 255, ${0.85 * shadowDist})`;\n  ctx.lineWidth = 4.5;\n  ctx.shadowColor = '#00f0ff';\n  ctx.shadowBlur = 14;\n  ctx.beginPath();\n  ctx.arc(-82, 0, 44, 0, Math.PI * 2);\n  ctx.arc(82, 0, 44, 0, Math.PI * 2);\n  ctx.stroke();\n  ctx.shadowBlur = 0;\n  ctx.restore();\n\n  // Thruster embers spray\n  const thrusterWorldX = riderCenterX - 145;\n  const thrusterWorldY = boardY;\n  emitThrusterParticles(thrusterWorldX, thrusterWorldY, state.boost);\n\n  // Apply Transform for Board & Rider\n  ctx.save();\n  ctx.translate(riderCenterX, boardY);\n  ctx.rotate(r.tilt + (r.isTricking ? r.spinAngle : 0));\n\n  // Underside Levitation Glow Cones\n  ctx.save();\n  const pulse = Math.sin(time * 8) * 0.15 + 0.85;\n  [-80, 80].forEach(bx => {\n    const beamGrad = ctx.createLinearGradient(bx, 15, bx, 82);\n    beamGrad.addColorStop(0, 'rgba(0, 240, 255, 0.75)');\n    beamGrad.addColorStop(0.5, 'rgba(0, 240, 255, 0.22)');\n    beamGrad.addColorStop(1, 'rgba(0, 240, 255, 0)');\n    ctx.fillStyle = beamGrad;\n    ctx.beginPath();\n    ctx.moveTo(bx - 26, 12);\n    ctx.lineTo(bx + 26, 12);\n    ctx.lineTo(bx + 44, 82);\n    ctx.lineTo(bx - 44, 82);\n    ctx.closePath();\n    ctx.fill();\n\n    ctx.strokeStyle = `rgba(0, 240, 255, ${0.65 * pulse})`;\n    ctx.lineWidth = 2.6;\n    ctx.beginPath();\n    ctx.ellipse(bx, 20, 25 * pulse, 7.5, 0, 0, Math.PI * 2);\n    ctx.stroke();\n  });\n  ctx.restore();\n\n  // Rear Thruster Jets\n  ctx.save();\n  const flameLength = (state.boost ? 145 : 78) + Math.sin(time * 35) * 16;\n  [-8, 6].forEach(ty => {\n    ctx.save();\n    ctx.translate(-148, ty);\n    const fGrad = ctx.createLinearGradient(0, 0, -flameLength, 0);\n    fGrad.addColorStop(0, '#ffffff');\n    fGrad.addColorStop(0.2, '#00f0ff');\n    fGrad.addColorStop(0.65, '#ff007f');\n    fGrad.addColorStop(1, 'rgba(255, 0, 128, 0)');\n    ctx.fillStyle = fGrad;\n    ctx.beginPath();\n    ctx.moveTo(0, -7.5);\n    ctx.quadraticCurveTo(-flameLength * 0.5, -17, -flameLength, 0);\n    ctx.quadraticCurveTo(-flameLength * 0.5, 17, 0, 7.5);\n    ctx.closePath();\n    ctx.fill();\n\n    // Bright White-Cyan Core\n    ctx.fillStyle = '#ffffff';\n    ctx.beginPath();\n    ctx.moveTo(0, -3.8);\n    ctx.lineTo(-flameLength * 0.45, 0);\n    ctx.lineTo(0, 3.8);\n    ctx.closePath();\n    ctx.fill();\n    ctx.restore();\n  });\n  ctx.restore();\n\n  // Hoverboard Chassis & Deck\n  ctx.save();\n  // Under chassis\n  ctx.fillStyle = '#11131c';\n  ctx.beginPath();\n  ctx.moveTo(-142, 14);\n  ctx.lineTo(142, 14);\n  ctx.lineTo(152, 5);\n  ctx.lineTo(-152, 5);\n  ctx.closePath();\n  ctx.fill();\n\n  // Thruster metal bracket housing\n  ctx.fillStyle = '#3a3e50';\n  ctx.fillRect(-152, -12, 16, 22);\n  ctx.fillStyle = '#1a1c24';\n  ctx.fillRect(-156, -9, 5, 16);\n\n  // Deck Top Surface\n  const deckGrad = ctx.createLinearGradient(-160, -18, 160, 18);\n  deckGrad.addColorStop(0, '#151428');\n  deckGrad.addColorStop(0.4, '#2d294d');\n  deckGrad.addColorStop(0.6, '#2d294d');\n  deckGrad.addColorStop(1, '#151428');\n  ctx.fillStyle = deckGrad;\n\n  ctx.beginPath();\n  // Nose kick (front right)\n  ctx.moveTo(154, -14);\n  ctx.quadraticCurveTo(166, -10, 168, 0);\n  ctx.quadraticCurveTo(162, 9, 140, 10);\n  // Bottom deck edge\n  ctx.lineTo(-140, 10);\n  // Tail kick (rear left)\n  ctx.quadraticCurveTo(-162, 9, -165, -2);\n  ctx.quadraticCurveTo(-158, -12, -146, -16);\n  // Top deck curve\n  ctx.quadraticCurveTo(-75, -7, 0, -7);\n  ctx.quadraticCurveTo(75, -7, 154, -14);\n  ctx.closePath();\n  ctx.fill();\n\n  // Edge Neon Border\n  ctx.strokeStyle = '#00f0ff';\n  ctx.lineWidth = 4;\n  ctx.shadowColor = '#00f0ff';\n  ctx.shadowBlur = 12;\n  ctx.stroke();\n  ctx.shadowBlur = 0;\n\n  // Deck Grip Pads\n  ctx.fillStyle = '#0a0a12';\n  ctx.beginPath();\n  ctx.roundRect(-132, -7, 72, 12, 4);\n  ctx.fill();\n  ctx.beginPath();\n  ctx.roundRect(65, -7, 72, 12, 4);\n  ctx.fill();\n\n  // Cyber Decal Stripes\n  ctx.strokeStyle = '#ff007f';\n  ctx.lineWidth = 2.8;\n  ctx.shadowColor = '#ff007f';\n  ctx.shadowBlur = 8;\n  ctx.beginPath();\n  ctx.moveTo(-55, -2);\n  ctx.lineTo(-25, -2);\n  ctx.lineTo(-12, -6);\n  ctx.lineTo(12, -6);\n  ctx.lineTo(25, -2);\n  ctx.lineTo(55, -2);\n  ctx.stroke();\n\n  // Status LEDs\n  const leds = ['#00f0ff', '#00f0ff', '#ff007f', '#ffe600'];\n  leds.forEach((col, i) => {\n    ctx.fillStyle = col;\n    ctx.beginPath();\n    ctx.arc(-24 + i * 16, 5, 2.5, 0, Math.PI * 2);\n    ctx.fill();\n  });\n  ctx.shadowBlur = 0;\n  ctx.restore();\n\n  // --- DRAW CAPYBARA ---\n  drawCapybaraAnatomy(time, theme);\n\n  ctx.restore(); // end board + capy transform\n}\n\nfunction drawCapybaraAnatomy(time, theme) {\n  const breath = Math.sin(time * 3) * 0.02;\n\n  ctx.save();\n  // Translate slightly up so paws rest cleanly on the deck top (-7px)\n  ctx.translate(0, -6);\n\n  // Far back foot\n  ctx.fillStyle = '#48240a';\n  ctx.beginPath();\n  ctx.roundRect(-86, -6, 40, 13, 5);\n  ctx.fill();\n\n  // Far front foot\n  ctx.fillStyle = '#48240a';\n  ctx.beginPath();\n  ctx.roundRect(76, -6, 40, 13, 5);\n  ctx.fill();\n\n  // Body scale with breath\n  ctx.save();\n  ctx.scale(1 + breath * 0.3, 1 - breath * 0.8);\n\n  // Main Potato Torso\n  const bodyGrad = ctx.createLinearGradient(-105, -125, 85, 10);\n  bodyGrad.addColorStop(0, '#582f0e');\n  bodyGrad.addColorStop(0.25, '#884f23');\n  bodyGrad.addColorStop(0.65, '#b0723e');\n  bodyGrad.addColorStop(0.9, '#764118');\n  bodyGrad.addColorStop(1, '#48240a');\n  ctx.fillStyle = bodyGrad;\n\n  ctx.beginPath();\n  ctx.moveTo(-100, -25);\n  ctx.bezierCurveTo(-130, -85, -90, -140, -22, -132);\n  ctx.bezierCurveTo(22, -130, 55, -122, 70, -104);\n  ctx.bezierCurveTo(95, -78, 90, -32, 68, -8);\n  ctx.bezierCurveTo(26, 4, -55, 0, -100, -25);\n  ctx.closePath();\n  ctx.fill();\n\n  // Fur highlight on spine\n  ctx.strokeStyle = 'rgba(255, 195, 145, 0.22)';\n  ctx.lineWidth = 5;\n  ctx.beginPath();\n  ctx.arc(-38, -90, 64, 3.8, 5.1);\n  ctx.stroke();\n\n  // Warm golden belly\n  const bellyGrad = ctx.createLinearGradient(-30, -50, 20, 0);\n  bellyGrad.addColorStop(0, 'rgba(235, 175, 120, 0.42)');\n  bellyGrad.addColorStop(1, 'rgba(235, 175, 120, 0)');\n  ctx.fillStyle = bellyGrad;\n  ctx.beginPath();\n  ctx.ellipse(-12, -45, 65, 30, -0.12, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Hip muscle definition\n  ctx.strokeStyle = '#422008';\n  ctx.lineWidth = 3.5;\n  ctx.beginPath();\n  ctx.arc(-62, -52, 42, 0.7, 2.3);\n  ctx.stroke();\n\n  // Near rear foot & leg\n  ctx.fillStyle = '#78431c';\n  ctx.beginPath();\n  ctx.roundRect(-72, -10, 45, 16, 7);\n  ctx.fill();\n  // Toes\n  ctx.fillStyle = '#220f04';\n  ctx.fillRect(-40, -6, 9, 12);\n  ctx.fillRect(-53, -6, 9, 12);\n  ctx.fillRect(-66, -6, 9, 12);\n\n  // Near front shoulder crease\n  ctx.strokeStyle = 'rgba(70, 35, 10, 0.35)';\n  ctx.lineWidth = 3;\n  ctx.beginPath();\n  ctx.arc(52, -48, 32, 1.1, 2.6);\n  ctx.stroke();\n\n  // Near front foot\n  ctx.fillStyle = '#8a4f22';\n  ctx.beginPath();\n  ctx.roundRect(86, -10, 44, 16, 7);\n  ctx.fill();\n  // Toes\n  ctx.fillStyle = '#220f04';\n  ctx.fillRect(117, -6, 9, 12);\n  ctx.fillRect(105, -6, 9, 12);\n  ctx.fillRect(93, -6, 9, 12);\n\n  // --- CAPYBARA HEAD ---\n  ctx.save();\n  ctx.translate(50, -112);\n  ctx.rotate(-0.02 + breath * 0.6);\n\n  const headGrad = ctx.createLinearGradient(0, -55, 100, 35);\n  headGrad.addColorStop(0, '#9c5f2e');\n  headGrad.addColorStop(0.35, '#b87740');\n  headGrad.addColorStop(0.7, '#b87740');\n  headGrad.addColorStop(0.9, '#764019');\n  headGrad.addColorStop(1, '#48240a');\n  ctx.fillStyle = headGrad;\n\n  ctx.beginPath();\n  // Crown\n  ctx.moveTo(-24, -48);\n  ctx.lineTo(38, -48);\n  // Nose ridge\n  ctx.bezierCurveTo(70, -48, 94, -38, 102, -16);\n  // Blunt snout box\n  ctx.bezierCurveTo(110, 6, 109, 38, 88, 48);\n  // Chin / lower jaw\n  ctx.bezierCurveTo(66, 54, 32, 45, 10, 38);\n  // Throat\n  ctx.bezierCurveTo(-16, 32, -30, 12, -30, -22);\n  ctx.closePath();\n  ctx.fill();\n\n  // Dark muzzle shading\n  ctx.fillStyle = 'rgba(60, 30, 8, 0.28)';\n  ctx.beginPath();\n  ctx.ellipse(72, 18, 28, 26, 0.2, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Nose Pad\n  ctx.fillStyle = '#180b03';\n  ctx.beginPath();\n  ctx.roundRect(92, -11, 19, 28, 7);\n  ctx.fill();\n\n  // Nostril slit\n  ctx.fillStyle = '#060201';\n  ctx.beginPath();\n  ctx.ellipse(100, 3, 5, 8, 0.35, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';\n  ctx.lineWidth = 1.2;\n  ctx.stroke();\n\n  // Friendly Capybara smile line\n  ctx.strokeStyle = '#180b03';\n  ctx.lineWidth = 3.6;\n  ctx.lineCap = 'round';\n  ctx.beginPath();\n  ctx.moveTo(92, 24);\n  ctx.quadraticCurveTo(72, 35, 52, 26);\n  ctx.stroke();\n\n  // Rosy Cheek blush\n  const blushGrad = ctx.createRadialGradient(30, 8, 2, 30, 8, 20);\n  blushGrad.addColorStop(0, 'rgba(255, 80, 120, 0.35)');\n  blushGrad.addColorStop(1, 'rgba(255, 80, 120, 0)');\n  ctx.fillStyle = blushGrad;\n  ctx.beginPath();\n  ctx.arc(30, 8, 20, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Whiskers\n  ctx.strokeStyle = 'rgba(255, 235, 215, 0.7)';\n  ctx.lineWidth = 1.4;\n  ctx.beginPath();\n  ctx.moveTo(78, 14);\n  ctx.lineTo(120, 10);\n  ctx.moveTo(77, 20);\n  ctx.lineTo(118, 23);\n  ctx.moveTo(74, 25);\n  ctx.lineTo(110, 35);\n  ctx.stroke();\n\n  // Ear\n  ctx.save();\n  const earTwitch = Math.sin(time * 5) > 0.88 ? Math.sin(time * 35) * 0.18 : 0;\n  ctx.translate(-16, -44);\n  ctx.rotate(earTwitch);\n  ctx.fillStyle = '#6a3613';\n  ctx.beginPath();\n  ctx.ellipse(0, 0, 15, 20, -0.32, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#c77878';\n  ctx.beginPath();\n  ctx.ellipse(1, 2, 9, 13, -0.32, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.restore();\n\n  // --- EYES OR SUNGLASSES ---\n  if (!state.showShades) {\n    ctx.save();\n    ctx.translate(34, -18);\n    // Eye socket\n    ctx.fillStyle = 'rgba(45, 22, 6, 0.4)';\n    ctx.beginPath();\n    ctx.ellipse(0, 0, 13, 9, 0, 0, Math.PI * 2);\n    ctx.fill();\n    // Eye white\n    ctx.fillStyle = '#fffdf7';\n    ctx.beginPath();\n    ctx.ellipse(0, 0, 11, 7, 0, 0, Math.PI * 2);\n    ctx.fill();\n    // Iris\n    ctx.fillStyle = '#261104';\n    ctx.beginPath();\n    ctx.arc(1.5, 0, 5.5, 0, Math.PI * 2);\n    ctx.fill();\n    // Sparkle\n    ctx.fillStyle = '#ffffff';\n    ctx.beginPath();\n    ctx.arc(3, -2, 2, 0, Math.PI * 2);\n    ctx.fill();\n    // Sleepy capy lid\n    const blink = (Math.sin(time * 1.6) > 0.95) ? 1 : 0.45;\n    ctx.fillStyle = '#9c5f2e';\n    ctx.beginPath();\n    ctx.rect(-12, -9, 24, 18 * blink);\n    ctx.fill();\n    // Eyelash contour\n    ctx.strokeStyle = '#180b03';\n    ctx.lineWidth = 2.6;\n    ctx.beginPath();\n    ctx.arc(0, -1, 11, 3.4, 6.0);\n    ctx.stroke();\n    ctx.restore();\n  } else {\n    // Cyberpunk Visor Sunglasses\n    ctx.save();\n    ctx.translate(38, -20);\n    ctx.fillStyle = '#0d0e14';\n    ctx.strokeStyle = '#00f0ff';\n    ctx.lineWidth = 3.2;\n    ctx.beginPath();\n    ctx.moveTo(-22, -15);\n    ctx.lineTo(40, -18);\n    ctx.lineTo(34, 16);\n    ctx.lineTo(-4, 19);\n    ctx.lineTo(-20, 7);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n\n    // Animated Neon Mirrored Reflection\n    ctx.save();\n    ctx.clip();\n    const sweep = ((time * 1.5) % 3) * 44 - 44;\n    const rGrad = ctx.createLinearGradient(sweep - 28, -35, sweep + 40, 35);\n    rGrad.addColorStop(0, 'rgba(255, 0, 128, 0)');\n    rGrad.addColorStop(0.35, 'rgba(255, 0, 128, 0.9)');\n    rGrad.addColorStop(0.55, 'rgba(0, 240, 255, 0.95)');\n    rGrad.addColorStop(0.75, 'rgba(255, 235, 59, 0.9)');\n    rGrad.addColorStop(1, 'rgba(255, 235, 59, 0)');\n    ctx.fillStyle = rGrad;\n    ctx.fillRect(-45, -45, 110, 80);\n    ctx.restore();\n\n    // Temple bar\n    ctx.strokeStyle = '#00f0ff';\n    ctx.lineWidth = 3.2;\n    ctx.beginPath();\n    ctx.moveTo(-21, -13);\n    ctx.lineTo(-46, -17);\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  // --- YUZU ON HEAD ---\n  ctx.save();\n  ctx.translate(16, -50);\n  ctx.rotate(Math.sin(time * 4) * 0.08);\n\n  ctx.fillStyle = 'rgba(45, 22, 6, 0.35)';\n  ctx.beginPath();\n  ctx.ellipse(0, 3, 20, 6, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  const yGrad = ctx.createRadialGradient(-6, -18, 2, 0, -15, 24);\n  yGrad.addColorStop(0, '#fff59d');\n  yGrad.addColorStop(0.3, '#ffca28');\n  yGrad.addColorStop(0.8, '#ff9800');\n  yGrad.addColorStop(1, '#e65100');\n  ctx.fillStyle = yGrad;\n  ctx.beginPath();\n  ctx.arc(0, -17, 22, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Stem\n  ctx.fillStyle = '#4e342e';\n  ctx.beginPath();\n  ctx.arc(0, -38, 4, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillRect(-2, -45, 4, 8);\n\n  // Leaf\n  ctx.save();\n  ctx.translate(2, -42);\n  ctx.rotate(-0.35 + Math.sin(time * 12) * 0.18);\n  ctx.fillStyle = '#43a047';\n  ctx.beginPath();\n  ctx.ellipse(15, -4, 16, 8, -0.2, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.strokeStyle = '#2e7d32';\n  ctx.lineWidth = 1.4;\n  ctx.stroke();\n  ctx.restore();\n\n  ctx.restore(); // end Yuzu\n\n  ctx.restore(); // end Head\n\n  // --- FLOWING CYBER SCARF ---\n  ctx.save();\n  ctx.translate(28, -108);\n\n  // Scarf knot\n  ctx.fillStyle = theme.scarfColor;\n  ctx.beginPath();\n  ctx.roundRect(-16, -7, 40, 26, 10);\n  ctx.fill();\n  ctx.strokeStyle = theme.scarfTrim;\n  ctx.lineWidth = 2.8;\n  ctx.stroke();\n\n  // Background ribbon tail\n  ctx.fillStyle = '#d4005c';\n  ctx.beginPath();\n  ctx.moveTo(-14, 6);\n  const w1 = Math.sin(time * 14) * 16;\n  const w2 = Math.cos(time * 14 + 1.2) * 22;\n  const w3 = Math.sin(time * 14 + 2.5) * 28;\n  ctx.quadraticCurveTo(-55, 0 + w1, -105, -6 + w2);\n  ctx.quadraticCurveTo(-145, -12 + w3, -180, w3);\n  ctx.lineTo(-176, w3 + 24);\n  ctx.quadraticCurveTo(-135, 8 + w2, -98, 12 + w1);\n  ctx.quadraticCurveTo(-50, 18, -12, 24);\n  ctx.closePath();\n  ctx.fill();\n\n  // Foreground ribbon tail\n  ctx.fillStyle = theme.scarfColor;\n  ctx.beginPath();\n  ctx.moveTo(-11, 2);\n  const v1 = Math.cos(time * 14 + 0.5) * 14;\n  const v2 = Math.sin(time * 14 + 1.8) * 20;\n  const v3 = Math.cos(time * 14 + 3.0) * 26;\n  ctx.quadraticCurveTo(-50, -5 + v1, -95, -10 + v2);\n  ctx.quadraticCurveTo(-135, -16 + v3, -170, v3 - 6);\n  ctx.lineTo(-166, v3 + 16);\n  ctx.quadraticCurveTo(-125, 2 + v2, -88, 6 + v1);\n  ctx.quadraticCurveTo(-44, 12, -9, 18);\n  ctx.closePath();\n  ctx.fill();\n\n  // Scarf Gold Trim\n  ctx.strokeStyle = theme.scarfTrim;\n  ctx.lineWidth = 3.2;\n  ctx.beginPath();\n  ctx.moveTo(-158, v3 - 4);\n  ctx.lineTo(-156, v3 + 14);\n  ctx.stroke();\n\n  ctx.restore(); // end scarf\n\n  ctx.restore(); // end body scaling\n\n  ctx.restore(); // end Capybara\n}\n\n// Draw Particles\nfunction drawParticles() {\n  ctx.save();\n  for (let p of particles) {\n    ctx.fillStyle = p.color;\n    ctx.globalAlpha = Math.max(0, p.life);\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  ctx.restore();\n}\n\n// Draw Floating Score & Text\nfunction drawFloatingTexts() {\n  ctx.save();\n  ctx.textAlign = 'center';\n  ctx.font = '900 22px monospace, sans-serif';\n  for (let ft of floatingTexts) {\n    ctx.save();\n    ctx.translate(ft.x, ft.y);\n    ctx.scale(ft.scale, ft.scale);\n    ctx.globalAlpha = Math.max(0, ft.alpha);\n    ctx.fillStyle = ft.color;\n    ctx.shadowColor = ft.color;\n    ctx.shadowBlur = 12;\n    ctx.fillText(ft.text, 0, 0);\n    ctx.restore();\n  }\n  ctx.restore();\n}\n\n// --- Animation Loop ---\nfunction loop(now) {\n  const dt = Math.min((now - lastTime) / 1000, 0.1);\n  lastTime = now;\n\n  update(dt);\n\n  ctx.save();\n  ctx.scale(dpr, dpr);\n  ctx.clearRect(0, 0, W, H);\n\n  const theme = THEMES[currentThemeIndex];\n  drawEnvironment(theme);\n  drawSpeedStreaks();\n  drawCollectibles(H * state.vanishingYRatio);\n  drawCapybaraScene();\n  drawParticles();\n  drawFloatingTexts();\n\n  ctx.restore();\n  requestAnimationFrame(loop);\n}\n\nrequestAnimationFrame(loop);\n</script>\n</body>\n</html>"
    }
