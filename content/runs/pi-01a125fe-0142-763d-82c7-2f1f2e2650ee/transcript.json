l=\"#e4fff6\"/>\n            <path d=\"M319 430 Q500 450 681 430 L662 465 Q500 486 338 465Z\" fill=\"url(#deck)\" stroke=\"#7184a7\" stroke-opacity=\".75\" stroke-width=\"2\"/>\n            <path d=\"M326 431 Q500 451 674 431 L669 441 Q500 461 331 441Z\" fill=\"url(#board)\" filter=\"url(#glow)\"/>\n            <path d=\"M368 435 Q500 450 632 435\" fill=\"none\" stroke=\"#e6fff6\" stroke-opacity=\".85\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <path d=\"M348 461 Q500 478 651 461\" fill=\"none\" stroke=\"#5ce9db\" stroke-opacity=\".65\" stroke-width=\"2\"/>\n            <circle cx=\"352\" cy=\"436\" r=\"3\" fill=\"#fff2cf\"/>\n            <circle cx=\"649\" cy=\"436\" r=\"3\" fill=\"#fff2cf\"/>\n          </g>\n\n          <!-- Near legs -->\n          <path d=\"M386 390 C383 405 386 424 388 438 Q389 446 402 446 L418 443 Q423 439 413 435 L401 433 L405 400Z\" fill=\"#c3844e\" stroke=\"#8d5a3d\" stroke-width=\"1.5\"/>\n          <path d=\"M478 394 C478 408 480 424 480 438 Q482 446 495 446 L512 443 Q516 439 506 435 L493 433 L498 400Z\" fill=\"#c3844e\" stroke=\"#8d5a3d\" stroke-width=\"1.5\"/>\n          <path d=\"M390 440 Q401 443 416 440 M483 440 Q496 443 510 440\" fill=\"none\" stroke=\"#e8bb86\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n\n          <!-- Body -->\n          <path d=\"M282 348 C282 292 321 251 378 243 C432 235 485 255 510 294 C530 325 529 375 504 401 C479 427 429 432 377 423 C320 414 284 391 282 348Z\" fill=\"url(#fur)\" stroke=\"#754a36\" stroke-width=\"3\"/>\n          <path d=\"M306 356 C310 306 340 273 380 264 C414 256 449 264 472 282 C441 274 409 282 390 300 C371 321 364 364 376 410 C336 405 308 386 306 356Z\" fill=\"#e6b77f\" opacity=\".26\"/>\n          <path d=\"M330 383 C365 406 426 416 474 397 C462 414 432 423 398 420 C367 418 343 406 330 383Z\" fill=\"url(#belly)\" opacity=\".62\"/>\n\n          <!-- Face and head -->\n          <path d=\"M461 320 C465 284 487 253 520 240 C548 229 578 239 592 262 C599 273 602 284 601 295 L625 297 Q645 299 646 312 Q646 326 627 332 L605 334 C598 358 579 374 552 376 C523 378 492 360 478 342Z\" fill=\"url(#faceFur)\" stroke=\"#754a36\" stroke-width=\"3\"/>\n          <path d=\"M512 247 C521 232 535 228 544 235 C550 239 550 247 546 254 C536 251 526 251 516 255Z\" fill=\"#9d6744\" stroke=\"#754a36\" stroke-width=\"2\"/>\n          <path d=\"M522 242 Q535 237 542 244\" fill=\"none\" stroke=\"#e8bd87\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <path d=\"M575 276 Q582 270 589 276\" fill=\"none\" stroke=\"#724733\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          <circle cx=\"584\" cy=\"275\" r=\"1.7\" fill=\"#fff1d7\"/>\n          <path d=\"M598 311 Q615 318 631 311\" fill=\"none\" stroke=\"#925d41\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <ellipse cx=\"641\" cy=\"311\" rx=\"10\" ry=\"7.5\" fill=\"#523b3a\"/>\n          <ellipse cx=\"643\" cy=\"309\" rx=\"3\" ry=\"1.5\" fill=\"#b99487\" opacity=\".8\"/>\n          <path d=\"M613 323 Q620 330 631 326\" fill=\"none\" stroke=\"#714a3d\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          <g fill=\"#754a36\" opacity=\".65\">\n            <circle cx=\"612\" cy=\"311\" r=\"1.3\"/><circle cx=\"619\" cy=\"315\" r=\"1.2\"/>\n            <circle cx=\"609\" cy=\"319\" r=\"1.1\"/><circle cx=\"625\" cy=\"320\" r=\"1.1\"/>\n          </g>\n\n          <!-- Wind-swept scarf -->\n          <path d=\"M475 335 C458 327 447 321 430 326 C441 338 453 345 471 349Z\" fill=\"#f2bd69\"/>\n          <path d=\"M475 337 Q504 350 536 337 L544 352 Q511 369 481 353Z\" fill=\"#f3c66f\" stroke=\"#b77d4b\" stroke-width=\"2\"/>\n          <path d=\"M485 343 Q510 354 533 345\" fill=\"none\" stroke=\"#fff0bf\" stroke-opacity=\".75\" stroke-width=\"2\"/>\n          <path d=\"M438 328 Q450 329 462 337\" fill=\"none\" stroke=\"#ffe4a4\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n\n          <!-- Fur details -->\n          <g fill=\"none\" stroke=\"#f0c28c\" stroke-linecap=\"round\" opacity=\".52\">\n            <path d=\"M333 296l-7 8 M350 278l-7 8 M373 270l-5 8 M402 265l-3 7\"/>\n            <path d=\"M321 327l-8 5 M327 373l-8 2 M348 395l-6 4 M451 405l-4 7\"/>\n            <path d=\"M500 267l-3 7 M522 258l-2 7 M557 251l-1 6\"/>\n          </g>\n          <path d=\"M292 349 Q292 324 302 306\" fill=\"none\" stroke=\"#f0c28c\" stroke-opacity=\".45\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        </g>\n\n        <g fill=\"#c4fff2\" filter=\"url(#glow)\">\n          <circle cx=\"278\" cy=\"470\" r=\"2.5\"/>\n          <circle cx=\"718\" cy=\"460\" r=\"2\"/>\n          <circle cx=\"736\" cy=\"486\" r=\"1.6\"/>\n          <circle cx=\"251\" cy=\"492\" r=\"1.6\"/>\n        </g>\n        <g fill=\"none\" stroke=\"#fbce91\" stroke-opacity=\".35\" stroke-width=\"2\" stroke-linecap=\"round\">\n          <path d=\"M813 279v16 M805 287h16\"/>\n          <path d=\"M160 315v12 M154 321h12\"/>\n        </g>\n      </g>\n    </svg>\n  </main>\n\n  <footer>\n    <div class=\"caption\"><span class=\"caption-line\"></span>Quiet streets, happy feet</div>\n    <button class=\"pause\" id=\"pause\" type=\"button\" aria-label=\"Pause animation\">\n      <span class=\"pause-icon\" aria-hidden=\"true\">Ⅱ</span><span id=\"pause-label\">Pause ride</span>\n    </button>\n  </footer>\n</div>\n<script>\n  (() => {\n    const svgNS = \"http://www.w3.org/2000/svg\";\n    const starGroup = document.getElementById(\"stars\");\n    for (let i = 0; i < 76; i++) {\n      const star = document.createElementNS(svgNS, \"circle\");\n      const x = Math.random() * 980 + 10;\n      const y = Math.random() * 270 + 18;\n      star.setAttribute(\"cx\", x.toFixed(1));\n      star.setAttribute(\"cy\", y.toFixed(1));\n      star.setAttribute(\"r\", (Math.random() * 1.5 + .45).toFixed(2));\n      star.setAttribute(\"class\", \"star\");\n      star.style.setProperty(\"--duration\", (2 + Math.random() * 4).toFixed(2) + \"s\");\n      star.style.setProperty(\"--delay\", (-Math.random() * 5).toFixed(2) + \"s\");\n      starGroup.appendChild(star);\n    }\n\n    const sparkField = document.getElementById(\"sparks\");\n    for (let i = 0; i < 12; i++) {\n      const spark = document.createElement(\"span\");\n      spark.className = \"spark\";\n      spark.style.left = (23 + Math.random() * 54) + \"%\";\n      spark.style.top = (57 + Math.random() * 20) + \"%\";\n      spark.style.setProperty(\"--duration\", (3.5 + Math.random() * 4) + \"s\");\n      spark.style.setProperty(\"--delay\", (-Math.random() * 7) + \"s\");\n      sparkField.appendChild(spark);\n    }\n\n    const scene = document.getElementById(\"scene\");\n    const art = document.getElementById(\"art\");\n    scene.addEventListener(\"pointermove\", (event) => {\n      if (event.pointerType === \"touch\") return;\n      const rect = scene.getBoundingClientRect();\n      const x = (event.clientX - rect.left) / rect.width - .5;\n      const y = (event.clientY - rect.top) / rect.height - .5;\n      art.style.setProperty(\"--tilt-x\", (-x * 8).toFixed(1) + \"px\");\n      art.style.setProperty(\"--tilt-y\", (-y * 6).toFixed(1) + \"px\");\n    });\n    scene.addEventListener(\"pointerleave\", () => {\n      art.style.setProperty(\"--tilt-x\", \"0px\");\n      art.style.setProperty(\"--tilt-y\", \"0px\");\n    });\n\n    const button = document.getElementById(\"pause\");\n    const label = document.getElementById(\"pause-label\");\n    button.addEventListener(\"click\", () => {\n      const paused = document.body.classList.toggle(\"paused\");\n      label.textContent = paused ? \"Resume ride\" : \"Pause ride\";\n      button.setAttribute(\"aria-label\", paused ? \"Resume animation\" : \"Pause animation\");\n      button.querySelector(\".pause-icon\").textContent = paused ? \"▶\" : \"Ⅱ\";\n    });\n  })();\n</script>\n</body>\n</html>"
    }
  ]
