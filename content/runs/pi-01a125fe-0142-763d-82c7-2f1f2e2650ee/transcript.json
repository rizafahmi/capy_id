      "role": "assistant",
      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Midnight Glide — Capybara Hoverboard Ride</title>\n<style>\n  :root {\n    color-scheme: dark;\n    --cream: #f8e8c7;\n    --muted: #a8acc5;\n    --cyan: #7ef5e4;\n    --pink: #f39acc;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; min-height: 100%; }\n  body {\n    min-height: 100svh;\n    overflow-x: hidden;\n    background:\n      radial-gradient(ellipse at 50% 70%, #222646 0%, #13152b 46%, #10111e 100%);\n    color: var(--cream);\n    font-family: ui-rounded, \"Avenir Next\", Avenir, \"Segoe UI\", sans-serif;\n  }\n  .page {\n    width: min(1120px, calc(100% - 48px));\n    min-height: 100svh;\n    margin: auto;\n    display: grid;\n    grid-template-rows: auto 1fr auto;\n    padding: 26px 0 22px;\n  }\n  header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 0 18px 8px;\n    z-index: 1;\n  }\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .brand-mark {\n    width: 35px;\n    height: 35px;\n    display: grid;\n    place-items: center;\n    border: 1px solid #ffffff27;\n    border-radius: 12px;\n    color: var(--cyan);\n    background: #ffffff08;\n    box-shadow: 0 0 24px #7ef5e41a;\n    font-size: 17px;\n  }\n  .brand-name {\n    font-size: 11px;\n    font-weight: 750;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n  .brand-sub {\n    margin-top: 4px;\n    color: #9ea2bd;\n    font-size: 9px;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n  .status {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    padding: 9px 13px;\n    border: 1px solid #ffffff1c;\n    border-radius: 999px;\n    background: #ffffff08;\n    color: #c6c8d9;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n  .status-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--cyan);\n    box-shadow: 0 0 11px var(--cyan);\n    animation: blink 2s ease-in-out infinite;\n  }\n  .scene {\n    position: relative;\n    align-self: center;\n    width: 100%;\n    aspect-ratio: 10 / 7;\n    max-height: 75svh;\n    isolation: isolate;\n  }\n  .scene::before {\n    position: absolute;\n    z-index: -1;\n    content: \"\";\n    inset: 7% 4% 4%;\n    border-radius: 50%;\n    background: #7779ff0c;\n    filter: blur(40px);\n  }\n  svg {\n    display: block;\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n  }\n  #art {\n    transform: translate3d(var(--tilt-x, 0), var(--tilt-y, 0), 0);\n    transition: transform 500ms cubic-bezier(.2,.8,.2,1);\n  }\n  .star {\n    fill: #d9e6ff;\n    animation: twinkle var(--duration, 3s) ease-in-out var(--delay, 0s) infinite;\n    transform-box: fill-box;\n    transform-origin: center;\n  }\n  .city-window {\n    fill: #ffcf8b;\n    opacity: .48;\n    animation: window-glow 4s ease-in-out infinite alternate;\n  }\n  .city-window:nth-of-type(3n) { animation-delay: -1.7s; }\n  .city-window:nth-of-type(4n) { animation-delay: -2.8s; }\n  #ride {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: hover 3.4s ease-in-out infinite;\n  }\n  .board-halo { animation: halo 2.4s ease-in-out infinite alternate; }\n  .wheel-ring { animation: wheel-pulse 1.6s ease-in-out infinite alternate; }\n  .trail {\n    stroke-dasharray: 9 13;\n    animation: dash 2.4s linear infinite;\n  }\n  .spark-field {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    pointer-events: none;\n  }\n  .spark {\n    position: absolute;\n    width: 3px;\n    height: 3px;\n    border-radius: 50%;\n    background: #9ff8e8;\n    opacity: 0;\n    box-shadow: 0 0 10px 2px #7ef5e477;\n    animation: drift var(--duration) ease-in-out var(--delay) infinite;\n  }\n  footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 8px 18px 0;\n    color: #8f93ad;\n    font-size: 9px;\n    font-weight: 650;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n  .caption { display: flex; align-items: center; gap: 10px; }\n  .caption-line {\n    width: 24px;\n    height: 1px;\n    background: #7ef5e477;\n  }\n  .pause {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 8px 11px;\n    border: 1px solid #ffffff20;\n    border-radius: 999px;\n    background: #ffffff08;\n    color: #bfc1d1;\n    font: inherit;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: background .2s, color .2s, border-color .2s;\n  }\n  .pause:hover, .pause:focus-visible {\n    outline: none;\n    border-color: #7ef5e477;\n    background: #7ef5e412;\n    color: #fff;\n  }\n  .pause-icon { color: var(--cyan); font-size: 11px; }\n  .paused *, .paused *::before, .paused *::after {\n    animation-play-state: paused !important;\n  }\n  @keyframes hover {\n    0%, 100% { transform: translateY(0) rotate(-.35deg); }\n    50% { transform: translateY(-12px) rotate(.45deg); }\n  }\n  @keyframes halo {\n    from { opacity: .35; transform: scale(.94); }\n    to { opacity: .8; transform: scale(1.06); }\n  }\n  @keyframes wheel-pulse {\n    from { opacity: .6; }\n    to { opacity: 1; }\n  }\n  @keyframes twinkle {\n    0%, 100% { opacity: .25; transform: scale(.7); }\n    50% { opacity: .95; transform: scale(1.2); }\n  }\n  @keyframes window-glow {\n    from { opacity: .27; }\n    to { opacity: .8; }\n  }\n  @keyframes dash { to { stroke-dashoffset: -44; } }\n  @keyframes drift {\n    0% { transform: translate3d(0, 20px, 0) scale(.5); opacity: 0; }\n    25% { opacity: .8; }\n    75% { opacity: .5; }\n    100% { transform: translate3d(18px, -60px, 0) scale(1.1); opacity: 0; }\n  }\n  @keyframes blink { 50% { opacity: .45; } }\n  @media (max-width: 640px) {\n    .page { width: calc(100% - 20px); padding: 16px 0 14px; }\n    header { padding: 0 8px 4px; }\n    .brand-mark { width: 31px; height: 31px; }\n    .brand-name { font-size: 9px; }\n    .brand-sub { font-size: 8px; }\n    .status { padding: 8px 10px; font-size: 8px; }\n    .scene { width: 112%; margin-left: -6%; }\n    footer { padding: 0 8px; font-size: 8px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; }\n    #art { transition: none; }\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header>\n    <div class=\"brand\">\n      <div class=\"brand-mark\" aria-hidden=\"true\">✳</div>\n      <div>\n        <div class=\"brand-name\">Small Hours Club</div>\n        <div class=\"brand-sub\">A very important night ride</div>\n      </div>\n    </div>\n    <div class=\"status\"><span class=\"status-dot\"></span>Drift mode&nbsp; · &nbsp;01:17 AM</div>\n  </header>\n\n  <main class=\"scene\" id=\"scene\">\n    <div class=\"spark-field\" id=\"sparks\" aria-hidden=\"true\"></div>\n    <svg id=\"art\" viewBox=\"0 0 1000 700\" role=\"img\" aria-labelledby=\"title desc\">\n      <title id=\"title\">A capybara cruising through a dreamy city on a hoverboard</title>\n      <desc id=\"desc\">A fluffy brown capybara wearing a golden scarf rides a glowing teal hoverboard beneath a moonlit sky.</desc>\n      <defs>\n        <linearGradient id=\"sky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#17182f\"/>\n          <stop offset=\".58\" stop-color=\"#292747\"/>\n          <stop offset=\"1\" stop-color=\"#484064\"/>\n        </linearGradient>\n        <linearGradient id=\"ground\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop stop-color=\"#34334f\"/>\n          <stop offset=\"1\" stop-color=\"#171a30\"/>\n        </linearGradient>\n        <radialGradient id=\"moonGlow\">\n          <stop stop-color=\"#fff1c9\" stop-opacity=\".24\"/>\n          <stop offset=\"1\" stop-color=\"#fff1c9\" stop-opacity=\"0\"/>\n        </radialGradient>\n        <linearGradient id=\"fur\" x1=\".1\" y1=\"0\" x2=\".9\" y2=\"1\">\n          <stop stop-color=\"#d69a5b\"/>\n          <stop offset=\".55\" stop-color=\"#b87945\"/>\n          <stop offset=\"1\" stop-color=\"#875538\"/>\n        </linearGradient>\n        <linearGradient id=\"faceFur\" x1=\"0\" y1=\"0\" x2=\".8\" y2=\"1\">\n          <stop stop-color=\"#e2ae70\"/>\n          <stop offset=\"1\" stop-color=\"#b77a48\"/>\n        </linearGradient>\n        <linearGradient id=\"belly\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop stop-color=\"#e4b47d\"/>\n          <stop offset=\"1\" stop-color=\"#c88e5c\"/>\n        </linearGradient>\n        <linearGradient id=\"board\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop stop-color=\"#8bf8e8\"/>\n          <stop offset=\".48\" stop-color=\"#46cfc9\"/>\n          <stop offset=\"1\" stop-color=\"#4a8fe0\"/>\n        </linearGradient>\n        <linearGradient id=\"deck\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop stop-color=\"#373750\"/>\n          <stop offset=\"1\" stop-color=\"#171d35\"/>\n        </linearGradient>\n        <radialGradient id=\"wheel\">\n          <stop stop-color=\"#31455b\"/>\n          <stop offset=\".6\" stop-color=\"#172139\"/>\n          <stop offset=\"1\" stop-color=\"#101426\"/>\n        </radialGradient>\n        <filter id=\"blur18\" x=\"-100%\" y=\"-100%\" width=\"300%\" height=\"300%\">\n          <feGaussianBlur stdDeviation=\"18\"/>\n        </filter>\n        <filter id=\"glow\" x=\"-100%\" y=\"-100%\" width=\"300%\" height=\"300%\">\n          <feGaussianBlur stdDeviation=\"5\" result=\"b\"/>\n          <feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n        </filter>\n      </defs>\n\n      <g id=\"artwork\">\n        <rect width=\"1000\" height=\"700\" rx=\"32\" fill=\"url(#sky)\"/>\n        <ellipse cx=\"500\" cy=\"382\" rx=